{
"G_race_seat_RL": {
    "information":{
        "authors":"Gamer!",
        "name":"Rear Left Race Seat",
        "value":1100,
    },
    "slotType" : "G_race_seat_RL",
    "slots": [
        ["type", "default", "description"],
        //["G_skin_race_seat_RL","G_skin_race_seat_RL_gray", "Seat Color", {"coreSlot":true}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["racing_seat_FL" ["race_seat_RL"],[],{"pos":{"x":0.0,"y":0.0,"z":0.0}, "scale":{"x":0.95, "y":0.95, "z":0.95}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":6},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //seats flexbody
         {"group":"race_seat_RL"},
         {"nodeWeight":1.5},
         ["sr1l", -0.24, -0.27, 0.23],
         ["sr1ll", 0.24, -0.27, 0.23],
         ["sr2l", -0.17, 0.13, 0.15],
         ["sr2ll", 0.17, 0.13, 0.15],
         ["sr3l", -0.16, 0.33, 0.87],
         ["sr3ll", 0.16, 0.33, 0.87],
         {"group":""},
    ],
    "beams":[
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //main shape
        {"beamSpring":2501000,"beamDamp":300},
        {"beamDeform":10000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        ["sr1l", "sr1ll"],
        ["sr2l", "sr2ll"],
        ["sr3l", "sr3ll"],
        ["sr1l", "sr2l"],
        ["sr2l", "sr3l"],
        ["sr1ll", "sr2ll"],
        ["sr2ll", "sr3ll"],
        //crossing
        {"beamDeform":7000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":""},
        ["sr1ll", "sr2l"],
        ["sr2ll", "sr1l"],
        ["sr2l", "sr3ll"],
        ["sr3l", "sr2ll"],
        //corners
        {"beamDeform":9000},
        ["sr3l", "sr1l", {"deformLimitExpansion":1.1}],
        ["sr3ll", "sr1ll", {"deformLimitExpansion":1.1}],

        {"beamPrecompression":1},

        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"deformLimitExpansion":""},
    ],
    "triangles":[
        ["id1:", "id2:", "id3:"],
        {"groundModel":"metal"},
        {"dragCoef":0},
        //front seat
        ["sr2l",  "sr1l",  "sr1ll"],
        ["sr1ll", "sr2ll", "sr2l"],
        ["sr3l",  "sr2l",  "sr2ll"],
        ["sr2ll", "sr3ll", "sr3l"],
        ["sr3l", "sr1l", "sr2l"],
        ["sr3ll", "sr2ll", "sr1ll"],
    ],
},
