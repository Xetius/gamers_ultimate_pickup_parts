    "controller": [
        ["fileName"],
        ["lightbar", {
            "name": "bodyLights",
            "defaultModeIndex": 1,
            "modes": [
                ["name", "config"],
                ["Chase", [
                    ["electric", "value", "duration"],

                        //Sides
                        ["FFR", 1, 0.1],
                        ["FFR", 0, 0.1],
                        ["FFR", 1, 0.1],
                        ["FFR", 0, 0.5],

                        ["FR", 0, 0.5],
                        ["FR", 1, 0.1],
                        ["FR", 0, 0.1],
                        ["FR", 1, 0.1],

                        ["RR", 1, 0.1],
                        ["RR", 0, 0.1],
                        ["RR", 1, 0.1],
                        ["RR", 0, 0.5],

                        ["RRR", 0, 0.5],
                        ["RRR", 1, 0.1],
                        ["RRR", 0, 0.1],
                        ["RRR", 1, 0.1],

                        ["FL", 1, 0.1],
                        ["FL", 0, 0.1],
                        ["FL", 1, 0.1],
                        ["FL", 0, 0.5],

                        ["FFL", 0, 0.5],
                        ["FFL", 1, 0.1],
                        ["FFL", 0, 0.1],
                        ["FFL", 1, 0.1],

                        ["RRL", 1, 0.1],
                        ["RRL", 0, 0.1],
                        ["RRL", 1, 0.1],
                        ["RRL", 0, 0.5],

                        ["RL", 0, 0.5],
                        ["RL", 1, 0.1],
                        ["RL", 0, 0.1],
                        ["RL", 1, 0.1],
                    ],
                ],
            ],
        }],
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["FFR_filament","(electrics.FFR * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["FFL_filament","(electrics.FFL * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["FR_filament", "(electrics.FR  * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["FL_filament", "(electrics.FL  * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["RR_filament", "(electrics.RR  * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["RL_filament", "(electrics.RL  * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["RRR_filament","(electrics.RRR * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["RRL_filament","(electrics.RRL * 0.75 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["rollback_taillight_R", "(electrics.FR * 0.50 + electrics.brakelight_signal_R * 0.25 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
                ["rollback_taillight_L", "(electrics.FL * 0.50 + electrics.brakelight_signal_L * 0.25 + electrics.lowhighbeam * 0.25) * electrics.electricalLoadCoef",0],
            ],
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["FFR_filament","temporalNonLinear", [10,10]],
                ["FFL_filament","temporalNonLinear", [10,10]],
                ["FR_filament", "temporalNonLinear", [10,10]],
                ["FL_filament", "temporalNonLinear", [10,10]],
                ["RR_filament", "temporalNonLinear", [10,10]],
                ["RL_filament", "temporalNonLinear", [10,10]],
                ["RRR_filament","temporalNonLinear", [10,10]],
                ["RRL_filament","temporalNonLinear", [10,10]],
                ["rollback_taillight_R", "temporalNonLinear", [10,10]],
                ["rollback_taillight_L", "temporalNonLinear", [10,10]],
            ],
        },
    },
