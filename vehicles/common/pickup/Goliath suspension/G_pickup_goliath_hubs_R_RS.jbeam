    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_hub_5l", ["wheel_RR","wheelhub_RR"], [], {"pos":{"x":-1.01,"y":1.487, "z":0.4101}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":0}}],
        ["brake_hub_5l", ["wheel_RL","wheelhub_RL"], [], {"pos":{"x":1.01,"y":1.487, "z":0.4101}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":180}}],
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //rear left axle
        ["shaft", "wheelaxleRL", "halfshaftRL", 1, {"connectedWheel":"RL", "breakTriggerBeam":"axle_RL", "electricsName":"axle_RL", "uiName":"Rear Left Axle", "friction":1.65, "dynamicFriction":0.0032}],
        //rear right axle
        ["shaft", "wheelaxleRR", "halfshaftRR", 1, {"connectedWheel":"RR", "breakTriggerBeam":"axle_RR", "electricsName":"axle_RR", "uiName":"Rear Right Axle", "friction":1.65, "dynamicFriction":0.0032}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":6.58},
         {"group":"wheelhub_RR"},
         ["rw1r", -0.96, 1.487, 0.4101],
         ["rw1rr", -1.10, 1.487, 0.4101],
         {"group":"wheelhub_RL"},
         ["rw1l", 0.96, 1.487, 0.4101],
         ["rw1ll", 1.10, 1.487, 0.4101],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":""},

          //wheel to axle
          {"deformLimitExpansion":1.2},
          {"optional":true},
          {"beamSpring":6580940,"beamDamp":141},
          {"beamDeform":77000,"beamStrength":222000},
          {"breakGroup":"wheel_RR"},
          ["rw1rr","rh1r"],
          ["rw1rr","rh2r"],
          ["rw1rr","rh4r"],
          ["rw1r","ax1", {"name":"axle_RR"}],
          ["rw1r","rh1r"],
          ["rw1r","rh2r"],
          ["rw1r","rh3r"],
          ["rw1r","rh4r"],
          {"breakGroup":"wheel_RL"},
          ["rw1ll","rh1l"],
          ["rw1ll","rh2l"],
          ["rw1ll","rh4l"],
          ["rw1l","ax3"],
          ["rw1l","ax2"],
          ["rw1l","ax1", {"name":"axle_RL"}],
          ["rw1l","rh1l"],
          ["rw1l","rh2l"],
          ["rw1l","rh3l"],
          ["rw1l","rh4l"],
          {"optional":false},
          {"breakGroup":""},

          {"deformLimitExpansion":1.2},
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"disableMeshBreaking":false,"disableHubMeshBreaking":false,"enableHubcaps":false,"hasTire":false},
        //hub
        //general settings
        {"hubRadius":0.075},
        {"wheelOffset":-0.01},
        {"hubWidth":0.05},
        {"numRays":5},

        //hub options
        {"hubTreadBeamSpring":564940, "hubTreadBeamDamp":5.64},
        {"hubPeripheryBeamSpring":564940, "hubPeripheryBeamDamp":5.64},
        {"hubSideBeamSpring":1128940, "hubSideBeamDamp":5.64},
        {"hubNodeWeight":0.7},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":45500, "hubBeamStrength":87500},
    ],
