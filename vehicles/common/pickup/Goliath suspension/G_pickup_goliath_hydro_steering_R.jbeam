{
"G_pickup_goliath_hydro_steering_R": {
    "information":{
        "authors":"Gamer!",
        "name":"Hydraulic Rear Steering",
        "value":1900,
    },
    "slotType" : "G_pickup_goliath_steering_R",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_pickup_goliath_hydro_steering_ram_R", ["pickup_steeringrack_hydro_R"]],
        ["G_pickup_goliath_hydro_steering_frame_R", ["pickup_axle_R"]],
        ["G_pickup_goliath_hydro_steering_tierod_RR", ["pickup_tierod_RR","pickup_tierod_R"]],
        ["G_pickup_goliath_hydro_steering_tierod_RL", ["pickup_tierod_RL","pickup_tierod_R"]],
    ],
    //steering rack rail
    "rails": {
        "steeringrack_main_R":{"links:":["rst1r", "rst1l"], "broken:":[], "looped":false, "capped":true},
        "steeringrack_extra_R":{"links:":["rst3r", "rst3l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["rst2r", "steeringrack_main_R", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["rst2l", "steeringrack_main_R", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["rst4r", "steeringrack_extra_R", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
        ["rst4l", "steeringrack_extra_R", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_RR", "range", "", "Wheel Alignment", 0.999, 1.1, 0.9, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$steer_center_R", "range", "", "Wheel Alignment", 0.003, -0.01, 0.01, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Rear"}]
        ["$steer_angle_R", "range", "", "Suspension", 0.075, -0.15, 0.15, "Maximum Steering Angle", "percentage of rear steer compared to front steer", {"subCategory":"Rear", "minDis":-100, "maxDis":100}]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":7.0},
        //steering rack ends
        {"group":["pickup_steeringrack_hydro_body_R"]},
        ["rst2r", -0.22, 1.67, 0.347, {"selfCollision":true}],
        ["rst4r", -0.22, 1.67, 0.29, {"nodeWeight":0.5,"collision":false}],
        ["rst2l",  0.22, 1.67, 0.347, {"selfCollision":true}],
        ["rst4l",  0.22, 1.67, 0.29, {"nodeWeight":0.5,"collision":false}],
        //axle mounting points for steering rack
        {"nodeWeight":7.0},
        {"group":["pickup_steeringrack_hydro_R","pickup_tierod_RR"]},
        ["rst1r", -0.41, 1.67, 0.347, {"selfCollision":true}],
        ["rst3r", -0.41, 1.67, 0.29, {"nodeWeight":0.5,"collision":false}],
        {"group":["pickup_steeringrack_hydro_R","pickup_tierod_RL"]},
        ["rst1l",  0.41, 1.67, 0.347, {"selfCollision":true}],
        ["rst3l",  0.41, 1.67, 0.29, {"nodeWeight":0.5,"collision":false}],
         //tie rod
         {"nodeWeight":15.5},
         //["rh1r",-0.95, 1.64, 0.327, {"group":["pickup_hub_F","pickup_tierod_F"]}],
         //["rh1l", 0.95, 1.64, 0.327, {"group":["pickup_hub_F","pickup_tierod_F"]}],
        {"group":""},
    ],
    "beams": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":6001000,"beamDamp":100},
        {"beamDeform":1010000,"beamStrength":"FLT_MAX"},
        //steering rack mounting to axle
        {"deformLimitExpansion":1.2},
        ["rst2r", "ax1"],
        ["rst2l", "ax1"],
        ["rst2r", "ax2"],
        ["rst2l", "ax2"],
        ["rst2r", "ax3"],
        ["rst2l", "ax3"],

        {"beamSpring":10001000,"beamDamp":100},
        ["rst2r", "ax1r"],
        ["rst2r", "ax2r"],
        ["rst2l", "ax1l"],
        ["rst2l", "ax2l"],

        {"beamSpring":501000,"beamDamp":100},
        //rack extra flexbody helpers
        ["rst4r", "ax1"],
        ["rst4l", "ax1"],
        ["rst4r", "ax2"],
        ["rst4l", "ax2"],
        ["rst4r", "ax3"],
        ["rst4l", "ax3"],
        ["rst4r", "ax1r"],
        ["rst4r", "ax2r"],
        ["rst4l", "ax1l"],
        ["rst4l", "ax2l"],

        ["rst1r", "rst3r"],
        ["rst1l", "rst3l"],
        ["rst1r", "rst3l"],
        ["rst1l", "rst3r"],
        ["rst1r", "rst1l"],
        ["rst3l", "rst3r"],

        ["rst2r", "rst4r"],
        ["rst2l", "rst4l"],
        ["rst2r", "rst4l"],
        ["rst2l", "rst4r"],
        ["rst4l", "rst4r"],
        {"deformLimitExpansion":""},

        //center link
        {"beamDeform":2500000,"beamStrength":2450000},
        {"beamSpring":10001000,"beamDamp":150},
        ["rst2r","rst2l"],

        //tie rod ends
        {"beamSpring":20001000,"beamDamp":150},
        //["fh3r","rst2r", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        //["fh3l","rst2l", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        ["rh1r","rst1r", {"beamPrecompression":"$=$toe_RR+$steer_center_R","beamPrecompressionTime":0.5}],
        ["rh1l","rst1l", {"beamPrecompression":"$=$toe_RR-$steer_center_R","beamPrecompressionTime":0.5}],

        //steering damper
        {"beamSpring":0,"beamDeform":788000,"beamStrength":195000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamDamp":450},
        ["fx5r","fx3l", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx5l","fx3r", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx6r","fx3l", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx6l","fx3r", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"| BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":20001000,"beamDamp":250,"beamDeform":"FLT_MAX","beamStrength":276500},
        ["rst2l","rst1r", {"factor":"$=$steer_angle_R", "steeringWheelLock":600, "inRate":1.0,"outRate":1.0}],
        ["rst2r","rst1l", {"factor":"$=-$steer_angle_R","steeringWheelLock":600, "inRate":1.0,"outRate":1.0}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*4",
    },
},
}