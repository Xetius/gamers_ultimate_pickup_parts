"G_pickup_goliath_steering_4link": {
    "information":{
        "authors":"Gamer!",
        "name":"Regular Relocated Steering Linkage",
        "value":580,
    },
    "slotType" : "G_pickup_goliath_steering_4link",
    "slots": [
        ["type", "default", "description"],
        ["pickup_power_steering","", "Power Steering"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_goliath_steeringbox_4link", ["pickup_frame","pickup_lowermounts","pickup_uppermounts"],[],{"pos":{"x":0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_goliath_pitman_4link", ["pickup_pitman"],[],{"pos":{"x":0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_goliath_draglink_F_4link", ["pickup_link_SFA"],[]],
         ["G_pickup_goliath_steeringlink_F_4link", ["pickup_tierod_F"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F3", "range", "", "Wheel Alignment", 0, 0.01, -0.01, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F3", "range", "", "Wheel Alignment", -0.0, -0.075, 0.075, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"stepDis":0.25,"subCategory":"Front"}]
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"nodeWeight":9.3},
         ["st1", 0.325, -1.84, 0.63, {"group":["pickup_pitman"]}],
         ["st2", 0.325, -1.84, 0.4, {"group":["pickup_pitman"]}],
         ["st3", 0.337, -1.65, 0.38, {"group":["pickup_pitman","pickup_link_SFA"]}],
         {"group":["pickup_tierod_F","pickup_link_SFA"]}
         //tie rod
         {"nodeWeight":11.4},
         ["st4",-0.54, -1.78, 0.327],
         {"group":""},
    ],
    "rails": {
        "steeringrack":{
            "links:":["fh1r","fh1l"], "broken:":[], "looped":false, "capped":true,
        },
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["st4", "steeringrack", true, true, 0.0, 16001000, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
            ["id1:","id2:"],
            {"beamSpring":11280940,"beamDamp":141,"beamDeform":106750,"beamStrength":155750},
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
            ["st1","st2"],
            ["st2","st3"],
            ["st1","st3"],

            {"beamSpring":5640940,"beamDamp":141,"beamDeform":94500,"beamStrength":155750},
            ["st1", "f13l"],
            ["st1", "f12l"],
            ["st1", "f2l"],
            ["st1", "f3l"],
            ["st1", "fx1l"],
            ["st1", "fx1r"],

            ["st2", "f13l"],
            ["st2", "f12l"],
            ["st2", "f2l"],
            ["st2", "f3l"],
            ["st2", "fx1l"],
            ["st2", "fx1r"],

            ["st1", "f2r"],
            ["st2", "f3r"],
            ["st1", "f3r"],
            ["st2", "f2r"],

            {"beamSpring":16920940,"beamDamp":141},
            {"beamDeform":148400,"beamStrength":311500},
            //tie rod
            //toe in meters of tie rod length change, with small offset for default position
            ["fh1r","fh1l", {"breakGroup":"tierod","precompressionRange":"$=$toe_F3-0.0012","beamPrecompressionTime":0.5}],
            //drag link
            //{"beamSpring":14100940,"beamDamp":141},
            //adds toe change portion to steering center to prevent too much shift in steering
            ["st4","fh1r", {"breakGroup":"tierod","precompressionRange":"$=$trackbar_F3+$steer_center_F3+$toe_F3*0.5-0.0007-0.014","beamPrecompressionTime":0.5}],
            ["st3","st4"],
            //steering damper
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
            {"beamSpring":0,"beamDeform":79800,"beamStrength":104664},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            {"beamDamp":150},
            ["fh1r","fax4", {"beamDampVelocitySplit":0.1,"beamDampFast":800,"dampCutoffHz":1000}],
            ["fh1l","fax4", {"beamDampVelocitySplit":0.1,"beamDampFast":800,"dampCutoffHz":1000}],
            ["fh4r","fax2", {"beamDampVelocitySplit":0.1,"beamDampFast":800,"dampCutoffHz":1000}],
            ["fh4l","fax2", {"beamDampVelocitySplit":0.1,"beamDampFast":800,"dampCutoffHz":1000}],

            //drag link limiter for when tie rod breaks
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":0.6, "beamShortBound":0.6},
            {"beamSpring":0,"beamDamp":47,"beamDeform":20500,"beamStrength":105000},
            {"beamLimitSpring":1501000,"beamLimitDamp":50},
            //["st4", "f13r"],
            //["st4", "f12r"],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"triangleType":"NONCOLLIDABLE"},
            //steering anti clip
            ["st4", "fax2", "st3"],
            ["st1", "st2", "st3"],
            {"triangleType":"NORMALTYPE"},
    ],
    "torsionHydros": [
        ["id1:","id2:","id3:","id4:"],
        {"spring":300000, "damp":40, "deform":"FLT_MAX", "strength":"FLT_MAX"},
        ["st3","st1","st2","f13r", {"factor":0.62,"steeringWheelLock":650,"inRate":5,"outRate":5,"inputSource":"steering_input"}],
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*1.8",
    },
},
