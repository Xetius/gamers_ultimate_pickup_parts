        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_F3", "range", "+m", "Suspension", 0.1, -0.1, 0.35, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Front"}],
