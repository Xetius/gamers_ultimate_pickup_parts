{
"G_pickup_goliath_brake_F": {
    "information":{
        "authors":"Gamer!",
        "name":"Goliath Offroad Front Disc Brakes",
        "value":600,
    },
    "slotType" : "G_pickup_goliath_brake_F",
    "slots": [
        ["type", "default", "description"],
        ["brakepad_F","brakepad_F_sport", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //brake discs
        ["brake_disc_slotted", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":-1.03,"y":-1.463, "z":0.46}, "scale":{"x":1.3,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_FR"]]}],
        ["brake_disc_slotted", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":1.03,"y":-1.463, "z":0.46}, "scale":{"x":1.3,"y":1.0,"z":1.0}, "rot":{"x":180,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_FL"]]}],
        ["brake_caliper_4pot_yellow_rotopad", ["pickup_hub_F","wheelhub_FR"], [], {"pos":{"x":-1.03,"y":-1.463, "z":0.46}, "scale":{"x":1.3,"y":1.0,"z":1.07}, "rot":{"x":-160,"y":0,"z":0}}],
        ["brake_caliper_4pot_yellow_rotopad", ["pickup_hub_F","wheelhub_FL"], [], {"pos":{"x":1.03,"y":-1.463, "z":0.46}, "scale":{"x":1.3,"y":1.0,"z":1.07}, "rot":{"x":160,"y":180,"z":0}}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*3900"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":155},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.350},
        {"brakeMass":12.5},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1},

        //hub
        //general settings
        {"hubRadius":0.165},
        {"wheelOffset":0.0},
        {"hubWidth":0.05},
        {"numRays":5},

        //hub options
        {"hubTreadBeamSpring":1128940, "hubTreadBeamDamp":5.64},
        {"hubPeripheryBeamSpring":1128940, "hubPeripheryBeamDamp":5.64},
        {"hubSideBeamSpring":2256940, "hubSideBeamDamp":5.64},
        {"hubNodeWeight":0.7},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":45500, "hubBeamStrength":87500},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.2}
    ],
},
