{
"G_pickup_hub_F_6_spacer": {
    "information":{
        "authors":"Gamer!",
        "name":"6-Lug Spacer Front Hubs",
        "value":350,
    },
    "slotType" : "pickup_hub_F",
    "slots": [
        ["type", "default", "description"],
        ["pickup_brake_F","pickup_brake_F","Front Brakes"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_F" variable.
        //To change the base track width, edit the trackoffset_F offset in the expression.
        ["wheel_F_6","steelwheel_02a_16x7_F","Front Wheels", {"nodeOffset":{"x":"$=$trackoffset_F+0.4", "y":-1.463, "z":0.46}}],
        ["pickup_wheeldata_F","pickup_wheeldata_F", "Front Spindles", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_hub_6l", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":-0.77,"y":-1.463, "z":0.46}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":0}}],
        ["brake_hub_6l", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":0.77,"y":-1.463, "z":0.46}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":180}}],
        ["spacer_heavy", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":-0.835, "y":-1.463, "z":0.46}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
        ["spacer_heavy", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":0.835, "y":-1.463, "z":0.46}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //front left axle
        ["shaft", "wheelaxleFL", "halfshaftFL", 1, {"connectedWheel":"FL", "breakTriggerBeam":"axle_FL", "electricsName":"axle_FL", "uiName":"Front Left Axle", "friction":1.75, "dynamicFriction":0.0035}],
        //front right axle
        ["shaft", "wheelaxleFR", "halfshaftFR", 1, {"connectedWheel":"FR", "breakTriggerBeam":"axle_FR", "electricsName":"axle_FR", "uiName":"Front Right Axle", "friction":1.75, "dynamicFriction":0.0035}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":6.58},
         {"group":"wheelhub_FR"},
         ["fw1r", -0.71, -1.463, 0.46],
         ["fw1rr", -0.85, -1.463, 0.46],
         {"group":"wheelhub_FL"},
         ["fw1l", 0.71, -1.463, 0.46],
         ["fw1ll", 0.85, -1.463, 0.46],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":""},

          //front hub to wheel
          {"beamSpring":7460940,"beamDamp":94},
          {"beamDeform":85000,"beamStrength":276500},
          {"breakGroup":"wheel_FR"},
          {"optional":true},
          ["fh4r","fw1rr", {"name":"axle_FR","beamSpring":6110940,"beamDamp":47}],
          ["fh4r","fw1r", {"beamSpring":5110940,"beamDamp":47}],
          ["fh5r","fw1r", {"beamSpring":12160940,"beamDamp":37.6}],
          ["fw1r","fh2r"],
          ["fw1r","fh3r"],
          ["fw1rr","fh2r"],
          ["fw1rr","fh3r"],
          ["fw1rr","fh5r", {"beamSpring":12160940,"beamDamp":37.6}],
          ["fh1r","fw1r"],
          ["fh1r","fw1rr"],

          {"breakGroup":"wheel_FL"},
          ["fh4l","fw1ll", {"name":"axle_FL","beamSpring":6110940,"beamDamp":47}],
          ["fh4l","fw1l", {"beamSpring":5110940,"beamDamp":47}],
          ["fh5l","fw1l", {"beamSpring":12160940,"beamDamp":37.6}],
          ["fw1l","fh2l"],
          ["fw1l","fh3l"],
          ["fw1ll","fh2l"],
          ["fw1ll","fh3l"],
          ["fw1ll","fh5l", {"beamSpring":12160940,"beamDamp":37.6}],
          ["fh1l","fw1l"],
          ["fh1l","fw1ll"],
          {"optional":false},
          {"breakGroup":""},
          {"deformLimitExpansion":1.2},
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"disableMeshBreaking":false,"disableHubMeshBreaking":false,"enableHubcaps":false,"hasTire":false},
        //hub
        //general settings
        {"hubRadius":0.075},
        {"wheelOffset":-0.01},
        {"hubWidth":0.05},
        {"numRays":5},

        //hub options
        {"hubTreadBeamSpring":564940, "hubTreadBeamDamp":5.64},
        {"hubPeripheryBeamSpring":564940, "hubPeripheryBeamDamp":5.64},
        {"hubSideBeamSpring":1128940, "hubSideBeamDamp":5.64},
        {"hubNodeWeight":0.7},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":45500, "hubBeamStrength":87500},
    ],
},
