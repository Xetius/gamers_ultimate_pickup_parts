        ["hub_locking", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x": 0.59, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0},   "scale":{"x":1.0, "y":0.92, "z":0.92}}],
