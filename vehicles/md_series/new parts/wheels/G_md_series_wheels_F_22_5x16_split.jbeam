{
"G_wheel_F_5_old_22.5x16": {
    "information":{
        "authors":"Gamer!",
        "name":"22.5x16 Super Single Steel Front Wheels",
        "value":550,
    },
    "slotType" : "wheel_F_5_old",
    "slots2": [
        ["name",                       "allowTypes",                   "denyTypes", "default",                          "description"],
        ["G_md_series_tire_F_22.5x16", ["G_md_series_tire_F_22.5x16"], [],          "G_md_series_tire_F_17R22.5_bias", "Front Tires"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$trackoffset_F", "range", "+m", "Wheels", 0.0,-0.005, 0.015, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.005,"subCategory":"Front"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //wheels
         ["G_semi_wheel_split_barrel_22.5x16", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":"$=-1.0654-$trackoffset_F", "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
         ["G_semi_wheel_split_barrel_22.5x16", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":"$= 1.0654+$trackoffset_F", "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":20},
         {"group":"wheelhub_FR"},
         //sw1 as in steer wheel 1
         ["sw1r", -0.85,   0.00,   0.00],
         ["sw1rr",-1.28,   0.00,   0.00],
         {"group":"wheelhub_FL"},
         ["sw1l",  0.85,   0.00,   0.00],
         ["sw1ll", 1.28,   0.00,   0.00],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT WHEELS--
          {"beamSpring":6501000,"beamDamp":100},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":200000,"beamStrength":"FLT_MAX"},
          ["sw1r", "sw1rr"],
          ["sw1l", "sw1ll"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            {"enableTireLbeams":true,"disableMeshBreaking":false,"disableHubMeshBreaking":false},

            //general settings
            {"hubRadius":0.30},
            {"wheelOffset":"$=0.00-$trackoffset_F"},
            {"hubWidth":0.395},
            {"numRays":20},
            {"brakeSpring":150},//define higher value than hubs

            //hub options
            {"hubTreadBeamSpring":3501000, "hubTreadBeamDamp":100},
            {"hubPeripheryBeamSpring":3501000, "hubPeripheryBeamDamp":100},
            {"hubSideBeamSpring":4001000, "hubSideBeamDamp":100},
            {"hubBeamDeform":110000, "hubBeamStrength":420000},
            {"hubNodeWeight":1.4},
            {"hubNodeMaterial":"|NM_METAL","hasTire":false},
            {"hubFrictionCoef":0.5},
    ],
},
}