{
"G_steelwheel_12a_22x16_alt_R": {
    "information":{
        "authors":"Gamer!",
        "name":"22.5x16 Super Single Steel Rear Wheels (Colourable)",
        "value":700,
    },
    "slotType" : "md_series_wheel_R_10",
    "slots2": [
        ["name",                       "allowTypes",                   "denyTypes", "default",                          "description"],
        ["G_md_series_tire_R_22.5x16", ["G_md_series_tire_R_22.5x16"], [],          "G_md_series_tire_R_385/50R22_5", "Rear Tires"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.005, 0.08, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.005,"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //wheels
         ["G_steelwheel_12a_22x16_R", ["wheel_R1RR","wheelhub_R1RR"], [], {"pos":{"x":"$=-1.0054-$trackoffset_R", "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
         ["G_steelwheel_12a_22x16_R", ["wheel_R1LL","wheelhub_R1LL"], [], {"pos":{"x":"$= 1.0054+$trackoffset_R", "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"group":"wheelhub_R1RR"},
         {"nodeWeight":30},
         //rear hub 1
         ["dw1r", -0.53,   0.00,   0.00,   {"staticCollision":false}],
         ["dw1rr",-1.10,   0.00,   0.00],
         {"group":"wheelhub_R1LL"},
         ["dw1l",  0.53,   0.00,   0.00,   {"staticCollision":false}],
         ["dw1ll", 1.10,   0.00,   0.00],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT WHEELS--
          {"beamSpring":6501000,"beamDamp":100},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":200000,"beamStrength":"FLT_MAX"},
          ["dw1r", "dw1rr"],
          ["dw1l", "dw1ll"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            {"enableTireLbeams":true,"disableMeshBreaking":false,"disableHubMeshBreaking":false},

            //general settings
            {"hubRadius":0.30},
            {"wheelOffset":"$=-0.19-$trackoffset_R"},
            {"hubWidth":0.395},
            {"numRays":20},
            {"brakeSpring":150},//define higher value than hubs

            //hub options
            {"hubTreadBeamSpring":2501000, "hubTreadBeamDamp":80},
            {"hubPeripheryBeamSpring":2501000, "hubPeripheryBeamDamp":80},
            {"hubSideBeamSpring":4251000, "hubSideBeamDamp":80},
            {"hubBeamDeform":110000, "hubBeamStrength":420000},
            {"hubNodeWeight":1.20},
            {"hubNodeMaterial":"|NM_METAL","hasTire":false},
            {"hubFrictionCoef":0.5},
    ],
},
