         ["semi_wheel_split_F_barrel_20", ["wheel_LaL","wheelhub_LaL"], [], {"pos":{"x": 1.0654, "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
