{
  "G_steelwheel_12a_19_5x6_75_La": {
    "information":{
        "authors":"Gamer!",
        "name":"19.5x6.75 Steel Lift Axle Wheels (White)",
        "value":400,
    },
    "slotType" : "G_md_series_wheel_La_8_alt",
    "slots2": [
        ["name",                  "allowTypes",              "denyTypes", "default",               "description"],
        ["G_md_series_tire_La_19_5", ["G_md_series_tire_La_19_5"], [],          "G_md_series_tire_La_19_5", "Lift Axle Tires"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //wheels
         ["steelwheel_12a_19.5x6.75_bare", ["wheel_LaR","wheelhub_LaR"], [], {"pos":{"x":-1.078, "y":0.00, "z":0.00}, "rot":{"x":12, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
         ["steelwheel_12a_19.5x6.75_bare", ["wheel_LaL","wheelhub_LaL"], [], {"pos":{"x": 1.078, "y":0.00, "z":0.00}, "rot":{"x":-12, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
         ["steelwheel_12a_19.5x6.75_8lug", ["wheel_LaR","wheelhub_LaR"], [], {"pos":{"x":-1.078, "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
         ["steelwheel_12a_19.5x6.75_8lug", ["wheel_LaL","wheelhub_LaL"], [], {"pos":{"x": 1.078, "y":0.00, "z":0.00}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":20},
         {"group":"wheelhub_LaR"},
         //Law1 as in steer wheel 1
         ["Law1r", -0.85,   0.00,   0.00],
         ["Law1rr",-1.22,   0.00,   0.00],
         {"group":"wheelhub_LaL"},
         ["Law1l",  0.85,   0.00,   0.00],
         ["Law1ll", 1.22,   0.00,   0.00],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT WHEELS--
          {"beamSpring":6501000,"beamDamp":100},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":200000,"beamStrength":"FLT_MAX"},
          ["Law1r", "Law1rr"],
          ["Law1l", "Law1ll"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            {"enableTireLbeams":true,"disableMeshBreaking":false,"disableHubMeshBreaking":false},

            //general settings
            {"hubRadius":0.262},
            {"wheelOffset":-0.045},
            {"hubWidth":0.205},
            {"numRays":20},
            {"brakeSpring":150},//define higher value than hubs

            //hub options
            {"hubTreadBeamSpring":1501000, "hubTreadBeamDamp":40},
            {"hubPeripheryBeamSpring":1501000, "hubPeripheryBeamDamp":40},
            {"hubSideBeamSpring":3001000, "hubSideBeamDamp":40},
            {"hubBeamDeform":110000, "hubBeamStrength":420000},
            {"hubNodeWeight":0.85},
            {"hubNodeMaterial":"|NM_METAL","hasTire":false},
            {"hubFrictionCoef":0.5},
    ],
},
