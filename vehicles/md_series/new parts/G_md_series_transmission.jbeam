{
"md_series_transmission_8M": {
    "information":{
        "authors":"Gamer!",
        "name":"8-Speed Overdrive 'Dual-Shift' Transmission",
        "value":2600,
    },
    "slotType" : "md_series_transmission",
    "slots2": [
        ["name",               "allowTypes",           "denyTypes", "default",            "description"],
        ["md_series_flywheel", ["md_series_flywheel"], [],          "md_series_flywheel", "Flywheel",    {"coreSlot":true}],
    ],
    "controller": [
        ["fileName"],
        ["driveModes", {"name":"splitterControl"}]
        ["4wd", {"driveModesRangeNames":["splitterControl"], "name":"splitterControl2"}]
    ],
    "splitterControl":{
        "uiName": "Splitter"
        "quickAccessTitle":"Splitter"
        "quickAccessIcon":"radial_highrangebox"
        "quickAccessLevel":"/powertrain/"
        "enabledModes":["high", "low"]
        "defaultMode": "low"
        "modes": {
            "low": {
                "name": "Direct",
                "order": 10,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"transRangebox", "mode":"low"}]
                    ["electricsValue", {"electricsName":"splitter_state", "value":1}]
                    ["simpleControlButton", {"buttonId":"splitter", "icon":"powertrain_rangebox_low", "uiName":"Splitter"}]
                    ["quickAccess", {"icon":"powertrain_rangebox_low"}]
                ],
            },
            "high": {
                "name": "Overdrive",
                "order": 20,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"transRangebox", "mode":"high"}]
                    ["electricsValue", {"electricsName":"splitter_state", "value":-1}]
                    ["simpleControlButton", {"buttonId":"splitter", "icon":"powertrain_rangebox_high", "uiName":"Splitter"}]
                    ["quickAccess", {"icon":"powertrain_rangebox_high"}]
                ],
            },
        }
    }
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["frictionClutch", "clutch", "mainEngine", 1],
        ["manualGearbox", "gearbox", "clutch", 1],
        ["rangeBox", "transRangebox", "gearbox", 1, {"uiSimpleModeControl":false, "gearRatios":[1.00,0.78], "uiName":"Rangebox"}],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-8.59, 0, 7.88, 3.95, 2.31, 1.10], //gearbox 1
        //aux box "gearRatios":[1.00,0.78], //gearbox 2
        "friction": 5.9,
        "dynamicFriction": 0.00582,
        "torqueLossCoef": 0.014,
        "gearboxNode:":["tra1"],

        //"synchronizerSettings": [
        //    ["gearIndex",   "maxSynchroRate",   "maxSynchroRPMDifference",  "synchroWearCoef",  "maxClutchRPMDifference",   "requiredClutchInput"]
        //    [-1,            false,              350,                        false,             false,                      false                ]
        //    [ 1,            false,              350,                        false,             false,                      false                ]
        //    [ 2,            false,              350,                        false,             false,                      false                ]
        //    [ 3,            false,              350,                        false,             false,                      false                ]
        //    [ 4,            false,              350,                        false,             false,                      false                ]
        //    [ 5,            false,              350,                        false,             false,                      false                ]
        //]

        "gearWhineCoefsInput":  [0.45, 0.00, 0.20, 0.19, 0.18, 0.17, 0.16, 0.15, 0.14, 0.13, 0.12, 0.11, 0.10, 0.09],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.09, 0.10, 0.11, 0.12, 0.13, 0.14, 0.15, 0.16, 0.17, 0.18, 0.19, 0.20],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>semi_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>semi_01>twine_out",

        "forwardInputPitchCoef":1.2
        "forwardOutputPitchCoef":1.2
        //"reverseInputPitchCoef":0.9
        //"reverseOutputPitchCoef":0.9

        "gearWhineInputPitchCoefSmoothing":75
        "gearWhineOutputPitchCoefSmoothing":75
        "gearWhineInputVolumeCoefSmoothing":20
        "gearWhineOutputVolumeCoefSmoothing":20

        //"gearWhineFixedCoefOutput": 0.7
        //"gearWhineFixedCoefInput": 0.4
    },
    "clutch": {
        //"clutchStiffness":0.5,
        "clutchFreePlay":0.2,
        "lockSpringCoef":0.8,
        "lockDampRatio":0.05,
    },
    "vehicleController": {
        "clutchInRate":10,
        "clutchOutRate":10,
        "transmissionGearChangeDelay":0.25,
        "transmissionShiftDelay":0.3,
        //"shiftDownRPMOffsetCoef":0.6,
