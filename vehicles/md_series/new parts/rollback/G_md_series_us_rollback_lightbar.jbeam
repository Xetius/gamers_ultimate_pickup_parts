{
"G_md_series_us_rollback_lightbar_a": {
    "information":{
        "authors":"Gamer!",
        "name":"Light Bar Mount",
        "value":100,
    },
    "slotType" : "van_rollback_lightbar",
    "slots": [
        ["type", "default", "description"],
        ["us_lightbar_R","us_lightbar_halogen_R", "Light Bar", {"nodeMove2":{"x":0,"y":0.67,"z":2.213}, "variables":{"$scale":1.3}}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["light_bar_mount_lo", ["md_series_rollback_headboard"], [], {"pos":{"x": 0.0, "y":0.70, "z":2.275}, "rot":{"x":180, "y":0, "z":0}, "scale":{"x":1.10, "y":1.30, "z":1.30}}],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":401000,"beamDamp": 80},
          {"beamDeform":14000,"beamStrength":13000},
          {"breakGroup":"lightbar_b_break"},
          {"deformGroup":["lightbar_b_R","lightbar_b_L","lightbar_b_M","lightbar_b_break"]},

          ["Rlightbar_1l", "ch5l",{"beamDeform":500}],
          ["Rlightbar_2l", "ch6l",{"beamDeform":500}],
          //["Rlightbar_4l", "ch5l"],
          //["Rlightbar_3l", "ch6l"],
          //["Rlightbar_4l", "ch5ll"],
          //["Rlightbar_3l", "ch6ll"],
          ["Rlightbar_4l", "ch6l"],
          ["Rlightbar_3l", "ch5l"],
          ["Rlightbar_4l", "ch6ll"],
          ["Rlightbar_3l", "ch5ll"],
          ["Rlightbar_4l", "ch4l"],
          ["Rlightbar_3l", "ch4l"],
          //["Rlightbar_4", "ch4l"],
          //["Rlightbar_3", "ch4l"],

          ["Rlightbar_1r", "ch5r",{"beamDeform":500}],
          ["Rlightbar_2r", "ch6r",{"beamDeform":500}],
          ["Rlightbar_4r", "ch5r"],
          ["Rlightbar_3r", "ch6r"],
          ["Rlightbar_4r", "ch5rr"],
          ["Rlightbar_3r", "ch6rr"],
          ["Rlightbar_4r", "ch6r"],
          ["Rlightbar_3r", "ch5r"],
          ["Rlightbar_4r", "ch6rr"],
          ["Rlightbar_3r", "ch5rr"],
          ["Rlightbar_4r", "ch4r"],
          ["Rlightbar_3r", "ch4r"],
          //["Rlightbar_4", "ch4r"],
          //["Rlightbar_3", "ch4r"],

          //front additional support
          ["Rlightbar_1l", "ch6ll"],
          ["Rlightbar_1l", "ch5ll"],
          ["Rlightbar_2l", "ch6ll"],
          ["Rlightbar_2l", "ch5ll"],
          ["Rlightbar_1r", "ch6rr"],
          ["Rlightbar_1r", "ch5rr"],
          ["Rlightbar_2r", "ch6rr"],
          ["Rlightbar_2r", "ch5rr"],

          ["Rlightbar_1", "ch4l"],
          ["Rlightbar_2", "ch4l"],
          ["Rlightbar_1", "ch4r"],
          ["Rlightbar_2", "ch4r"],

          ["Rlightbar_1l", "ch4l"],
          ["Rlightbar_2l", "ch4l"],
          ["Rlightbar_1r", "ch4r"],
          ["Rlightbar_2r", "ch4r"],
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"breakGroup":""},
