"G_md_series_turbo_400": {
    "information":{
        "authors":"Gamer!",
        "name":"T400 Turbocharger",
        "value":2500,
    },
    "slotType" : "md_series_turbo",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["md_series_engine_intake_b", ["md_series_engine"]],
         ["md_series_engine_turbo", ["md_series_engine","md_series_engine_turbo"]],
         ["md_series_intercooler", ["md_series_radiator"]],
         {"deformGroup":"radhose", "deformMaterialBase":"md_series", "deformMaterialDamaged":"invis"},
         ["md_series_intercooler_pipe_a", ["md_series_engine","md_series_radiator"]],
         ["md_series_intercooler_pipe_b", ["md_series_engine","md_series_radiator"]],
         {"deformGroup":""},
    ],
    "soundConfig": {
        "$+mainGain": 0.0,
        "$+intakeMuffling":-0.13,
        "$+maxLoadMix": 0.3,
        "$+minLoadMix": 0.15,
        "$+highShelfGain": 0,
