"G_md_series_engine_internals_extreme": {
    "information":{
        "authors":"Gamer!",
        "name":"Race Extreme Long Block",
        "value":28000,
    },
    "slotType" : "md_series_engine_internals",

    "mainEngine":{
        "torqueModMult":[
            ["rpm", "torque"],
            [0,    0.80],
            [200,  0.86],
            [500,  0.88],
            [750,  0.92],
            [1000, 0.95],
            [1200, 1.00],
            [1500, 1.05],
            [1800, 1.15],
            [2200, 1.30],
            [2500, 1.40],
            [3000, 1.70],
            [3500, 1.95],
            [4000, 2.00],
            [4500, 2.00],
            [4500, 2.00],
        ],
        "torque":[
            ["rpm", "torque"],
            [0,      0],
            [200,  280],
            [500,  410],
            [750,  481],
            [1000, 514],
            [1200, 525],
            [1500, 543],
            [1800, 544],
            [2200, 530],
            [2500, 516],
            [3000, 480],
            [3500, 400],
            [4000, 320],
            [4500, 250],
            [5000, 100],
        ],
        //max rpm physically capable of
        "$+maxRPM":1150,
        "$*friction":1.10,
        "$*dynamicFriction":1.30,
        "$*inertia":1.10,
        "$*engineBrakeTorque":1.14,
        //engine durability
        "idleRPMRoughness":550,
        "cylinderWallTemperatureDamageThreshold":190,
        "headGasketDamageThreshold":2100000,
        "pistonRingDamageThreshold":2100000,
        "connectingRodDamageThreshold":2550000,
        //"maxTorqueRating": 490,
        //"maxOverTorqueDamage": 450,
        "$*maxTorqueRating": 2.2,
        "$*maxOverTorqueDamage": 1.2,
        //add more particules to "simulate" a cranked up injection pump
        "particulates":0.58,
    },
