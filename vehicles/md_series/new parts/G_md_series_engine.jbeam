        "$+eqFundamentalGain": 0,
    },
    "soundConfigExhaust": {
        "$+mainGain": 0.0,
        "$+maxLoadMix": 0.15,
        "$+minLoadMix": 0.15,
        "$+highShelfGain": 0,
        "$+eqLowGain": 0,
        "$+eqFundamentalGain": 0,
    },
    "turbocharger": {
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>turbo_semi_01>turbo_hiss_tuned",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>turbo_semi_01>turbo_spin_tuned",
        "bovEnabled":false,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.03,
        "whineVolumePer10kRPM": 0.053,
        "whinePitchPer10kRPM": 0.085,
        "wastegateStart":24,
        "wastegateLimit":26,
        "maxExhaustPower": 14500,
        "backPressureCoef": 0.00008,
        "frictionCoef": 18,
        "inertia":21,
        "damageThresholdTemperature": 750,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         0],
            [30000,     5],
            [60000,     11],
            [90000,     28],
            [150000,    37],
            [200000,    45],
            [250000,    68],
            [300000,    77],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.20,   0.10],
            [250,   0.20,   0.10],
            [500,   0.60,   0.40],
            [800,   0.80,   0.90],
            [1000,  0.90,   0.90],
            [1200,  0.90,   0.90],
            [1400,  0.90,   0.90],
            [1600,  0.90,   0.85],
            [2000,  0.90,   0.85],
            [2500,  0.90,   0.85],
            [3000,  0.90,   0.85],
            [3500,  0.90,   0.85],
            [4000,  0.90,   0.85],
        ],
    },
    "mainEngine": {
        //turbocharger name
        "turbocharger":"turbocharger",
    },
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         //--ENGINE CUBE--
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"group":"md_series_engine_turbo"},
         {"nodeWeight":5.1},
         {"selfCollision":false},
         {"collision":true},
         //turbo
         ["entb1",-0.255, -1.49,   1.134],
         ["entb2",-0.255, -1.23,   1.133],
         {"engineGroup":""},
         {"selfCollision":true},
         {"collision":true},
         {"group":""},
    ],
     "beams": [
          ["id1:",  "id2:"],
          //--ENGINE CUBE--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":2100800,"beamDamp":1600},
          {"beamDeform":1500000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"mainEngine_intake", "deformationTriggerRatio":0.01},
          ["entb1", "entb2", {"isExhaust":"mainEngine"}],
          ["entb1", "en3r"],
          ["entb1", "en4r"],
          ["entb1", "en1r"],
          ["entb1", "en2r"],
          ["entb1", "en3l",  {"isExhaust":"mainEngine"}],
          ["entb1", "en4l"],
          ["entb1", "en1l"],
          ["entb1", "en2l"],

          ["entb2", "en3r"],
          ["entb2", "en4r"],
          ["entb2", "en1r"],
          ["entb2", "en2r"],
          ["entb2", "en3l"],
          ["entb2", "en4l"],
          ["entb2", "en1l"],
          ["entb2", "en2l"],
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
