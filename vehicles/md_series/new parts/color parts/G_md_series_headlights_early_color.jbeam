        "name":"Right Headlight (Black)",
        "value":270,
    },
    "slotType" : "md_series_headlight_R_early",
    "slots2": [
        ["name",                              "allowTypes",                          "denyTypes", "default", "description"],
        ["md_series_headlight_R_early_guard", ["md_series_headlight_R_early_guard"], [],          "",        "Right Headlight Guard"],
    ],
