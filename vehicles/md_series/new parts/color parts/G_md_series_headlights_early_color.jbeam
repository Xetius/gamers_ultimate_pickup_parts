        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_md_series_headlight_bezel_early_R_color", ["md_series_headlight_R"], [],{"materialOverride":[["md_series_main","us_semi_common_black"]]}],
        {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"us_semi_lights", "deformMaterialDamaged":"us_semi_lights_dmg"},
        ["md_series_headlight_housing_early_R", ["md_series_headlight_R"]],
        {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"us_semi_lights_glass", "deformMaterialDamaged":"us_semi_lights_glass_dmg"},
        ["md_series_headlight_early_glass_R", ["md_series_headlight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound4", "deformVolume":0.5}],
        {"deformGroup":""},
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightColor":{"r":255, "g":255, "b":160, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "texSize":512,
            "shadowSoftness":0.5,
        },
        ["lowhighbeam_filament" , "SPOTLIGHT", "he4r", "he3r", "he2r", {"x":-10, "y":0, "z":-175}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1,
        {"baseTranslation":{"x":0.5, "y":0.5, "z":0.07},"lightRange":50,"lightBrightness":0.3,"lightOuterAngle":95,"flareScale":0.035,"deformGroup":"headlightglass_R_break","lightScaling":{}}],
        ["highbeam_filament", "SPOTLIGHT", "he4r", "he3r", "he2r", {"x":-5, "y":0, "z":-175}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1,
        {"baseTranslation":{"x":0.5, "y":0.5, "z":0.07},"lightRange":80,"lightBrightness":0.55,"lightOuterAngle":95,"flareScale":0.05,"deformGroup":"headlightglass_R_break","lightScaling":{}}],
    ],
    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        //--HEADLIGHT--
        //right
        {"selfCollision":true},
        {"collision":true},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"frictionCoef":0.5},
        {"nodeWeight":0.85},
        {"group":"md_series_headlight_R"},
        ["he1r",-0.50,  -2.27,   1.32],
        ["he3r",-0.50,  -2.27,   1.17],
        ["he2r",-0.81,  -2.24,   1.32],
        ["he4r",-0.81,  -2.24,   1.17],
        ["he5r",-0.67,  -2.11,   1.25,   {"selfCollision":false}],
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        //--HEADLIGHT--
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":901000,"beamDamp":90},
        {"beamDeform":9000,"beamStrength":"FLT_MAX"},
        //headlight main shape
        {"deformLimitExpansion":1.2},
        {"deformGroup":"headlightglass_R_break", "deformationTriggerRatio":0.1},
        ["he1r", "he2r"],
        ["he3r", "he4r"],
        ["he1r", "he3r"],
        ["he2r", "he4r"],
        ["he1r", "he4r"],
        ["he2r", "he3r"],
        ["he1r", "he5r"],
        ["he2r", "he5r"],
        ["he3r", "he5r"],
        ["he4r", "he5r"],

        //attach
        {"deformLimitExpansion":""},
        {"disableTriangleBreaking":true},
        {"beamSpring":751000,"beamDamp":90},
        {"beamDeform":6000,"beamStrength":26000},
        {"breakGroup":"headlight_R"},

        ["he1r", "ffa2rr"],
        ["he1r", "ffa3r"],
        ["he1r", "ffa4r"],
        ["he2r", "ffa2r"],
        ["he2r", "ffa3rr"],
        ["he2r", "ffa4r"],
        ["he3r", "ffa2rr"],
        ["he3r", "ffa1r"],
        ["he3r", "ffa4r"],
        ["he4r", "ffa2r"],
        ["he4r", "ffa1rr"],
        ["he4r", "ffa4r"],

        {"breakGroup":""},
        {"deformGroup":"", "deformationTriggerRatio":""},
        {"disableTriangleBreaking":false},

        //headlight support beams
        {"beamType":"|SUPPORT", "beamLongBound":4},
        {"beamSpring":4501000,"beamDamp":75},
        {"beamDeform":7100,"beamStrength":"FLT_MAX"},

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"deformLimitExpansion":1.2},
    ],
    "triangles": [
        ["id1:", "id2:", "id3:"],
        //right headlight
        {"groundModel":"plastic"},
        {"group":"md_series_headlight_R"},
        {"dragCoef":4},
        ["he3r", "he1r", "he4r"],
        ["he4r", "he1r", "he2r"],
        ["he4r", "he2r", "he5r"],
        ["he1r", "he5r", "he2r"],
        ["he3r", "he5r", "he1r"],
        ["he4r", "he5r", "he3r"],
    ],
},
