{
"G_md_series_windshield_highroof": {
    "information":{
        "authors":"Gamer!",
        "name":"Windshield",
        "value":350,
    },
    "slotType" : "G_md_series_windshield_highroof",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
         {"deformGroup":"windshield_break", "deformMaterialBase":"pickup_glass", "deformMaterialDamaged":"pickup_windshield_dmg"},
