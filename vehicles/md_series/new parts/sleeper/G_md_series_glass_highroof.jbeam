         {"deformGroup":""},
         ["md_series_wipers", ["md_series_body"]],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    },
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":1.88},
         {"group":["md_series_windshield","gps"]},
         ["wi1",   0.0,   -0.67,   1.91],
         {"group":""},
         {"nodeMaterial":"|NM_METAL"},

         //add weight

