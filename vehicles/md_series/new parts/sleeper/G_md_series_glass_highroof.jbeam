         ["rf1r", -0.625, -0.28,   2.25,   {"group":["md_series_body","md_series_windshield","gps"]}],
         ["rf1",   0.000, -0.31,   2.28,   {"group":["md_series_body","md_series_windshield","gps"]}],
         ["rf1l",  0.625, -0.28,   2.25,   {"group":["md_series_body","md_series_windshield","gps"]}],
         {"nodeWeight":1.5},
         ["rfc1r",-0.35,  -0.295,  2.265,  {"group":["md_series_body","md_series_windshield","gps"]}],
         ["rfc1l", 0.35,  -0.295,  2.265,  {"group":["md_series_body","md_series_windshield","gps"]}],

         //a-pillar
         {"nodeWeight":2.256},
         ["p1r",  -0.63,  -0.62,   1.9,    {"group":["md_series_body","md_series_windshield","gps"]}],
         ["p1l",   0.63,  -0.62,   1.9,    {"group":["md_series_body","md_series_windshield","gps"]}],
         ["p2r",  -0.78,  -0.6,    1.9,    {"group":["md_series_body","md_series_windshield","gps"]}],
         ["p2l",   0.78,  -0.6,    1.9,    {"group":["md_series_body","md_series_windshield","gps"]}],

         //firewall
         {"nodeWeight":5.828},
         ["b6rr", -0.88,  -0.87,   1.70,   {"group":["md_series_body","md_series_windshield","gps","md_series_snorkel"]}],
         ["b6r",  -0.35,  -0.95,   1.72,   {"group":["md_series_body","md_series_windshield","gps"]}],
         ["b6l",   0.35,  -0.95,   1.72,   {"group":["md_series_body","md_series_windshield","gps"]}],
         ["b6ll",  0.88,  -0.87,   1.70,   {"group":["md_series_body","md_series_windshield","gps"]}],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":1895830,"beamDamp":244.4},
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"deformGroup":"windshield_break", "deformationTriggerRatio":0.03},
          {"beamDeform":7000,"beamStrength":"FLT_MAX"},
          //windshield
          {"deformLimitExpansion":""},
          ["wi1",  "rf1"],
          ["p1r",  "wi1"],
          ["p1l",  "wi1"],
          ["wi1",  "b6r"],
          ["wi1",  "b6l"],
          ["wi1",  "rf2"],
          ["rf1r", "wi1"],
          ["rf1l", "wi1"],

          ["wi1",  "b6rr"],
          ["wi1",  "b6ll"],

          {"beamDeform":7000,"beamStrength":14952},
          ["p1r",  "p1l"],
          ["rf1r", "b6r"],
          ["rf1l", "b6l"],

          ["rf1",  "b6r"],
          ["rf1",  "b6l"],
          {"breakGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
