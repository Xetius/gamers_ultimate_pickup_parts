"G_md_series_concealed_flashers_highroof": {
    "information":{
        "authors":"Gamer!",
        "name":"Concealed Flashers",
        "value":550
    },
    "slotType" : "G_md_series_lightbar_highroof",
    "slots2": [
        ["name",             "allowTypes",         "denyTypes", "default",               "description"],
        ["flasher_color",    ["flasher_color"],    [],          "flasher_color_bluered", "Flashers Color", {"coreSlot":true}],
        ["soundscape_siren", ["soundscape_siren"], [],          "soundscape_siren_3",    "Siren Audio"],
        ["flasher_bulb_L",["us_lightbar_led_1_4W_x4"],[],"us_lightbar_led_1_4W_x4","Left Flasher LED Unit",{"coreSlot":true,"variables":{
          "$electric":"blue_1","$nodeRef":"rf1","$nodeX":"rf1l","$nodeY":"rf2","$deformGroup":"windshield_break","$posX": 0.438,"$posY":-0.332,"$posZ":2.079,"$rotX":0,"$rotY":0,"$rotZ":180,"$shadowEnable":0,"$disable":0
        }}],
        ["flasher_bulb_R",["us_lightbar_led_2_4W_x4"],[],"us_lightbar_led_2_4W_x4","Right Flasher LED Unit",{"coreSlot":true,"variables":{
          "$electric":"red_1", "$nodeRef":"rf1","$nodeX":"rf1r","$nodeY":"rf2","$deformGroup":"windshield_break","$posX":-0.438,"$posY":-0.332,"$posZ":2.079,"$rotX":0,"$rotY":0,"$rotZ":180,"$shadowEnable":0,"$disable":0
        }}],
    ],
    "soundscape": [
        ["name", "src"],
        //affects siren location because siren soundscape part is loaded after
        {"node:":"b6r"}
    ],
    "controller": [
        ["fileName"],
        ["lightbar", {
            "name":"flashers2",
            "defaultModeIndex": 1,
            "modes": [
                ["name", "config"],
                ["Chase", [
                    ["electric", "value", "duration"],
                        ["blue_1", 1, 0.15],
                        ["blue_1", 0, 0.2],
                        ["blue_1", 1, 0.1],
                        ["blue_1", 0, 0.25],

                        ["red_1", 0, 0.1],
                        ["red_1", 1, 0.3],
                        ["red_1", 0, 0.1],
                        ["red_1", 1, 0.15],
                    ]
                ]
            ]
        }]
    ],
    "glowMap":{
            "generic_flasher_led_L": {"simpleFunction":"blue_1", "off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher1"},
            "generic_flasher_led_R": {"simpleFunction":"red_1",  "off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher2"},
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"windshield_break", "deformMaterialBase":"policeparts_lights_white", "deformMaterialDamaged":"policeparts_lights_white"},
        ["generic_flasher_led_R", ["md_series_body"], [], {"pos":{"x":-0.535, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["md_series_body"], [], {"pos":{"x":-0.470, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["md_series_body"], [], {"pos":{"x":-0.405, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["md_series_body"], [], {"pos":{"x":-0.340, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],

        ["generic_flasher_led_L", ["md_series_body"], [], {"pos":{"x": 0.535, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_L", ["md_series_body"], [], {"pos":{"x": 0.470, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_L", ["md_series_body"], [], {"pos":{"x": 0.405, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_L", ["md_series_body"], [], {"pos":{"x": 0.340, "y":-0.332, "z":2.079}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}]
