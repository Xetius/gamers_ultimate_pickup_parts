        //["tcas_driveshaft", "us_semi_slipshaft_R_0_25",     "tra1","tcas5","tcas1l",  {"x":-89.282, "y":89.758, "z":-61.303}, {"x":0, "y":-1, "z":0} , {"x":0, "y":0, "z":0}, -360, 360, 0, 1,{"baseTranslation":{"x":-0.00, "y":-0.00, "z":0.0},"breakGroup":"tcase_break","deformGroup":"tcase_break","optional":true}],
        //["tcas_driveshaft", "us_semi_driveshaft_R_0_23",    "tcas5","tra1","tcas1l",  {"x":-89.282, "y":89.758, "z":-21.303}, {"x":0, "y":1, "z":0} , {"x":0, "y":0, "z":0}, -360, 360, 0, 1,{"baseTranslation":{"x":-0.00, "y":-0.00, "z":0.0},"breakGroup":"tcase_break","deformGroup":"tcase_break","optional":true}],
        //["tcas_driveshaft", "us_semi_driveshaft_R_yoke_b",    "tcas5","tcas3l","tcas1l", {"x":0, "y":0, "z":0}, {"x":0, "y":1, "z":0} , {"x":0, "y":0, "z":0}, -360, 360, 0, 1,{"baseTranslation":{"x":0.025, "y":0.060, "z":0.05},"baseRotationGlobal":{"x":0, "y":90, "z":180},"breakGroup":"tcase_break","optional":true}],
    ],
    "nodes": [
         ["id",     "posX", "posY", "posZ"],
