{
"G_md_series_transfercase_extCab_4WD_alt": {
    "information":{
        "authors":"Gamer!",
        "name":"4WD Short Transfer Case",
        "value":0,
    },
    "slotType" : "md_series_transfercase_extCab",
    "slots2": [
        ["name",                                    "allowTypes",                                "denyTypes", "default",                                  "description"],
        ["md_series_driveshaft_R_extCab_4WD",       ["md_series_driveshaft_R_extCab_4WD"],       [],          "md_series_driveshaft_R_extCab_4WD",        "Rear Driveshaft"],
        ["G_md_series_driveshaft_F_regCab_4WD_alt", ["G_md_series_driveshaft_F_regCab_4WD_alt"], [],          "G_md_series_driveshaft_F_regCab_4WD_alt", "Front Driveshaft"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_md_series_transfercase_alt", ["md_series_transfercase"], [],{"pos":{"x":0.0, "y":-0.65, "z":0.0}}],
         ["G_md_series_transfercase_mount_alt", ["md_series_frame_mid"], [],{"pos":{"x":0.0, "y":-0.65, "z":0.0}}],
    ],
    "controller": [
        ["fileName"],
        ["driveModes", {"name":"transfercaseControl"}]
        //["4wd", {"driveModesTransfercaseNames":["transfercaseControl"], "name":"4wdControl"}]
    ],

    "transfercaseControl":{
        "uiName": "Transfercase"
        "quickAccessTitle":"Transfercase"
        "quickAccessIcon":"radial_highrangebox"
        "quickAccessLevel":"/vehicleFeatures/"
        "enabledModes":["2hi", "4hi", "4lo"]
        "defaultMode": "2hi"
        "modes": {
            "2hi": {
                "name": "2WD High Gear",
                "order": 10,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"tcasRangebox", "mode":"high"}]
                    ["powertrainDeviceMode", {"deviceName":"transfercase_F", "mode":"disconnected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFR", "mode":"disconnected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFL", "mode":"disconnected"}]
                    ["electricsValue", {"electricsName":"transfercase_state", "value":1}]
                    ["simpleControlButton", {"buttonId":"transfercase", "icon":"powertrain_transfercase_high-2", "uiName":"Transfercase"}]
                    ["quickAccess", {"icon":"powertrain_transfercase_high-2"}]
                ],
            },
            "4hi": {
                "name": "4WD High Gear",
                "order": 20,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"tcasRangebox", "mode":"high"}]
                    ["powertrainDeviceMode", {"deviceName":"transfercase_F", "mode":"connected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFR", "mode":"connected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFL", "mode":"connected"}]
                    ["electricsValue", {"electricsName":"transfercase_state", "value":0.33}]
                    ["simpleControlButton", {"buttonId":"transfercase", "icon":"powertrain_transfercase_high-4", "uiName":"Transfercase"}]
                    ["quickAccess", {"icon":"powertrain_transfercase_high-4"}]
                ],
            },
            "4lo": {
                "name": "4WD Low Gear",
                "order": 30,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"tcasRangebox", "mode":"low"}]
                    ["powertrainDeviceMode", {"deviceName":"transfercase_F", "mode":"connected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFR", "mode":"connected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFL", "mode":"connected"}]
                    ["electricsValue", {"electricsName":"transfercase_state", "value":-1}]
                    ["simpleControlButton", {"buttonId":"transfercase", "icon":"powertrain_transfercase_low-4", "uiName":"Transfercase"}]
                    ["quickAccess", {"icon":"powertrain_transfercase_low-4"}]
                ],
            },
        }
    }
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["torsionReactor", "torsionReactorGrbx", "transRangebox", 1, {}],
        ["shaft", "tcasRangeboxShaft", "torsionReactorGrbx", 1, {"breakTriggerBeam":"driveshaft_tcas", "uiName":"Transfercase Driveshaft", "electricsName":"tcas_driveshaft", "friction":0.74, "dynamicFriction": 0.00178}],
        ["rangeBox", "tcasRangebox", "tcasRangeboxShaft", 1, {"uiSimpleModeControl":false, "gearRatios":[1,2.2], "uiName":"Rangebox", "electricsName":"tcas_yoke"}],
        //locked center diff
        ["differential", "transfercase", "tcasRangebox", 1, {"diffType":"locked", "lockTorque":8000, "friction":0.44, "dynamicFriction":0.00048, "torqueLossCoef":0.012, "uiName":"Transfer Case", "defaultVirtualInertia":0.1}],
        //disconnecting front shaft
        ["shaft", "transfercase_F", "transfercase", 2, {"uiSimpleModeControl":false, "canDisconnect":true, "friction":0.44, "dynamicFriction":0.00048, "uiName":"Front Output Shaft"}],
    ],
    "torsionReactorGrbx": {
        "torqueReactionNodes:":["tra2l","tra2r","tra3l"],
    },
    "props": [
        ["func"      , "mesh"           ,             "idRef:", "idX:", "idY:",               "baseRotation"        , "rotation"            , "translation"        , "min", "max", "offset", "multiplier",],
