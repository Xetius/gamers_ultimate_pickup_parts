   "airbagCrossFlow_main": [
        ["crossFlowTag", "virtualBufferCapacity"],
        ["liftAxle_main", 0.005],
   ],
   "airbagCrossFlow_lift": [
        ["crossFlowTag", "virtualBufferCapacity"],
        ["liftAxle_lift", 0.005],
   ],
   "airbagBeamData_main": [
       ["beamName", "groupName"],
       ["airbag_LaL1", "liftAxle_main", {"debug": false, "crossFlowTag": "liftAxle_main"}],
       ["airbag_LaR1", "liftAxle_main", {"debug": false, "crossFlowTag": "liftAxle_main"}],
   ],
   "airbagBeamData_lift": [
       ["beamName", "groupName"],
       ["airbag_LaL2", "liftAxle_lift", {"debug": false, "crossFlowTag": "liftAxle_lift"}],
       ["airbag_LaR2", "liftAxle_lift", {"debug": false, "crossFlowTag": "liftAxle_lift"}],
   ],
   "airbagBeamSoundData_liftAxle_main":[
       ["groupName", "soundIncrease", "soundDecrease", "volumeIncrease", "volumeDecrease"],
       {"flowRateVolumeFactor": 300},
       ["liftAxle_main", "event:>Vehicle>Pneumatics>Suspension_Up", "event:>Vehicle>Pneumatics>Suspension_Down", 1, 1],
    ],
    "airbagBeamSoundData_liftAxle_lift":[
       ["groupName", "soundIncrease", "soundDecrease", "volumeIncrease", "volumeDecrease"],
       {"flowRateVolumeFactor": 300},
       ["liftAxle_lift", "event:>Vehicle>Pneumatics>Suspension_Up", "event:>Vehicle>Pneumatics>Suspension_Down", 1, 1],
    ],
    "beams": [
        ["id1:", "id2:"],
        //--REAR AIRBAGS--
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":150100,"beamDamp":550},
        {"beamDeform":250000,"beamStrength":"FLT_MAX"},
        //hold bag nodes when broken
        ["Lab1l","La4l"],
        ["Lab1l","Lrx1l"],
        ["Lab1r","La4r"],
        ["Lab1r","Lrx1r"],
        ["Lab1l","La4r"],
        ["Lab1r","La4l"],
        {"beamPrecompression":1, "beamType":"|PRESSURED"},
        {"beamSpring":0,"beamDamp":800,"beamDeform":100000,"beamStrength":250000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        //main airbags
        {"breakGroup":"bagmount_L_LX1"},
        {"breakGroupType":1},
        {"disableMeshBreaking":true,"disableTriangleBreaking":true},
        ["Lab2l","Lab1l", {"beamPrecompression":0.6,"pressurePSI":0,"surface":0.055,"volumeCoef":0.5, "name":"airbag_LaL1"}],
        {"breakGroup":"bagmount_R_LX1"},
        ["Lab2r","Lab1r", {"beamPrecompression":0.6,"pressurePSI":0,"surface":0.055,"volumeCoef":0.5,"name":"airbag_LaR1"}],
        {"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"breakGroupType":0},
        {"breakGroup":""},

        //lift airbags
        {"breakGroup":"bagmount_L_LX2"},
        {"breakGroupType":1},
        {"disableMeshBreaking":true,"disableTriangleBreaking":true},
        ["Lab4l","Lab3l", {"beamPrecompression":1,"pressurePSI":110,"surface":0.035,"volumeCoef":0.5, "name":"airbag_LaL2"}],
        {"breakGroup":"bagmount_R_LX2"},
        ["Lab4r","Lab3r", {"beamPrecompression":1,"pressurePSI":110,"surface":0.035,"volumeCoef":0.5, "name":"airbag_LaR2"}],
        {"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"breakGroupType":0},
        {"breakGroup":""},

        //extension limit
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamDeform":250000,"beamStrength":"FLT_MAX"},
        {"beamSpring":1000,"beamDamp":1000},
        {"beamLimitSpring":5001000,"beamLimitDamp":1000},
        ["Lab2l","Lab1l", {"shortBoundRange":0.11, "longBoundRange":0.12,"boundZone":0.03}],
        ["Lab2r","Lab1r", {"shortBoundRange":0.11, "longBoundRange":0.12,"boundZone":0.03}],
        ["Lab3l","Lab4l", {"shortBoundRange":0.05, "longBoundRange":0.04,"boundZone":0.01}],
        ["Lab3r","Lab4r", {"shortBoundRange":0.05, "longBoundRange":0.04,"boundZone":0.01}],
        {"boundZone":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
},
