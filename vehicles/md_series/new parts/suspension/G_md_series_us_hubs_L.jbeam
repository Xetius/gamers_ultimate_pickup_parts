"G_md_series_us_wheeldata_R_liftaxle": {
    "information":{
        "authors":"Gamer!",
        "name":"Lift Axle Spindles",
        "value":0,
    },
    "slotType" : "G_md_series_us_wheeldata_R_liftaxle",
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //rear
        {"selfCollision":true},
        {"collision":true},
        {"axleBeams":["axle_LaR"]},
        ["LaR", "wheel_LaR", "tire_LaR", "Law1rr", "Law1r", 9999, "La4r", 1, {"torqueCoupling:":"Lah3r", "torqueArm:":"Lah4r", "steerAxisUp:":"La5r","steerAxisDown:":"La4r","speedo":false}],
        {"axleBeams":["axle_LaL"]},
        ["LaL", "wheel_LaL", "tire_LaL", "Law1ll", "Law1l", 9999, "La4l", -1, {"torqueCoupling:":"Lah3l", "torqueArm:":"Lah4l", "steerAxisUp:":"La5l","steerAxisDown:":"La4l","speedo":false}],
        {"brakeTorque":0},
        {"parkingTorque":0},
        {"triangleCollision":true},
        {"selfCollision":true},
        {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"enableHubcaps":false},
        {"enableTireLbeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTireReinfBeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTirePeripheryReinfBeams":false},
        {"loadSensitivitySlope":""},
        {"noLoadCoef":""},
        {"fullLoadCoef":""},
        {"frictionCoef":""},
        {"slidingFrictionCoef":""},
        {"softnessCoef":0.5},
        {"treadCoef":1.0},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["shaft", "wheelaxleLaL", "differential_La", 1, {"connectedWheel":"LaL", "breakTriggerBeam":"axle_LaL", "uiName":"Lift Axle Left Axle", "friction":25.6, "dynamicFriction": 0.014}],
        ["shaft", "wheelaxleLaR", "differential_La", 2, {"connectedWheel":"LaR", "breakTriggerBeam":"axle_LaR", "uiName":"Lift Axle Right Axle", "friction":25.6, "dynamicFriction": 0.014}],
    ],
},
