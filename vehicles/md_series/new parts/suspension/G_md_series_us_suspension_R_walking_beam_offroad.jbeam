{
"G_md_series_us_R_suspension_wbeam_offroad": {
    "information":{
        "authors":"Gamer!",
        "name":"Off-Road Walking Beam Tandem Suspension",
        "value":1200,
    },
    "slotType" : ["md_series_suspension_R_single"],
    "slots2": [
        ["name",                             "allowTypes",                          "denyTypes", "default",                                "description"],
        ["G_md_series_us_wbeam_springs_alt", ["G_md_series_us_wbeam_springs_alt"],  [],          "G_md_series_us_wbeam_springs_alt_heavy", "Leaf Springs",                  {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":-0.17}}],
        ["G_md_series_us_brakeValve_R",      ["G_md_series_us_brakeValve_R"],       [],          "G_md_series_us_brakeValve_R",            "Rear Air Brake control Valve",  {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":-0.17}}],
        ["G_md_series_us_driveshaft_tandem", ["G_md_series_us_driveshaft_tandem"],  [],          "G_md_series_us_driveshaft_tandem",       "Rear Driveshaft",               {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":-0.17}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$suspension_move_R", "range", "+m", "Suspension", 0, -1.2, 0.8, "Axle Position", "Adjust the position of the rear axles according to frame and application", {"stepDis":0.05, "subCategory":"Rear"}],
    ],
    "components": {
        "driveshaft_R_tandem": {
           "enable": true
        },
        "md_series_suspensionoffest_R": {
            "md_series_suspensionoffest_R": 0.0,
        },
        "md_series_tandem_offest_Y": "$=$suspension_move_R-2.15",
        "md_series_tandem_offest_Z": -0.17,
        "md_series_mudflap_offset": 0.6,
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_md_series_us_frame_crossmember_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_torquerod_mount_b_R_1", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_torquerod_mount_b_R_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_bumpstop_tandem", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],

         ["G_md_series_us_torquerod_offroad_R_1", ["md_series_torquerod_R_1"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0.0}}],
         ["G_md_series_us_torquerod_offroad_R_2", ["md_series_torquerod_R_2"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0.0}}],
         ["G_md_series_us_hanger_tandem_offroad_1", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":-0.17}}],
         ["G_md_series_us_hanger_tandem_offroad_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":-0.17}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //--REAR RUNNING GEAR--
         {"nodeWeight":13},
         //suspension mounts
         {"selfCollision":true},
         {"collision":true},
         {"group":["md_series_torquerod_R_mount", "md_series_torquerod_R_1"]},
         ["rx3",  0.000, "$=$suspension_move_R+1.740", 0.820],
         {"group":["md_series_torquerod_R_mount", "md_series_torquerod_R_2"]},
         ["rx4",  0.000, "$=$suspension_move_R+1.956", 0.820],
         {"group":""},
         {"selfCollision":false},
         {"collision":false},
         {"nodeWeight":12},
         ["rsm1l", 0.434, "$=$suspension_move_R+1.18", 0.95],
         ["rsm1r",-0.434, "$=$suspension_move_R+1.18", 0.95],
         ["rsm2l", 0.434, "$=$suspension_move_R+2.51", 0.95],
         ["rsm2r",-0.434, "$=$suspension_move_R+2.51", 0.95],
         ["rsm11l", 0.434, "$=$suspension_move_R+1.18", 0.69],
         ["rsm11r",-0.434, "$=$suspension_move_R+1.18", 0.69],
         ["rsm12l", 0.434, "$=$suspension_move_R+2.51", 0.69],
         ["rsm12r",-0.434, "$=$suspension_move_R+2.51", 0.69],
         {"nodeWeight":5},
         //extra nodes for mudflaps to hang on
         ["rsm13l", 0.434, "$=$suspension_move_R+2.8750", 0.69],
         ["rsm13r",-0.434, "$=$suspension_move_R+2.8750", 0.69],
         ["rsm3l", 0.434, "$=$suspension_move_R+2.8750", 0.95],
         ["rsm3r",-0.434, "$=$suspension_move_R+2.8750", 0.95],
         //travel limiter node
         {"nodeWeight":5},
         ["rsm5l", 0.434, "$=$suspension_move_R+1.840", 0.95],
         ["rsm5r",-0.434, "$=$suspension_move_R+1.840", 0.95],
         {"group":""},
    ],
    "slidenodes": [
         ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
         ["rsm1l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm1r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm2l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm2r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm3l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm3r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm11l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm11r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm12l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm12r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm13l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm13r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         //travel limit beams
         ["rsm5l", "fRail1L", true, true, 0, 8001000, "FLT_MAX", "FLT_MAX"],
         ["rsm5r", "fRail1R", true, true, 0, 8001000, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          //--ATTACH MUDFLAPS
          {"beamSpring":3100100,"beamDamp":80},
          {"beamDeform":35000,"beamStrength":35000},
          {"breakGroup":"mudflap_RR_break"},
          {"optional":true},
          ["mflpf3r","rsm3r"],
          ["mflpf3r","rsm13r"],
          ["mflpf2r","rsm3r"],
          ["mflpf2r","rsm13r"],
          ["mflpf1r","rsm3r"],
          ["mflpf1r","rsm13r"],
          ["mflpf1rr","rsm3r"],
          ["mflpf1rr","rsm13r"],
