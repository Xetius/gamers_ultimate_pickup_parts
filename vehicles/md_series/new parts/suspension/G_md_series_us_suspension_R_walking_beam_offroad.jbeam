          ["mflpf1r","rsm3l"],
          ["mflpf1r","rsm13l"],
          {"beamSpring":2100100,"beamDamp":80},
          ["mflpf3r","rsm2r"],
          ["mflpf2r","rsm2r"],
          ["mflpf1r","rsm2r"],
          {"breakGroup":"mudflap_RL_break"},
          {"beamSpring":3100100,"beamDamp":80},
          ["mflpf3l","rsm3l"],
          ["mflpf3l","rsm13l"],
          ["mflpf2l","rsm3l"],
          ["mflpf2l","rsm13l"],
          ["mflpf1l","rsm3l"],
          ["mflpf1l","rsm13l"],
          ["mflpf1ll","rsm3l"],
          ["mflpf1ll","rsm13l"],
          ["mflpf2ll","rsm3l"],
          ["mflpf2ll","rsm13l"],
