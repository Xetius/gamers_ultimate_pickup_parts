          ["rsm2l", "rsm12r"],
          ["rsm2r", "rsm12l"],
          ["rsm1l", "rsm11r"],
          ["rsm1r", "rsm11l"],
          {"beamSpring":5100100,"beamDamp":250},
          ["rsm3l", "rsm13r"],
          ["rsm3r", "rsm13l"],
          ["rsm2l", "rsm3r"],
          ["rsm2r", "rsm3l"],
