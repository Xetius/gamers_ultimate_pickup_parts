          ["mflpf3l","rsm13r"],
          ["mflpf2l","rsm3r"],
          ["mflpf2l","rsm13r"],
          ["mflpf1l","rsm3r"],
          ["mflpf1l","rsm13r"],
          {"beamSpring":2100100,"beamDamp":80},
          ["mflpf3l","rsm2l"],
          ["mflpf2l","rsm2l"],
          ["mflpf1l","rsm2l"],
          {"optional":false},
          {"breakGroup":""},
          //--REAR RUNNING GEAR--
          //attach suspension points to each other
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":20100100,"beamDamp":250},
          {"beamDeform":250000,"beamStrength":950000},
          ["rx1l", "rx1r"],
          ["rx2l", "rx2r"],
          ["rx1l", "rx2l"],
          ["rx1r", "rx2r"],
          ["rx2r", "rx1l"],
