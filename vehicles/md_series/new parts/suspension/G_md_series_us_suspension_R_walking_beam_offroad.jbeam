         ["G_md_series_us_torquerod_mount_a_R_2", ["md_series_axle_R_2"]],
    ],
    "rails": {
          "leafRL":{"links:":["rx6l", "rx15l"], "looped":false, "capped":true},
          "leafRR":{"links:":["rx6r", "rx15r"], "looped":false, "capped":true},
          "leaf2RL":{"links:":["rx5l", "rlf2l"], "looped":false, "capped":true},
          "leaf2RR":{"links:":["rx5r", "rlf2r"], "looped":false, "capped":true},
    },
    "slidenodes": [
         ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
         ["rx5l", "leafRL", true, true, 0, 25001000, "FLT_MAX", "FLT_MAX"],
         ["rx5r", "leafRR", true, true, 0, 25001000, "FLT_MAX", "FLT_MAX"],
         ["rx2l", "leaf2RL", true, true, 0, 25001000, "FLT_MAX", "FLT_MAX"],
         ["rx2r", "leaf2RR", true, true, 0, 25001000, "FLT_MAX", "FLT_MAX"],
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //rigidify spring mount
        {"spring":10000000, "damp":4, "deform":75000, "strength":2500000},
        ["rx1r", "rsm11l", "rsm1l", "rsm2l"],
        ["rx1l", "rsm11r", "rsm1r", "rsm2r"],
        {"spring":5000000, "damp":2, "deform":145000, "strength":2500000},
        ["rx1r", "rsm11r", "rsm11l", "rsm12r"],
        ["rx1l", "rsm11l", "rsm11r", "rsm12l"],
        //rigidify beam
        {"spring":4000000, "damp":4, "deform":125000, "strength":2500000},
        ["rx5r", "rx5l", "rx6l", "rx6r"],
        ["rx5l", "rx5r", "rx6r", "rx6l"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":20.0},
         {"group":"md_series_leafmounts_R1"},
         ["rx1l", 0.527, 3.635, 0.641],
         ["rx1r",-0.527, 3.635, 0.641],
         {"group":"md_series_leafmounts_R2"},
         ["rx2l", 0.527, 4.359, 0.603],
         ["rx2r",-0.527, 4.359, 0.603],
         {"nodeWeight":10.0},
         //rear leaf spring node
         {"group":"md_series_leaf_R"},
         ["rlf2l", 0.527, 4.400, 0.6042],
         ["rlf2r",-0.527, 4.400, 0.6042],
         {"collision":true},
         {"nodeWeight":20.0},
         {"group":"md_series_beamsaddle"},
         {"selfCollision":true},
         ["rx5r",-0.527, 3.998, 0.592{"group":["md_series_beamsaddle","md_series_leaf_R"]}],
         ["rx5l", 0.527, 3.998, 0.592{"group":["md_series_beamsaddle","md_series_leaf_R"]}],
         ["rx6r",-0.527, 3.990, 0.299{"group":["md_series_beamsaddle","md_series_walkingbeam_tandem_R"]}],
         ["rx6l", 0.527, 3.990, 0.299{"group":["md_series_beamsaddle","md_series_walkingbeam_tandem_R"]}],
         {"selfCollision":false},
         //anti wrap
         {"group":""},
         {"nodeWeight":10.0},
         {"collision":false},
         ["rx15r",-0.527, 3.998, 0.9],
         ["rx15l", 0.527, 3.998, 0.9],
         {"selfCollision":true},
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":50001000,"beamDamp":250},
          {"beamDeform":450000,"beamStrength":"FLT_MAX"},
          //anti wrap nodes
          ["rx15l","rx1l"],
          ["rx15r","rx1r"],
          ["rx15l","rlf2l"],
          ["rx15r","rlf2r"],
          //damp
          {"beamSpring":0,"beamDamp":250},
          {"beamDeform":45000,"beamStrength":"FLT_MAX"},
          ["rx15l","rx4"],
          ["rx15r","rx3"],
          ["rx15l","rx3"],
          ["rx15r","rx4"],

          //leaf spring
          {"beamDeform":820000,"beamStrength":"FLT_MAX"},
          {"beamSpring":50001000,"beamDamp":500},
          ["rx1r","rx5r"],
          ["rx1l","rx5l"],
          ["rlf2r","rx5r"],
          ["rlf2l","rx5l"],
          {"beamType":"|LBEAM"},
          {"beamSpring":860100,"beamDamp":4000},
          {"beamPrecompression":1.02},
          ["rx1r","rx6r", {"id3:":"rx5r","beamPrecompressionTime":0.3}],
          ["rx1l","rx6l", {"id3:":"rx5l","beamPrecompressionTime":0.3}],
          ["rlf2r","rx6r", {"id3:":"rx5r","beamPrecompressionTime":0.3}],
          ["rlf2l","rx6l", {"id3:":"rx5l","beamPrecompressionTime":0.3}],
          {"beamPrecompression":1},

          //suspension audio hook beams
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":120000,"beamStrength":250000},
          {"beamSpring":1000,"beamDamp":0},
          ["rsm5l","rx5l",{"soundFile":"event:>Vehicle>Suspension>semi_01>spring_compress_01","colorFactor":1.00,"attackFactor":8,"volumeFactor":3.5,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":20}],
          ["rsm5r","rx5r",{"soundFile":"event:>Vehicle>Suspension>semi_01>spring_compress_01","colorFactor":1.00,"attackFactor":8,"volumeFactor":3.5,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":20}],

          //lateral stabilizer
          {"beamDeform":120000,"beamStrength":"FLT_MAX"},
          {"beamSpring":4001000,"beamDamp":2500},
          ["rx5l","rx1r"],
          ["rx5l","rlf2r"],
          ["rx5r","rx1l"],
          ["rx5r","rlf2l"],
          //walking beam mount
          {"beamSpring":30001000,"beamDamp":500},
          {"beamDeform":175000,"beamStrength":"FLT_MAX"},
          ["rx5r","rx6r"],
          ["rx5l","rx6l"],
          ["rx5l","rx5r"],
          ["rx5l","rx6r"],
          ["rx5r","rx6l"],
          {"beamSpring":60001000,"beamDamp":500},
          ["rx6r","rx6l"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
