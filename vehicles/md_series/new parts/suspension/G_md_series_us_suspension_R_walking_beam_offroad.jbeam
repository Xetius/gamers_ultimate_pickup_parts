          ["rx3", "rx4"],
          ["rx3", "rx1l"],
          ["rx3", "rx2l"],
          ["rx3", "rx1r"],
          ["rx3", "rx2r"],
          ["rx4", "rx1l"],
          ["rx4", "rx2l"],
          ["rx4", "rx2r"],
          ["rx4", "rx1r"],
          //crossmember
          {"beamSpring":7100100,"beamDamp":250},
          {"beamDeform":250000,"beamStrength":950000},
          ["rsm1l", "rsm11l"],
          ["rsm1r", "rsm11r"],
          ["rsm2r", "rsm12r"],
          ["rsm2l", "rsm12l"],
