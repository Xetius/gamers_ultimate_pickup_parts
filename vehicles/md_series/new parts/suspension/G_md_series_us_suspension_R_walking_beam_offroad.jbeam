"G_md_series_us_wbeam_springs_alt_light": {
    "information":{
        "authors":"Gamer!",
        "name":"Light Duty Rear Leaf Springs",
        "value":800,
    },
    "slotType" : "G_md_series_us_wbeam_springs_alt",
    "slots2": [
        ["name",                       "allowTypes",                   "denyTypes", "default",                    "description"],
        ["G_md_series_us_wbeam_axles", ["G_md_series_us_wbeam_axles"], [],          "G_md_series_us_wbeam_axles", "Axles",       {"coreSlot":true}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
