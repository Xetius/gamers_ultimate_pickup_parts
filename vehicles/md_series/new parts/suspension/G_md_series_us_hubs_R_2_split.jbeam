        "name":"Demountable Rim Rear Rear Hubs",
        "value":100,
    },
    "slotType" : "G_md_series_us_hubs_R_2",
    "slots2": [
        ["name",                      "allowTypes",                  "denyTypes", "default",                   "description"],
        ["G_md_series_brake_DX2",     ["G_md_series_brake_DX2"],     [],          "G_md_series_brake_DX2",     "Rear Rear Brakes",   {"nodeOffset3":{"x":0.0, "y":0.0, "z":"$=$components.md_series_suspensionoffest_R.md_series_suspensionoffest_R"}}],
        ["G_wheel_R_2_5_old",         ["G_wheel_R_2_5_old"],         [],          "G_wheel_R_2_5_old",         "Rear Rear Wheels",   {"nodeOffset3":{"x":-0.01, "y":3.170, "z":"$=0.562+$components.md_series_suspensionoffest_R.md_series_suspensionoffest_R"}}],
        ["G_md_series_wheeldata_R_2", ["G_md_series_wheeldata_R_2"], [],          "G_md_series_wheeldata_R_2", "Rear Rear Spindles", {"coreSlot":true}],
    ],
     "components": {
        "dualyOffsets_RR": {
           "offsetInner": 0.01
           "offsetOuter": -0.35
        },
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["semi_wheel_split_R_hub_20", ["wheel_R2RR","wheelhub_R2RR"], [], {"pos":{"x":-1.07,"y":3.170, "z":"$=0.562+$components.md_series_suspensionoffest_R.md_series_suspensionoffest_R"}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":180}}],
        ["semi_wheel_split_R_hub_20", ["wheel_R2LL","wheelhub_R2LL"], [], {"pos":{"x": 1.07,"y":3.170, "z":"$=0.562+$components.md_series_suspensionoffest_R.md_series_suspensionoffest_R"}, "scale":{"x":1.0,"y":1.0,"z":1.0}, "rot":{"x":0,"y":0,"z":0}}],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":20},
         {"group":"wheelhub_R2RR"},
         ["dw2r", -0.50,   1.840,  0.562],
         ["dw2rr",-1.06,   1.840,  0.562],
         {"group":"wheelhub_R2LL"},
         ["dw2l",  0.50,   1.840,  0.562],
         ["dw2ll", 1.06,   1.840,  0.562],
         {"group":""},
    ],
    "beams": [
          ["id1:",  "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":""},

          //wheel to axle
          {"deformLimitExpansion":1.2},
          {"optional":true},
          {"beamSpring":40001000,"beamDamp":400},
          {"beamDeform":377000,"beamStrength":1750000},
          {"breakGroup":"wheel_RRR"},
          ["dw2rr", "2ax1r"],
          ["dw2rr", "2ax2r"],
          ["dw2rr", "2ax3r"],
          ["dw2rr", "2ax4r",  {"breakGroup":["wheel_RRR","axle_break_DX2"],"breakGroupType":1}],
          ["dw2r",  "2ax4",   {"beamSpring":25001000}],
          ["dw2r",  "2ax3",   {"beamSpring":25001000}],
          ["dw2r",  "2ax2",   {"beamSpring":25001000}],
          ["dw2r",  "2ax1",   {"beamSpring":25001000, "name":"axle_RRR"}],
          ["dw2r",  "2ax1r"],
          ["dw2r",  "2ax2r"],
          ["dw2r",  "2ax3r"],
          //["dw2r","2ax4r"],
          {"breakGroup":"wheel_RRL"},
          ["dw2ll", "2ax1l"],
          ["dw2ll", "2ax2l"],
          ["dw2ll", "2ax3l"],
          ["dw2ll", "2ax4l",  {"breakGroup":["wheel_RRL","axle_break_DX2"],"breakGroupType":1}],
          ["dw2l",  "2ax4",   {"beamSpring":25001000}],
          ["dw2l",  "2ax3",   {"beamSpring":25001000}],
          ["dw2l",  "2ax2",   {"beamSpring":25001000}],
          ["dw2l",  "2ax1",   {"beamSpring":25001000, "name":"axle_RRL"}],
          ["dw2l",  "2ax1l"],
          ["dw2l",  "2ax2l"],
          ["dw2l",  "2ax3l"],
          //["dw2l","2ax4l"],
          {"optional":false},
          {"breakGroup":""},

          //damping help
          {"optional":true},
          {"beamSpring":0,"beamDamp":2500},
          {"beamDeform":377000,"beamStrength":1822000},
          {"breakGroup":["wheel_RRR","axle_break_DX2"],"breakGroupType":1},
          ["dw2rr", "rsm12r", {"dampCutoffHz":500}],
          ["dw2r",  "rsm12r", {"dampCutoffHz":500}],
          {"breakGroup":["wheel_RRL","axle_break_DX2"],"breakGroupType":1},
          ["dw2ll", "rsm12l", {"dampCutoffHz":500}],
          ["dw2l",  "rsm12l", {"dampCutoffHz":500}],
          {"breakGroup":""},
          {"breakGroupType":0},
          {"optional":false},

          {"deformLimitExpansion":1.2},
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"disableMeshBreaking":false,"disableHubMeshBreaking":false,"enableHubcaps":false,"hasTire":false},
        //hub
        //general settings
        {"hubRadius":0.22},
        {"hubWidth":0.1},
        {"numRays":10},
        {"brakeSpring":25},//define lower value for stability with no wheels

        //hub options
        {"hubTreadBeamSpring":2500000, "hubTreadBeamDamp":5},
        {"hubPeripheryBeamSpring":2500000, "hubPeripheryBeamDamp":5},
        {"hubSideBeamSpring":2500000, "hubSideBeamDamp":5},
        {"hubNodeWeight":2},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":75000, "hubBeamStrength":185000},
    ],
},
