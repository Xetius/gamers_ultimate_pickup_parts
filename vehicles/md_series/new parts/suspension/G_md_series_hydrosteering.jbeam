{
"G_md_series_hydrosteering_SFA": {
    "information":{
        "authors":"Gamer!",
        "name":"Hydraulic Steering",
        "value":1400,
    },
    "slotType" : "md_series_steering_SFA",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_md_series_hydrosteering_rack", ["md_series_steeringrack"]],
        ["G_md_series_hydrosteering_body", ["md_series_steeringrack_body", "md_series_axle_F"]],
        ["G_md_series_hydrosteering_hanger", ["md_series_steeringrack_body", "md_series_axle_F"]],
        ["G_md_series_hydrosteering_ubolts", ["md_series_steeringrack_body", "md_series_axle_F"]],
        ["G_md_series_hydrosteering_nuts", ["md_series_steeringrack_body", "md_series_axle_F"]],
        ["G_md_series_hydrosteering_arm_R", ["md_series_tierod_F", "md_series_tierod_FR"]],
        ["G_md_series_hydrosteering_arm_L", ["md_series_tierod_F", "md_series_tierod_FL"]],
    ],
    //steering rack rail
    "rails": {
        "steeringrack_main":{"links:":["st1r", "st1l"], "broken:":[], "looped":false, "capped":true},
        "steeringrack_extra":{"links:":["st3r", "st3l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["st2r", "steeringrack_main", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["st2l", "steeringrack_main", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["st4r", "steeringrack_extra", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
        ["st4l", "steeringrack_extra", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$hydro_toe", "range", "", "Wheel Alignment", 0.999, 1.02, 0.98, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$hydro_steer_center_SFA", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "nodes": [
        ["id",   "posX",  "posY",  "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":8.4},
        //steering rack ends
        {"group":["md_series_steeringrack_body"]},
        ["st2r",-0.22000,-1.23, 0.38, {"selfCollision":true}],
        ["st4r",-0.22000,-1.23, 0.25, {"nodeWeight":0.5,"collision":false}],
        ["st2l", 0.22000,-1.23, 0.38, {"selfCollision":true}],
        ["st4l", 0.22000,-1.23, 0.25, {"nodeWeight":0.5,"collision":false}],
        //axle mounting points for steering rack
        {"nodeWeight":7.0},
        {"group":["md_series_steeringrack","md_series_tierod_FR"]},
        ["st1r",-0.39000,-1.23, 0.38, {"selfCollision":true}],
        ["st3r",-0.39000,-1.23, 0.25, {"nodeWeight":0.5,"collision":false}],
        {"group":["md_series_steeringrack","md_series_tierod_FL"]},
        ["st1l", 0.39000,-1.23, 0.38, {"selfCollision":true}],
        ["st3l", 0.39000,-1.23, 0.25, {"nodeWeight":0.5,"collision":false}],
        {"group":""},
    ],
    "beams": [
        ["id1:",  "id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":6001000,"beamDamp":140},
        {"beamDeform":181000,"beamStrength":"FLT_MAX"},
        //steering rack mounting to axle
        {"deformLimitExpansion":1.2},
        ["st2r",  "fa1"],
        ["st2l",  "fa1"],
        ["st2r",  "fa4"],
        ["st2l",  "fa4"],

        {"beamSpring":10001000,"beamDamp":140},
        ["st2r",  "fa4r"],
        ["st2r",  "fa5r"],
        ["st2l",  "fa4l"],
        ["st2l",  "fa5l"],

        {"beamSpring":501000,"beamDamp":140},
        //rack extra flexbody helpers
        ["st4r",  "fa1"],
        ["st4l",  "fa1"],
        ["st4r",  "fa4"],
        ["st4l",  "fa4"],
        ["st4r",  "fa4r"],
        ["st4r",  "fa5r"],
        ["st4l",  "fa4l"],
        ["st4l",  "fa5l"],

        ["st1r",  "st3r"],
        ["st1l",  "st3l"],
        ["st1r",  "st3l"],
        ["st1l",  "st3r"],
        ["st1r",  "st1l"],
        ["st3l",  "st3r"],

        ["st2r",  "st4r"],
        ["st2l",  "st4l"],
        ["st2r",  "st4l"],
        ["st2l",  "st4r"],
        ["st4l",  "st4r"],
        {"deformLimitExpansion":""},

        //center link
        {"beamDeform":250000,"beamStrength":2450000},
        {"beamSpring":18001000,"beamDamp":180},
        ["st2r",  "st2l"],

        //tie rod ends
        {"beamSpring":20001000,"beamDamp":180},
        //["fh3r","st2r", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        //["fh3l","st2l", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        ["fa6r", "st1r",  {"beamPrecompression":"$=$hydro_toe-$hydro_steer_center_SFA","beamPrecompressionTime":0.5}],
        ["fa6l", "st1l",  {"beamPrecompression":"$=$hydro_toe+$hydro_steer_center_SFA","beamPrecompressionTime":0.5}],

        //steering damper
        {"beamSpring":0,"beamDeform":78800,"beamStrength":195000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamDamp":300},
        ["st2l", "fa16l", {"beamDampVelocitySplit":0.05,"beamDampFast":1000,"dampCutoffHz":750}],
        ["st2l", "fa16r", {"beamDampVelocitySplit":0.05,"beamDampFast":1000,"dampCutoffHz":750}],
        ["st2r", "fa16l", {"beamDampVelocitySplit":0.05,"beamDampFast":1000,"dampCutoffHz":750}],
        ["st2r", "fa16r", {"beamDampVelocitySplit":0.05,"beamDampFast":1000,"dampCutoffHz":750}],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"| BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":20001000,"beamDamp":250,"beamDeform":"FLT_MAX","beamStrength":276500},
        ["st2l","st1r", {"factor":-0.25, "steeringWheelLock":580, "inRate":1.4,"outRate":1.4}],
        ["st2r","st1l", {"factor":0.25,"steeringWheelLock":580, "inRate":1.4,"outRate":1.4}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*6",
    },
},
}