{
"G_md_series_us_transfer_case_interaxle": {
    "information":{
        "authors":"Gamer!",
        "name":"Locking Inter Axle Transfer Case",
        "value":900,
    },
    "slotType" : "G_md_series_us_transfer_case_interaxle",
    "slots2": [
        ["name",                      "allowTypes",                  "denyTypes", "default",            "description"],
        ["G_md_series_us_intershaft", ["G_md_series_us_intershaft"], [],          "G_md_series_us_intershaft", "Inter Axle Driveshaft"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["md_series_switch_interaxlediff_base", ["md_series_dash", "md_series_dash_alt"], [],{"nodeMove":{"x":0.0, "y":0.0, "z":0.0}, "pos":{"x":0.0, "y":"$= $cabOffsetY == nil and 0-$components.md_series_tandem_offest_Y or $cabOffsetY-$components.md_series_tandem_offest_Y", "z":"$= $cabOffsetZ == nil and 0 or $cabOffsetZ-$components.md_series_tandem_offest_Z"}}],
    ],
    "props": [
        ["func",      "mesh",                      "idRef:","idX:","idY:", "baseRotation",                      "rotation",           "translation",           "min", "max", "offset", "multiplier"],
        ["G_interaxle_lock", "md_series_switch_reardiff", "dshl","dsh","dsh2", {"x":40, "y":180, "z":0}, {"x":90, "y":0, "z":0},  {"x":0, "y":0, "z":0},  0, 1, 0, 1, {"nodeMove":{"x":0.0, "y":0.0, "z":0.0}, "baseTranslationGlobal":{"x":0.331293, "y":"$= $cabOffsetY == nil and -0.667967-$components.md_series_tandem_offest_Y or $cabOffsetY-0.667967-$components.md_series_tandem_offest_Y", "z":"$= $cabOffsetZ == nil and 1.536 or $cabOffsetZ+1.536-$components.md_series_tandem_offest_Z"}}],
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["G_interaxle_lock","dsh","dshl","dsh2", "sphere", 0.015, {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.330, "y":"$= $cabOffsetZ == nil and 0.020 or 0.1*$cabOffsetZ+0.020", "z":"$= $cabOffsetZ == nil and -0.025 or 0.3*$cabOffsetZ-0.025"}, {"nodeMove":{"x":0.0, "y":0.0, "z":0.0}, "deformGroup":"", "color": [0, 0, 1, 0.4]}],
    ],
    "actionsEnabled": [
        ["id"],
        ["G_toggleCenterDiff"],
        ["G_lockCenterDiff"],
        ["G_unlockCenterDiff"],
        ["G_setCenterDiffModeAxis"],
    ],
    "triggerEventLinks2": [
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["G_interaxle_lock", "action0", "G_toggleCenterDiff"],
    ],
    "controller": [
        ["fileName"],
        ["driveModes", {"name":"G_interaxleLockControl"}]
       // ["4wd", {"driveModesDifferentialNames":["interaxleLockControl"],"name":"interaxleLockControl4wd"}]
    ],
    "G_interaxleLockControl":{
        "uiName": "Interaxle Differential"
        "quickAccessTitle":"Interaxle Differential"
        "quickAccessIcon":"differentialMiddleDefault"
        "quickAccessLevel":"/vehicleFeatures/"
        "enabledModes":["unlocked", "locked"]
        "defaultMode": "unlocked"
        "modes": {
            "unlocked": {
                "name": "Unlocked",
                "order": 10,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"transfercase_interaxle", "mode":"open"}]
                    ["electricsValue", {"electricsName":"G_interaxle_lock", "value":0}]
                    ["quickAccess", {"icon":"differentialMiddleDefault"}]
                    ["simpleControlButton", {"buttonId":"interDiff", "icon":"powertrain_differential_open", "uiName":"Interaxle Differential"}]
                ],
            },
            "locked": {
                "name": "Locked",
                "order": 20,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"transfercase_interaxle", "mode":"locked"}]
                    ["electricsValue", {"electricsName":"G_interaxle_lock", "value":1}]
                    ["quickAccess", {"icon":"differentialMiddleLocked"}]
                    ["simpleControlButton", {"buttonId":"interDiff", "icon":"powertrain_differential_closed", "uiName":"Interaxle Differential"}]
                ],
            },
        }
    }
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //lockable diff between front rear and rear rear diff
        ["differential", "transfercase_interaxle", "driveshaft", 1, {"uiSimpleModeControl":false,"diffType":["open","locked"], "lockTorque":50000, "uiName":"Interaxle Differential"}],
    ],
    "transfercase_interaxle": {
        "friction": 1.56,
        "dynamicFriction": 0.00179,
        "torqueLossCoef": 0.015,
    },
},
"G_md_series_us_differential_R_1": {
    "information":{
        "authors":"Gamer!",
        "name":"Open Rear Differential",
        "value":900,
    },
    "slotType" : "G_md_series_us_differential_R_1",
    "slots2": [
        ["name",                   "allowTypes",               "denyTypes", "default",                    "description"],
        ["md_series_finaldrive_R", ["md_series_finaldrive_R"], [],           "md_series_finaldrive_R_462", "Rear Final Drive", {"coreSlot":true}],
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //rear diff
        ["torsionReactor", "torsionReactor_R_1", "transfercase_interaxle", 1, {}],
        ["differential", "differential_R", "torsionReactor_R_1", 1, {"diffType":"open", "uiName":"Rear Differential"}],
    ],
    "differential_R_1": {
        "friction": 18.4,
        "dynamicFriction": 0.0088,
        "torqueLossCoef": 0.03,
    },
    "torsionReactor_R_1": {
        "torqueReactionNodes:":["en4l","en3l","en1r"],
    },
},
