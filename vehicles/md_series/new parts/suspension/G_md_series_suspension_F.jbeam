          ["fa1r",   "ff13r",  {"soundFile":"event:>Vehicle>Suspension>semi_01>leaf_compress_01","colorFactor":1.00,"attackFactor":8,"volumeFactor":6,"decayFactor":12,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":20}],


