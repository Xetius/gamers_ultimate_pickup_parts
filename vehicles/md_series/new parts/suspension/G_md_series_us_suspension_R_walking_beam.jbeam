{
"G_md_series_us_R_suspension_wbeam": {
    "information":{
        "authors":"Gamer!",
        "name":"Walking Beam Tandem Suspension",
        "value":1200,
    },
    "slotType" : ["md_series_suspension_R_single"],
    "slots2": [
        ["name",                             "allowTypes",                         "denyTypes", "default",                            "description"],
        ["G_md_series_us_wbeam_springs",     ["G_md_series_us_wbeam_springs"],     [],          "G_md_series_us_wbeam_springs_heavy", "Leaf Springs",                  {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":0.0}}],
        ["G_md_series_us_brakeValve_R",      ["G_md_series_us_brakeValve_R"],      [],          "G_md_series_us_brakeValve_R",        "Rear Air Brake control Valve",  {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":0.0}}],
        ["G_md_series_us_driveshaft_tandem", ["G_md_series_us_driveshaft_tandem"], [],          "G_md_series_us_driveshaft_tandem",   "Rear Driveshaft",               {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":0.0}}],
        ["G_md_series_us_liftaxle_R",        ["G_md_series_us_liftaxle_R"],        [],          "",                                   "Rear Lift Axle",                {"nodeOffset":{"x":0.0, "y":"$=$suspension_move_R-2.15", "z":0.0}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$suspension_move_R", "range", "+m", "Suspension", 0, -1.2, 0.8, "Axle Position", "Adjust the position of the rear axles according to frame and application", {"stepDis":0.05, "subCategory":"Rear"}],
    ],
    "components": {
        "driveshaft_R_tandem": {
           "enable": true
        },
        "md_series_suspensionoffest_R": {
            "md_series_suspensionoffest_R": 0.0,
        },
        "md_series_tandem_offest_Y": "$=$suspension_move_R-2.15",
        "md_series_tandem_offest_Z": 0.0,
        "md_series_mudflap_offset": 0.6,
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_md_series_us_frame_crossmember_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_torquerod_mount_b_R_1", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_torquerod_mount_b_R_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_bumpstop_tandem", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],

         ["G_md_series_us_hanger_tandem_1", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
         ["G_md_series_us_hanger_tandem_2", ["md_series_frame_mid","md_series_frame_end"],[],{"pos":{"x":0,"y":"$=$suspension_move_R-2.15","z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //--REAR RUNNING GEAR--
         {"nodeWeight":13},
         //suspension mounts
         {"selfCollision":true},
         {"collision":true},
         {"group":"md_series_torquerod_R_mount"},
         ["rx3",  0.000, "$=$suspension_move_R+1.740", 0.820],
         {"group":"md_series_torquerod_R_mount"},
         ["rx4",  0.000, "$=$suspension_move_R+1.956", 0.820],
         {"group":""},
         {"selfCollision":false},
         {"collision":false},
         {"nodeWeight":12},
         ["rsm1l", 0.434, "$=$suspension_move_R+1.18", 0.95],
         ["rsm1r",-0.434, "$=$suspension_move_R+1.18", 0.95],
         ["rsm2l", 0.434, "$=$suspension_move_R+2.51", 0.95],
         ["rsm2r",-0.434, "$=$suspension_move_R+2.51", 0.95],
         ["rsm11l", 0.434, "$=$suspension_move_R+1.18", 0.69],
         ["rsm11r",-0.434, "$=$suspension_move_R+1.18", 0.69],
         ["rsm12l", 0.434, "$=$suspension_move_R+2.51", 0.69],
         ["rsm12r",-0.434, "$=$suspension_move_R+2.51", 0.69],
         {"nodeWeight":5},
         //extra nodes for mudflaps to hang on
         ["rsm13l", 0.434, "$=$suspension_move_R+2.8750", 0.69],
         ["rsm13r",-0.434, "$=$suspension_move_R+2.8750", 0.69],
         ["rsm3l", 0.434, "$=$suspension_move_R+2.8750", 0.95],
         ["rsm3r",-0.434, "$=$suspension_move_R+2.8750", 0.95],
         //travel limiter node
         {"nodeWeight":5},
         ["rsm5l", 0.434, "$=$suspension_move_R+1.840", 0.95],
         ["rsm5r",-0.434, "$=$suspension_move_R+1.840", 0.95],
         {"group":""},
    ],
    "slidenodes": [
         ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
         ["rsm1l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm1r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm2l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm2r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm3l", "fRail1L", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm3r", "fRail1R", true, true, 0, 10001000, "FLT_MAX", "FLT_MAX"],
         ["rsm11l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm11r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm12l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm12r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm13l", "fRail2L", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         ["rsm13r", "fRail2R", true, true, 0, 20001000, "FLT_MAX", "FLT_MAX"],
         //travel limit beams
         ["rsm5l", "fRail1L", true, true, 0, 8001000, "FLT_MAX", "FLT_MAX"],
         ["rsm5r", "fRail1R", true, true, 0, 8001000, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          //--ATTACH MUDFLAPS
          {"beamSpring":3100100,"beamDamp":80},
          {"beamDeform":35000,"beamStrength":35000},
          {"breakGroup":"mudflap_RR_break"},
          {"optional":true},
          ["mflpf3r","rsm3r"],
          ["mflpf3r","rsm13r"],
          ["mflpf2r","rsm3r"],
          ["mflpf2r","rsm13r"],
          ["mflpf1r","rsm3r"],
          ["mflpf1r","rsm13r"],
          ["mflpf1rr","rsm3r"],
          ["mflpf1rr","rsm13r"],
          ["mflpf2rr","rsm3r"],
          ["mflpf2rr","rsm13r"],
          ["mflpf3r","rsm3l"],
          ["mflpf3r","rsm13l"],
          ["mflpf2r","rsm3l"],
          ["mflpf2r","rsm13l"],
          ["mflpf1r","rsm3l"],
          ["mflpf1r","rsm13l"],
          {"beamSpring":2100100,"beamDamp":80},
          ["mflpf3r","rsm2r"],
          ["mflpf2r","rsm2r"],
          ["mflpf1r","rsm2r"],
          {"breakGroup":"mudflap_RL_break"},
          {"beamSpring":3100100,"beamDamp":80},
          ["mflpf3l","rsm3l"],
          ["mflpf3l","rsm13l"],
          ["mflpf2l","rsm3l"],
          ["mflpf2l","rsm13l"],
          ["mflpf1l","rsm3l"],
          ["mflpf1l","rsm13l"],
          ["mflpf1ll","rsm3l"],
          ["mflpf1ll","rsm13l"],
          ["mflpf2ll","rsm3l"],
          ["mflpf2ll","rsm13l"],
          ["mflpf3l","rsm3r"],
          ["mflpf3l","rsm13r"],
          ["mflpf2l","rsm3r"],
          ["mflpf2l","rsm13r"],
          ["mflpf1l","rsm3r"],
          ["mflpf1l","rsm13r"],
          {"beamSpring":2100100,"beamDamp":80},
          ["mflpf3l","rsm2l"],
          ["mflpf2l","rsm2l"],
          ["mflpf1l","rsm2l"],
          {"optional":false},
          {"breakGroup":""},
          //--REAR RUNNING GEAR--
          //attach suspension points to each other
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":20100100,"beamDamp":250},
          {"beamDeform":250000,"beamStrength":950000},
          ["rx1l", "rx1r"],
          ["rx2l", "rx2r"],
          ["rx1l", "rx2l"],
          ["rx1r", "rx2r"],
          ["rx2r", "rx1l"],
          ["rx1r", "rx2l"],
          ["rx3", "rx4"],
          ["rx3", "rx1l"],
          ["rx3", "rx2l"],
          ["rx3", "rx1r"],
          ["rx3", "rx2r"],
          ["rx4", "rx1l"],
          ["rx4", "rx2l"],
          ["rx4", "rx2r"],
          ["rx4", "rx1r"],
          //crossmember
          {"beamSpring":7100100,"beamDamp":250},
          {"beamDeform":250000,"beamStrength":950000},
          ["rsm1l", "rsm11l"],
          ["rsm1r", "rsm11r"],
          ["rsm2r", "rsm12r"],
          ["rsm2l", "rsm12l"],
          ["rsm2l", "rsm11l"],
          ["rsm1l", "rsm12l"],
          ["rsm2r", "rsm11r"],
          ["rsm1r", "rsm12r"],
          ["rsm2r", "rsm1r"],
          ["rsm11r", "rsm12r"],
          ["rsm2l", "rsm1l"],
          ["rsm11l", "rsm12l"],
          ["rsm2r", "rsm2l"],
          ["rsm12r", "rsm12l"],
          ["rsm1r", "rsm1l"],
          ["rsm11l", "rsm11r"],
          ["rsm1r", "rsm2l"],
          ["rsm2r", "rsm1l"],
          ["rsm11r", "rsm12l"],
          ["rsm12r", "rsm11l"],
          ["rsm2l", "rsm12r"],
          ["rsm2r", "rsm12l"],
          ["rsm1l", "rsm11r"],
          ["rsm1r", "rsm11l"],
          {"beamSpring":5100100,"beamDamp":250},
          ["rsm3l", "rsm13r"],
          ["rsm3r", "rsm13l"],
          ["rsm2l", "rsm3r"],
          ["rsm2r", "rsm3l"],
          ["rsm12l", "rsm13r"],
          ["rsm12r", "rsm13l"],
          ["rsm2l", "rsm13r"],
          ["rsm2r", "rsm13l"],
          ["rsm12l", "rsm3r"],
          ["rsm12r", "rsm3l"],
          //travel limit node
          {"beamSpring":5001000,"beamDamp":250},
          ["rsm5l", "rsm12r"],
          ["rsm5r", "rsm12l"],
          ["rsm5l", "rsm11r"],
          ["rsm5r", "rsm11l"],
          //susp points to crossmember
          {"beamSpring":14100100,"beamDamp":250},
          {"beamDeform":250000,"beamStrength":950000},
          ["rsm11l", "rx3"],
          ["rsm1l", "rx3"],
          ["rsm1r", "rx3"],
          ["rsm11r", "rx3"],
          ["rsm2r", "rx4"],
          ["rsm12r", "rx4"],
          ["rsm2l", "rx4"],
          ["rsm12l", "rx4"],
          ["rsm1l", "rx1l"],
          ["rsm11l", "rx1l"],
          ["rsm1r", "rx1r"],
          ["rsm11r", "rx1r"],
          ["rsm2r", "rx2r"],
          ["rsm12r", "rx2r"],
          ["rsm2l", "rx2l"],
          ["rsm12l", "rx2l"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
