            ["2ax1", "2ax1r", "2ax2"],
            ["2ax2", "2ax1r", "2ax2r"],
            ["2ax4l", "2ax4", "2ax3"],
            ["2ax3", "2ax3l", "2ax4l"],
            ["2ax3", "2ax4", "2ax4r"],
            ["2ax4r", "2ax3r", "2ax3"],
            ["2ax1l", "2ax3l", "2ax3"],
            ["2ax3", "2ax1", "2ax1l"],
            ["2ax3", "2ax3r", "2ax1r"],
            ["2ax1r", "2ax1", "2ax3"],

            //torque arms
            ["2ax1", "rx4r", "rx4"],
            ["rx4", "rx4l", "2ax1"],
            ["rx3", "rx3r", "1ax1"],
            ["1ax1", "rx3l", "rx3"],
            {"triangleType":"NORMALTYPE"},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //replace diff with direct shaft to front rear diff
        ["shaft", "transfercase_interaxle", "driveshaft", 1, {"uiName":"Pinion Shaft"}],
    ],
    "transfercase": {
        "friction": 1.05,
        "dynamicFriction": 0.00145,
    },
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
},
}