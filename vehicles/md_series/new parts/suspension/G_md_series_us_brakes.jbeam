{
"G_md_series_us_brakeValve_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Tandem Rear Brake Valve",
        "value":900,
    },
    "slotType" : "G_md_series_us_brakeValve_R",
    "controller": [
        ["fileName"],
        ["pneumatics/airbrakes", { "name": "airbrakes_R" }],
    ],
    "airbrakes_R": {
        "soundEvent":"event:>Vehicle>Pneumatics>Air_Brakes_02",
        "soundNode:":["1ax1"],
        "brakedWheels":["R1L", "R1LL","R1R","R1RR", "R2L", "R2LL","R2R","R2RR"],
        "brakeTorque": [
            ["pressure", "torqueCoef"],
            [21000, 0],
            [413685, 1],
        ],
        "springBrakeTorque": [
            ["pressure", "torqueCoef"],
            [0,      1],
            [413685, 0],
        ]
    },
},
"G_md_series_us_brake_R_liftaxle": {
    "information":{
        "authors":"Gamer!",
        "name":"Lift Axle Drum Brakes",
        "value":1000,
    },
    "slotType" : "G_md_series_us_brake_R_liftaxle",
    "slots2": [
        ["name",       "allowTypes",   "denyTypes", "default",    "description"],
        //["brakepad_F", ["brakepad_F"], [],          "brakepad_F", "Lift Axle Brake Shoes", {"coreSlot":true}],
        ["brakepad_La", ["brakepad_La"], [],          "brakepad_La", "Lift Axle Brake Shoes", {"coreSlot":true}],
    ],
    "controller": [
        ["fileName"],
        ["pneumatics/airbrakes", { "name": "airbrakes_La" }],
    ],
    "airbrakes_La": {
        "soundEvent":"event:>Vehicle>Pneumatics>Air_Brakes_02",
        "soundNode:":["La1"],
        "brakedWheels":["LaL", "LaR"],
        "brakeTorque": [
            ["pressure", "torqueCoef"],
            [21000, 0],
            [413685, 1],
        ],
    "springBrakeTorque": [
            ["pressure", "torqueCoef"],
            [0,      1],
            [413685, 0],
        ]
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //brake drums
         ["md_series_brakedrum_FR", ["wheel_LaR","wheelhub_LaR"], [], {"pos":{"x":-0.00, "y":3.50876, "z":-0.101}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
         ["md_series_brakedrum_FL", ["wheel_LaL","wheelhub_LaL"], [], {"pos":{"x": 0.00, "y":3.50876, "z":-0.101}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
         ["md_series_axle_brakes_F", ["md_series_hub_a_LaR","md_series_hub_b_LaR","md_series_hub_a_LaL","md_series_hub_b_LaL"], [], {"pos":{"x": 0.0, "y":3.50876, "z":-0.11}}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brake properties
        {"brakeTorque":"$=$brakestrength*10000"},
        {"useDefaultBrakeInput":false},
        {"parkingTorque":0},
        //{"brakeSpring":150},//define in hubs/wheels instead

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.42},
        {"brakeMass":45.0},
        {"brakeType":"drum"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.7},
    ],
},
