         {"group":""},
    ],
    "beams": [
          ["id1:",   "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //air filter main shape
          {"beamSpring":670000,"beamDamp":67},
