         // ["bc2l","bd4ll"],

         // ["bc1l","bd10ll"],
          //hinges
          {"breakGroup":"bedcover_FR"},
          ["bc3r","bd1rr"],
          ["bc3","bd1rr"],
          ["bc3r","bd3rr"],

          ["bc3r","bd6rr"],

          {"breakGroup":"bedcover_FL"},
          ["bc3l","bd1ll"],
          ["bc3","bd1ll"],
          ["bc3l","bd3ll"],
          ["bc3l","bd6ll"],
          {"breakGroup":""},
          {"beamSpring":1880,"beamDamp":100},
          {"beamDeform":4000,"beamStrength":10000},
          {"beamPrecompression":1.25},
          ["bc2r", "bd3rr", {"breakGroup":"bedcover_FR"}],
          ["bc2l", "bd3ll", {"breakGroup":"bedcover_FL"}],
          {"beamPrecompression":1},

          //--SUPPORT BEAMS--
          {"beamType":"|SUPPORT","beamLongBound":24},
          {"beamSpring":376940,"beamDamp":37.6},
          {"beamDeform":2835,"beamStrength":57400},
          ["bc3r","bd1rr"],
          ["bc3l","bd1ll"],
          ["bc3r","bdc1rr"],
          ["bc3l","bdc1ll"],

          ["bc2r","bd3rr"],
          ["bc2l","bd3ll"],
