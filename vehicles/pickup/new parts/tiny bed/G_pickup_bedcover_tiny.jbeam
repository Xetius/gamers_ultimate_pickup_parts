          ["bc1r","ibd5rr"],
          ["bc1l","ibd5ll"],
          ["bc1r","bdc4rr"],
          ["bc1l","bdc4ll"],

          {"optional":true},
          ["bc1r","t1"],
          ["bc1l","t1"],
          ["bc1","t2"],
          {"optional":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"group":"pickup_bedcover"},
            {"groundModel":"plastic"},
