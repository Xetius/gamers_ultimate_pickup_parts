{
"G_pickup_bedcover_tiny": {
    "information":{
        "authors":"Gamer!",
        "name":"Bed Cover",
        "value":300,
    },
    "slotType" : "G_pickup_bedextra_tiny",
    "slots": [
        ["type", "default", "description"],
        ["pickup_spoiler","","Spoiler"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_bedcover_tiny", ["pickup_bedcover"], [],{"pos":{"x":0,"y":1.1,"z":0}}],
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"bedCoverCoupler"}],
    ]
    "bedCoverCoupler":{
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["t1",      "bc1",       20000,                     0.015,                  0.005,                      0.2,                 0.1,                   "bedCoverLatch_break", {"forceCid1":"bd10", "forceCid2":"bc1"}]
        ]
        "groupType": "autoCoupling",
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["bc1"]
        "attachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_open",
        "breakSoundEvent":""
        "openForceMagnitude": 20,
        "openForceDuration": 0.2,
        "closeForceMagnitude": 10,
        "closeForceDuration": 1.0
    }
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["bedCover", "", "bc1","bc1r","bc2", "box", {"x":0.15, "y":0.05, "z":0.05}, {"x":0, "y":0, "z":0}, {"x":-5, "y":2.5, "z":2}, {"x":0, "y":0, "z":0}, {"x":-0.075, "y":0.0, "z":0}, {"deformGroup":"pickup_tailgate_R"}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["bedCover", "action0", "bedCoverLatch"]
    ],
    "events":[
        ["id", "title", "desc"],
        ["bedCoverLatch", "ui.inputActions.pickup.bedCoverLatch.title", "ui.inputActions.pickup.bedCoverLatch.description", {"onUp":"controller.getControllerSafe('bedCoverCoupler').toggleGroup()"}],
        ["tailgateLatch", "ui.inputActions.pickup.tailgateLatch.title", "ui.inputActions.pickup.tailgateLatch.description", {"onUp":"controller.getControllerSafe('tailgateCoupler').toggleGroupConditional({{'bedCoverCoupler','attached','vehicle.advancedCouplerControl.openOtherSideFirst'}})"}],

    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"nodeWeight":0.47},
         {"frictionCoef":0.5},
         {"group":"pickup_bedcover"},
         {"selfCollision":true},
         ["bc1r",-0.90, 2.49, 1.236],
         ["bc1", 0.00, 2.53, 1.21,{"selfCollision":false}],
         ["bc1l", 0.90, 2.49, 1.236],

         ["bc2r",-0.90, 1.765, 1.236],
         ["bc2", 0.0, 1.765, 1.236],
         ["bc2l", 0.90, 1.765, 1.236],

         ["bc3r",-0.90, 1.01, 1.236],
         ["bc3", 0.0, 1.01, 1.236],
         ["bc3l", 0.90, 1.01, 1.236],

         //rigidifier
         {"collision":false},
         {"selfCollision":false},
         {"group":""},
         ["bc4", 0.0, 1.49, 0.89],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //--bedcover--
          {"beamSpring":376940,"beamDamp":37.6},
          {"beamDeform":14000,"beamStrength":28000},
          {"deformLimitExpansion":1.2},
          ["bc1r","bc1"],
          ["bc1l","bc1"],
          ["bc2r","bc2"],
          ["bc2l","bc2"],
          ["bc3r","bc3"],
          ["bc3l","bc3"],

          ["bc1r","bc2r"],
          ["bc1","bc2"],
          ["bc1l","bc2l"],

          ["bc2r","bc3r"],
          ["bc2","bc3"],
          ["bc2l","bc3l"],

          //cross
          {"deformLimitExpansion":""},
          ["bc1r","bc2"],
          ["bc1l","bc2"],
          ["bc2r","bc1"],
          ["bc2l","bc1"],
          ["bc2r","bc3"],
          ["bc2l","bc3"],
          ["bc3r","bc2"],
          ["bc3l","bc2"],

          {"beamDeform":3500,"beamStrength":28000},
          //rigid
          {"disableMeshBreaking":true},
          ["bc1r","bc1l"],
          ["bc2r","bc2l"],
          ["bc3r","bc3l"],

          ["bc1r","bc3r"],
          ["bc1","bc3"],
          ["bc1l","bc3l"],


          {"beamDeform":2100,"beamStrength":28000},
          //rigidifier
          ["bc1r","bc4"],
          ["bc1","bc4"],
          ["bc1l","bc4"],
          ["bc2r","bc4"],
          ["bc2","bc4"],
          ["bc2l","bc4"],
          ["bc3r","bc4"],
          ["bc3","bc4"],
          ["bc3l","bc4"],
          {"disableMeshBreaking":false},

          //attach
          {"beamDeform":4100,"beamStrength":6500},
          {"breakGroup":"bedcover_RR"},
