{
"G_pickup_air_compressor": {
    "information": {
        "authors": "Gamer!",
        "name": "Air Compressor",
        "value": 4100,
    },
    "slotType" : "G_pickup_air_compressor",
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["compressor", "airCompressor1", "mainEngine", 1],
    ],
    "airCompressor1": {
        "pumpDisplacement": 0.00027
        "cutOutPressure":896318       //896318=130psi   1024250=150psi -- these need to account for atmosphere pressure
        "cutInPressure":723950
        "pumpEfficiency":0.8
        "energyStorage": ["mainAirTank", "leftAirTank", "rightAirTank", "rearAirTank"],
        //"purgeSoundNode": "atnk1r"
        "purgeSoundNode": "e3r"
        "compressorSoundNode": "e3l",
    },
},
