"G_pickup_D55_tanker_load_dynamic": {
    "information":{
        "authors":"Gamer!",
        "name":"Dynamic",
        "value":1,
    },
    "slotType" : "G_pickup_D55_tanker_load",
    "cargoStorage":[
        ["groupId", "name","cargoTypes", "capacity"],
        ["TankerUpfit", "Tanker Upfit",["fluid"], 7400],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$loadVolume", "range", "L", "Load", 0, 0, 7400, "Load Volume", "Amount of liquid loaded in the upfit", {"stepDis":1}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"group":"G_pickup_D55_tanker_load"},

         {"collision":true},
         {"selfCollision":false},
          {"nodeWeight":"$=0.50*$loadVolume*($loadVolume/7500)-(130*($loadVolume/7500))+2", "nodeWeightFunction":"=0.50*$volume*$density*($volume/7500)-(134*($volume/7500))+2","cargoGroup":"TankerUpfit"},
