          ["tnkl2s", 0.0,    1.1399, 1.4045],

          {"nodeWeight":"$=0.50*$loadVolume*(1-($loadVolume/7500))+1", "nodeWeightFunction":"=0.50*$volume*$density*(1-($volume/7500))+1","cargoGroup":"TankerUpfit"},
