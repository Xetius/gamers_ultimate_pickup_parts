          ["tnkl2p", 0.0,    1.1399, 0.88],


         {"collision":true},
         {"selfCollision":true},
         {"group":"G_pickup_D55_tanker_load"},
         {"nodeWeight":"$=90*($loadVolume/7500)+1", "nodeWeightFunction":"=90*($volume/7500)+1","cargoGroup":"TankerUpfit"},
          ["tnkl1",  0.0,    3.3473, 1.4045],
          ["tnkl2",  0.0,    1.8471, 1.4045],
          ["tnkl3",  0.0,    0.4458, 1.4045],
         {"group":""},

    ],
    "rails": {
        "G_pickup_D55_tanker_load_R":{"links:":["tnkl1","tnkl2"], "broken:":[], "looped":false, "capped":true},
        "G_pickup_D55_tanker_load_F":{"links:":["tnkl2","tnkl3"], "broken:":[], "looped":false, "capped":true},
