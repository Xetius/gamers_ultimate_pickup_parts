        //turn signal stalk
        ["turnsignal",   "pickup_signalstalk",   "dshl","dsh","int_strw",      {"x":-105 "y":180, "z":0}, {"x":0, "y":-15, "z":-2},     {"x":0, "y":0, "z":0},   -1, 1, -1, 1, {"baseTranslation":{"x":-0.05,"y":0.045,"z":0.02}}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //interior
         ["pickup_facelift_dash", ["pickup_dash"]],
         //["pickup_facelift_expletivehandle", ["pickup_body"]],
         ["pickup_facelift_gauges", ["pickup_dash"]],
         ["pickup_facelift_decals_gauges", ["pickup_dash"]],
         ["pickup_facelift_intmirror", ["pickup_windshield"]],
         ["pickup_facelift_buttons_front",     ["pickup_dash"], [], {"disable":"$=$components.locker_F ~= true",  "pos":{"x":0.091, "y":-0.0655, "z":-0.114}, "rot":{"x":-3, "y":0, "z":0}}],
         ["pickup_facelift_locker_button_rear",["pickup_dash"], [], {"disable":"$=$components.locker_R ~= true",  "pos":{"x":0.129, "y":-0.0635, "z":-0.078}, "rot":{"x":-3, "y":0, "z":0}}],
         ["G_pickup_facelift_locker_button_int",["pickup_dash"], [], {"disable":"$=$components.locker_I ~= true", "pos":{"x":0.167, "y":-0.0635, "z":-0.078}, "rot":{"x":-3, "y":0, "z":0}}],
