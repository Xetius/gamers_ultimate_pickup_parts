        ["front_lock", "dshl","dsh","int_strw","box",{"x":0.03,"y":0.03,"z":0.02},{"x":30,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.150, "y":-0.035, "z": 0.033}, {"disable":"$=$components.locker_F ~= true"}],
        ["rear_lock",  "dshl","dsh","int_strw","box",{"x":0.03,"y":0.03,"z":0.02},{"x":30,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.112, "y":-0.035, "z": 0.033}, {"disable":"$=$components.locker_R ~= true"}],
        ["int_lock",   "dshl","dsh","int_strw","box",{"x":0.03,"y":0.03,"z":0.02},{"x":30,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.074, "y":-0.035, "z": 0.033}, {"disable":"$=$components.locker_I ~= true"}],
    ],
    "actionsEnabled": [
        ["id"],
        ["hoodRelease"],
        ["basicCruiseCointrol"],
        ["toggleFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["lockFrontDiff",       {"disable":"$=$components.locker_F ~= true"}],
        ["unlockFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["setFrontDiffModeAxis",{"disable":"$=$components.locker_F ~= true"}],
