         ["dsh2",  0.000, -0.716, 1.290],
         {"group":""},
         ["int_pbrk", 0.66, -0.93, 0.86],
         {"group":""},
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int",   "dshl","dsh","b1ll",    "box",{"x":0.04,"y":0.04,"z":0.04},{"x":25,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.230, "y": 0.220, "z":-0.100}],
        ["headlights", "dshl","dsh","int_strw","sphere", 0.025,                   {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.235, "y":-0.025, "z": 0.020}],
        ["cruise",     "dshl","dsh","int_strw","box",{"x":0.03,"y":0.03,"z":0.02},{"x":30,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.240, "y": 0.025, "z": 0.135}],
