        {"nodeWeight":2.35},
        {"beamSpring":846, "beamDamp":94},
        {"selfCollision":true},
        {"collision":true},
        //dash cam
        ["dash", 0.462, 0.1, 1.53, 55, "b1rr","b1ll","b3rr","b3ll","b6rr","b6ll", {"beamDeform":2800560,"beamStrength":"FLT_MAX"}],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator7
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>POL_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>POL_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>FIPA_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>FIPA_Clack"],
        //lights3
        ["LightOn", "event:>Vehicle>Interior>Light>AU5_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>AU5_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Lock"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"b6l"},
    ],
    "props": [
        ["func",         "mesh",                 "idRef:","idX:","idY:", "baseRotation",           "rotation",                  "translation",           "min", "max", "offset", "multiplier"],
        //speedometer
        ["wheelspeed",   "pickup_facelift_needle_speedo", "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-4.15},   {"x":0, "y":0, "z":0},   0, 52, -26.1, 1, {"baseTranslationGlobal":{"x":0.389311,"y":-0.704284,"z":1.21965}}],
        //tachometer
        ["rpm",          "pickup_facelift_needle_tacho",  "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-0.0335}, {"x":0, "y":0, "z":0},   0, 6000, -4000, 1, {"baseTranslationGlobal":{"x":0.518752,"y":-0.704284,"z":1.21965}}],
        //fuel gauge
        ["fuel",         "pickup_facelift_needle_fuel",   "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-70},     {"x":0, "y":0, "z":0},   0, 1, -1, 1, {"baseTranslationGlobal":{"x":0.47669,"y":-0.698762,"z":1.18674}}],
        //water temp
        ["watertemp",    "pickup_facelift_needle_temp",   "dshl","dsh","int_strw",     {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-1},      {"x":0, "y":0, "z":0},   60, 120, -90, 1, {"baseTranslationGlobal":{"x":0.454347,"y":-0.71322,"z":1.26711}}],
        //pedals
        ["brake",        "pickup_facelift_brakepedal",         "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslationGlobal":{"x":0.450401,"y":-0.926146,"z":0.861946}}],
        ["throttle",     "pickup_facelift_gaspedal",           "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-23, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslationGlobal":{"x":0.300421,"y":-0.926057,"z":0.859521}}],
