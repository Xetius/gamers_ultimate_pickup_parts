        ["sunvisor_R_movement","pickup_facelift_sunvisor_R","rf1","rf1r","rf2",{"x":0,"y":0,"z":0},{"x":-170,"y":0,"z":0},{"x":0,"y":0,"z":0},0,1,0,1,{"baseRotationGlobal":{"x": 0.53,"y": 2.01,"z": 3.21}, "baseTranslationGlobal":{"x":-0.547336,"y":-0.320701,"z":1.63921}}],
