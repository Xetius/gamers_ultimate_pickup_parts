{
"G_pickup_interior_D55": {
    "information":{
        "authors":"Gamer!",
        "name":"D55 Dashboard",
        "value":1000,
    },
    "slotType" : "pickup_interior",
    "slots2": [
        ["name",                           "allowTypes",                       "denyTypes", "default",                       "description"],
        ["pickup_sunvisors",               ["pickup_sunvisors"],               [],          "pickup_sunvisors",              "Sunvisors"],
        ["G_pickup_D55_shifter",           ["G_pickup_D55_shifter"],           [],          "G_pickup_D55_shifter_A",        "Shifter"],
        ["pickup_shifter_T",               ["pickup_shifter_T"],               [],          "",                              "Range Selector"],
        ["pickup_steer",                   ["pickup_steer"],                   [],          "pickup_steer",                  "Steering Wheel"],
        ["pickup_interior_accessory",      ["pickup_interior_accessory"],      [],          "",                              "Interior Accessories"],
        ["G_pickup_D55_dash_gauge_M",      ["G_pickup_D55_dash_gauge_M"],      [],          "G_pickup_D55_dash_gauge_M_air", "Air Pressure Gauge"],
        ["G_pickup_D55_airbrakeContols",   ["G_pickup_D55_airbrakeContols"],   [],          "G_pickup_D55_airbrakeContols",  "Airbrake Controls", {"coreSlot":true}],
        ["G_pickup_D55_pto",               ["G_pickup_D55_pto"],               [],          "",                              "PTO Controls"],
        ["G_pickup_D55_fifthwheel_switch", ["G_pickup_D55_fifthwheel_switch"], [],          "",                              "Fifth Wheel Switch"],
        ["pickup_seat_F",                  ["pickup_seat_F"],                  [],          "pickup_seat_F",    "Front Seats"],
    ],
    "camerasInternal":[
        ["type", "x", "y", "z", "fov", "id1:", "id2:", "id3:", "id4:", "id5:", "id6:"],
        {"nodeWeight":2.35},
        {"beamSpring":846, "beamDamp":94},
        {"selfCollision":true},
        {"collision":true},
        //dash cam
        ["dash", 0.462, 0.1, 1.53, 55, "b1rr","b1ll","b3rr","b3ll","b6rr","b6ll", {"beamDeform":2800560,"beamStrength":"FLT_MAX"}],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator7
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>POL_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>POL_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>FIPA_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>FIPA_Clack"],
        //lights3
        ["LightOn", "event:>Vehicle>Interior>Light>AU5_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>AU5_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Lock"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"b6l"},
    ],
    "props": [
        ["func",         "mesh",                      "idRef:","idX:","idY:",        "baseRotation",              "rotation",                  "translation",           "min", "max", "offset", "multiplier"],
        //speedometer
        ["wheelspeed",   "pickup_needle_speedo",      "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0},    {"x":0, "y":0, "z":-4.15},   {"x":0, "y":0, "z":0},   0, 52, -26.1, 1,   {"baseTranslationGlobal":{"x":0.403585, "y":-0.718396,"z":1.17102}}],
        //tachometer
        ["rpm",          "pickup_needle_tacho",       "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0},    {"x":0, "y":0, "z":-0.0305}, {"x":0, "y":0, "z":0},   0, 6000, -3950, 1, {"baseTranslationGlobal":{"x":0.536137, "y":-0.718396,"z":1.17102}}],
        //fuel gauge
        ["fuel",         "pickup_needle_fuel",        "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0},    {"x":0, "y":0, "z":-70},     {"x":0, "y":0, "z":0},   0, 1, -1, 1,       {"baseTranslationGlobal":{"x":0.489824, "y":-0.710245,"z":1.12528}}],
        //water temp
        ["watertemp",    "pickup_needle_water",       "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0},    {"x":0, "y":0, "z":1.5},     {"x":0, "y":0, "z":0},   60, 120, 90, 1,    {"baseTranslationGlobal":{"x":0.321256, "y":-0.726701,"z":1.21749}}],
        //oil temp
        ["oiltemp",      "pickup_needle_oil",         "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0},    {"x":0, "y":0, "z":1.5},     {"x":0, "y":0, "z":0},   60, 120, 90, 1,    {"baseTranslationGlobal":{"x":0.321256, "y":-0.716789,"z":1.16187}}],
        //pedals
        ["brake",        "pickup_pedal_brake",        "b1l","b1r","b5l",             {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1,        {"baseTranslationGlobal":{"x":0.457551, "y":-0.956836,"z":0.890531}}],
        ["throttle",     "pickup_pedal_gas",          "b1l","b1r","b5l",             {"x":154, "y":180, "z":0},   {"x":-23, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1,        {"baseTranslationGlobal":{"x":0.341552, "y":-0.956247,"z":0.890695}}],
        //turn signal stalk
        ["turnsignal",   "pickup_signalstalk",        "dshl","dsh","int_strw",       {"x":-105 "y":180, "z":0},   {"x":0, "y":-15, "z":-2},     {"x":0, "y":0, "z":0},  -1, 1, -1, 1,      {"baseTranslation":{"x":-0.05,"y":0.1,"z":0.0}}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //interior
         ["G_pickup_D55_dash", ["pickup_dash"]],
         ["pickup_gauges", ["pickup_dash"]],
         ["pickup_decals_gauges", ["pickup_dash"]],
         ["pickup_intmirror", ["pickup_windshield"]],
         ["pickup_locker_button_front", ["pickup_dash"], [], {"disable":"$=$components.locker_F ~= true"}],
         ["pickup_locker_button_rear",  ["pickup_dash"], [], {"disable":"$=$components.locker_R ~= true"}],
         ["G_pickup_locker_button_int",  ["pickup_dash"], [], {"disable":"$=$components.locker_I ~= true", "pos":{"x":-0.018, "y":0.0, "z":0.0}}],
         ["G_pickup_intcarpet_D55", ["pickup_body"]],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["pickup_facelift_intmirror","rf1","rfc1r","rf2",{"refBaseTranslation":{"x":0.0,"y":-0.090,"z":-0.140},"baseRotationGlobal":{"x":0,"y":0,"z":19}, "optional":true}],
    ],
    "controller": [
        ["fileName"],
        ["gauges/analogOdometer", {"name":"analogOdometer" }],
    ],
    "analogOdometer": {
        "configuration": {
            "materialName": "@generic_gauges_odo",
            "htmlPath": "local://local/vehicles/common/analogOdo.html",
            "displayWidth":512,
            "displayHeight":32,
            "odometerDigits":7,
            "odometerHasDecimalSeparator":true,
            "tripHasDecimalSeparator":true,
            "unit":"imperial",
            "floatStyle":{"color":"black"},
            "bodyStyle":{
                "background": "url('/vehicles/common/odometer_analog_b.cef_color.png')",
                "font-family": "OpenSans",
                "font-size": "28px",
                "color": "white",
                "letter-spacing": "15.5px",
                "margin": "-4.5px 10.5px",
                "transform": "scaleX(1.26)",
                "transform-origin": "left",
            },
            "tripDivStyle":{
                "margin-left": "-3px",
                "position": "fixed",
                "letter-spacing": "32px"
            }
        },
    },
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int",      "dshl","dsh","b1ll",    "box", {"x":0.04, "y":0.04, "z":0.04}, {"x":25, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.230, "y": 0.220, "z":-0.100}],
        ["front_lock",    "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.185, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_F ~= true"}],
        ["rear_lock",     "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.165, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_R ~= true"}],
        ["int_lock",      "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.145, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_I ~= true"}],
        ["foglights",     "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.135, "y":-0.050, "z": 0.010}],
        ["headlights",    "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.155, "y":-0.050, "z": 0.010}],
        ["cruise",        "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.115, "y":-0.050, "z": 0.010}],
        ["sw_ignition",   "dshl","dsh","int_strw","sphere", 0.025,                       {"x":0,  "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.060, "y": 0.058, "z": 0.011}],
    ],
    "actionsEnabled": [
        ["id"],
        ["hoodRelease"],
        ["basicCruiseCointrol"],
        ["toggleFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["lockFrontDiff",       {"disable":"$=$components.locker_F ~= true"}],
        ["unlockFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["setFrontDiffModeAxis",{"disable":"$=$components.locker_F ~= true"}],
