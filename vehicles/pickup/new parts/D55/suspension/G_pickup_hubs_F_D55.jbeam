          ["fh1r","fw1r"],
          ["fh1r","fw1rr"],

          {"breakGroup":"wheel_FL"},
          ["fh4l","fw1ll", {"name":"axle_FL","beamSpring":6110940,"beamDamp":47}],
          ["fh4l","fw1l", {"beamSpring":5110940,"beamDamp":47}],
          ["fh5l","fw1l", {"beamSpring":12160940,"beamDamp":37.6}],
          ["fw1l","fh2l"],
          ["fw1l","fh3l"],
          ["fw1ll","fh2l"],
