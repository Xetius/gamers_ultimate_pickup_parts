{
"G_pickup_brake_F_D55": {
    "information":{
        "authors":"Gamer!",
        "name":"D55 Front Disc Brakes",
        "value":600,
    },
    "slotType" : "G_pickup_brake_F_D55",
    "slots": [
        ["type", "default", "description"],
        ["brakepad_F","brakepad_F_premium", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //brake discs
        ["brake_disc_plain", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":-0.86,"y":-1.463, "z":0.36}, "scale":{"x":1.6,"y":1.22,"z":1.22}, "rot":{"x":0,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_FR"]]}],
        ["brake_disc_plain", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":0.86,"y":-1.463, "z":0.36}, "scale":{"x":1.6,"y":1.22,"z":1.22}, "rot":{"x":180,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_FL"]]}],
        ["brake_caliper_4pot_plain", ["pickup_hub_F","wheelhub_FR"], [], {"pos":{"x":-0.86,"y":-1.463, "z":0.36}, "scale":{"x":1.6,"y":1.08,"z":1.08}, "rot":{"x":180,"y":0,"z":0}}],
        ["brake_caliper_4pot_plain", ["pickup_hub_F","wheelhub_FL"], [], {"pos":{"x":0.86,"y":-1.463, "z":0.36}, "scale":{"x":1.6,"y":1.08,"z":1.08}, "rot":{"x":180,"y":180,"z":0}}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*4500"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":135},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.390},
        {"brakeMass":16},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1},

        //hub
        //general settings
        {"hubRadius":0.165},
        {"wheelOffset":0.0},
        {"hubWidth":0.05},
        {"numRays":5},

        //hub options
        {"hubTreadBeamSpring":1128940, "hubTreadBeamDamp":5.64},
        {"hubPeripheryBeamSpring":1128940, "hubPeripheryBeamDamp":5.64},
        {"hubSideBeamSpring":2256940, "hubSideBeamDamp":5.64},
        {"hubNodeWeight":0.7},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":45500, "hubBeamStrength":87500},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.5}
    ],
},
