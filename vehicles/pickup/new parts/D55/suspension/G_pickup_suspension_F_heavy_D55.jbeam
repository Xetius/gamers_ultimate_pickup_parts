            ["st1", "fx1r"],

            ["st2", "f13l"],
            ["st2", "f11l"],
            ["st2", "f1l"],
            ["st2", "f3l"],
            ["st2", "fx1l"],
            ["st2", "fx1r"],

            ["st1", "f1r"],
            ["st2", "f3r"],
            ["st1", "f3r"],
            ["st2", "f1r"],

            {"beamSpring":20001000,"beamDamp":200},
            {"beamDeform":120400,"beamStrength":311500},
            //tie rod
            //toe in meters of tie rod length change, with small offset for default position
            ["fh1r","fh1l", {"breakGroup":"tierod","precompressionRange":"$=$toe_F2-0.0012","beamPrecompressionTime":0.5}],
            //drag link
            {"beamSpring":18001000,"beamDamp":200},
            //adds toe change portion to steering center to prevent too much shift in steering
            ["st4","fh1r", {"breakGroup":"tierod","precompressionRange":"$=$steer_center_F2+$toe_F2*0.5-0.0005+$components.steering.springlift-0.007","beamPrecompressionTime":0.5}],
            ["st3","st4", {"precompressionRange":"$=$springheight_F*0.000005-0.000004","beamPrecompressionTime":0.5}],
            //steering damper
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
            {"beamSpring":0,"beamDeform":58800,"beamStrength":104664},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            {"beamDamp":200},
            ["fh1r","fax4", {"beamDampVelocitySplit":0.015,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh1l","fax4", {"beamDampVelocitySplit":0.015,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh4r","fax2", {"beamDampVelocitySplit":0.015,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh4l","fax2", {"beamDampVelocitySplit":0.015,"beamDampFast":8000,"dampCutoffHz":1200}],

            //drag link limiter for when tie rod breaks
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":0.6, "beamShortBound":0.6},
            {"beamSpring":0,"beamDamp":47,"beamDeform":10500,"beamStrength":105000},
            {"beamLimitSpring":1501000,"beamLimitDamp":50},
            ["st4", "f13r"],
            ["st4", "f12r"],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"triangleType":"NONCOLLIDABLE"},
            //steering anti clip
            ["st4", "fax2", "st3"],
            ["st1", "st2", "st3"],
            {"triangleType":"NORMALTYPE"},
    ],
    "torsionHydros": [
        ["id1:","id2:","id3:","id4:"],
        {"spring":400000, "damp":10, "deform":"FLT_MAX", "strength":"FLT_MAX"},
        ["st3","st1","st2","f3l", {"factor":"$=$steer_angle_max","steeringWheelLock":720,"inRate":5,"outRate":5,"inputSource":"steering_input"}],
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*1.8",
    },
},
}