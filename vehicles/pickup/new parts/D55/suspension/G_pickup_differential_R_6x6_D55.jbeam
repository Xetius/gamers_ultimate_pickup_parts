"G_pickup_differential_R_6x6_D55_locking": {
    "information":{
        "authors":"Gamer!",
        "name":"Locking Rear Differential",
        "value":1600,
    },
    "slotType" : "G_pickup_differential_R_6x6_D55",
    "slots": [
        ["type", "default", "description"],
        //["pickup_driveshaft_R","pickup_driveshaft_R","Rear Driveshaft"],
        ["pickup_finaldrive_R","G_pickup_finaldrive_R_486", "Rear Final Drive", {"coreSlot":true}],
    ],
    "components":{
        "locker_R":true,
    },
    "controller": [
        ["fileName"],
        ["driveModes", {"name":"rearLockControl"}]
    ],
    "rearLockControl":{
        "uiName": "Rear Differential"
        "quickAccessTitle":"Rear Differential"
        "quickAccessIcon":"differentialRearDefault"
        "quickAccessLevel":"/vehicleFeatures/"
        "enabledModes":["unlocked", "locked"]
        "defaultMode": "unlocked"
        "modes": {
            "unlocked": {
                "name": "Unlocked",
                "order": 10,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"differential_R", "mode":"open"}]
                    ["powertrainDeviceMode", {"deviceName":"differential_RR_6x6", "mode":"open"}]
                    ["electricsValue", {"electricsName":"rear_lock", "value":0}]
                    ["quickAccess", {"icon":"differentialRearDefault"}]
                    ["simpleControlButton", {"buttonId":"rearDiff", "icon":"powertrain_differential_open", "uiName":"Rear Differential"}]
                ],
            },
            "locked": {
                "name": "Locked",
                "order": 20,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"differential_R", "mode":"locked"}]
                    ["powertrainDeviceMode", {"deviceName":"differential_RR_6x6", "mode":"locked"}]
                    ["electricsValue", {"electricsName":"rear_lock", "value":1}]
                    ["quickAccess", {"icon":"differentialRearLocked"}]
                    ["simpleControlButton", {"buttonId":"rearDiff", "icon":"powertrain_differential_closed", "uiName":"Rear Differential"}]
                ],
            },
        }
    }
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //rear diff
        ["shaft", "driveshaft_R_intern", "differential_interaxle", 1, {"uiName":"Rear Intern Driveshaft"}],
        ["differential", "differential_R", "driveshaft_R_intern", 1, {"uiSimpleModeControl":false, "diffType":["open","locked"], "lockTorque":20000, "uiName":"Rear Differential","defaultVirtualInertia":0.5}],
    ],
    "differential_R": {
        "friction": 6.6,
        "dynamicFriction": 0.00311,
        "torqueLossCoef": 0.03,
    },
},
}