        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F2", "range", "", "Wheel Alignment", 0, 0.01, -0.01, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F2", "range", "", "Wheel Alignment", 0.0006, -0.015, 0.015, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"nodeWeight":5.5},
         ["st1", 0.337, -1.55, 0.63, {"group":["pickup_pitman"]}],
         ["st2", 0.337, -1.46, 0.49, {"group":["pickup_pitman"]}],
         ["st3", 0.337, -1.63, 0.4, {"group":["pickup_pitman","pickup_link_SFA"]}],
         {"group":"pickup_tierod_F"},
         //tie rod
         ["st4",-0.34, -1.63, 0.39],
         {"group":""},
    ],
    "rails": {
        "steeringrack":{
            "links:":["fh1r","fh1l"], "broken:":[], "looped":false, "capped":true,
        },
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["st4", "steeringrack", true, true, 0.0, 16001000, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
            ["id1:","id2:"],
            {"beamSpring":11280940,"beamDamp":141,"beamDeform":118750,"beamStrength":155750},
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
            ["st1","st2"],
            ["st2","st3"],
            ["st1","st3"],

            {"beamSpring":8640940,"beamDamp":450,"beamDeform":385000,"beamStrength":155750},
            ["st1", "f13l"],
            ["st1", "f12l"],
            ["st1", "f2l"],
            ["st1", "f3l"],
            ["st1", "fx1l"],
            ["st1", "fx1r"],

            ["st2", "f13l"],
            ["st2", "f12l"],
            ["st2", "f2l"],
            ["st2", "f3l"],
            ["st2", "fx1l"],
            ["st2", "fx1r"],

            ["st1", "f2r"],
            ["st2", "f3r"],
            ["st1", "f3r"],
            ["st2", "f2r"],

            {"beamSpring":20001000,"beamDamp":241},
            {"beamDeform":255400,"beamStrength":311500},
            //tie rod
            //toe in meters of tie rod length change, with small offset for default position
            ["fh1r","fh1l", {"breakGroup":"tierod","precompressionRange":"$=$toe_F2-0.0012","beamPrecompressionTime":0.5}],
            //drag link
            {"beamSpring":18001000,"beamDamp":141},
            //adds toe change portion to steering center to prevent too much shift in steering
            ["st4","fh1r", {"breakGroup":"tierod","precompressionRange":"$=$steer_center_F2+$toe_F2*0.5-0.0005+$components.steering.springlift","beamPrecompressionTime":0.5}],
            //["st4","fh1l", {"breakGroup":"tierod","precompressionRange":"$=$steer_center_F2+$toe_F2*0.5-0.0005","beamPrecompressionTime":0.5}],
            ["st3","st4", {"precompressionRange":"$=1.0*$springheight_F*0.115","beamPrecompressionTime":0.5}],
            //steering damper
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
            {"beamSpring":0,"beamDeform":58800,"beamStrength":104664},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            {"beamDamp":250},
            ["fh1r","fax4", {"beamDampVelocitySplit":0.02,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh1l","fax4", {"beamDampVelocitySplit":0.02,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh4r","fax2", {"beamDampVelocitySplit":0.02,"beamDampFast":8000,"dampCutoffHz":1200}],
            ["fh4l","fax2", {"beamDampVelocitySplit":0.02,"beamDampFast":8000,"dampCutoffHz":1200}],

            //drag link limiter for when tie rod breaks
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":0.6, "beamShortBound":0.6},
            {"beamSpring":0,"beamDamp":47,"beamDeform":10500,"beamStrength":105000},
            {"beamLimitSpring":1501000,"beamLimitDamp":50},
