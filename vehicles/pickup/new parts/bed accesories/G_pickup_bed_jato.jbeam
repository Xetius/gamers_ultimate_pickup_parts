"G_pickup_bed_jato_customizable": {
    "information":{
        "authors":"Gamer!",
        "name":"Customizable JATO Liquid Fuel Rocket",
        "value":40000,
    },
    "slotType" : "pickup_tailgate",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
        ["jato",               ["us_semi_jato"], [], {"pos":{"x":0,"y":2.4228,"z":0.8478}}],
        ["jato_nozzle",        ["us_semi_jato"], [], {"pos":{"x":0,"y":2.4228,"z":0.8478}, "nodeRotate1":{"x":"$jatoAngle","y":0,"z":0,"px":0,"py":2.4228,"pz":0.8478}}],
        ["jato_shockdiamonds", ["us_semi_jato"], [], {"pos":{"x":0,"y":2.4228,"z":0.8478}, "nodeRotate1":{"x":"$jatoAngle","y":0,"z":0,"px":0,"py":2.4228,"pz":0.8478}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$jato_factor", "range", "%", "JATO Rockets", 100, 5, 400, "Jato Strength", "Tune the strength of propulsion" {"stepDis":5}],
        ["$jatoAngle", "range", "degrees", "JATO Rockets", 5, -45, 45, "Nozzle Vertical Angle",  "Adjusts the boost direction", {"stepDis":1}],
    ],
    "glowMap":{
        "shockdiamonds": {"simpleFunction":"jato", "off":"invis", "on":"shockdiamonds_glow"},
    },
    "controller": [
        ["fileName"],
        ["jato"],
    ],
    "jato":{
        "thrusterNodes:":["jt5", "jt6"],
        "fuel": 600,
    },
    "actionsEnabled": [
        ["id"],
        ["jato"],
    ],
    "thrusters": [
        ["id1:", "id2:", "factor", "thrustLimit", "control"],
        ["jt5", "jt6", "$=300*$jato_factor", "$=300*$jato_factor", "jato"],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
