"G_pickup_transfer_case_RWD_rangebox": {
    "information":{
        "authors":"Gamer!",
        "name":"RWD Transfer Case With Rangebox",
        "value":1700,
    },
    "slotType" : "pickup_transfer_case",
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["rangeBox", "rangebox", "gearbox", 1, {"uiSimpleModeControl":false, "gearRatios":[1,4], "uiName":"Rangebox"}],
        //straight through shaft
        ["shaft", "transfercase", "rangebox", 1, {"friction":0.32, "dynamicFriction":0.000354, "uiName":"Rear Output Shaft"}],
    ],
    "controller": [
        ["fileName"],
        ["driveModes", {"name":"transfercaseControl"}]
        ["4wd", {"driveModesTransfercaseNames":["transfercaseControl"], "driveModesRangeNames":["transfercaseControl"]}]
    ],

    "transfercaseControl":{
        "uiName": "Transfercase"
        "quickAccessTitle":"Transfercase"
        "quickAccessIcon":"radial_highrangebox"
        "quickAccessLevel":"/powertrain/"
        "enabledModes":["2hi", "2lo"]
        "defaultMode": "2hi"
        "modes": {
            "2hi": {
                "name": "2WD High Gear",
                "order": 10,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"rangebox", "mode":"high"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFR", "mode":"disconnected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFL", "mode":"disconnected"}]
                    ["electricsValue", {"electricsName":"transfercase_state", "value":1}]
                    ["simpleControlButton", {"buttonId":"transfercase", "icon":"powertrain_transfercase_high-2", "uiName":"Transfercase"}]
                    ["quickAccess", {"icon":"powertrain_transfercase_high-2"}]
                ],
            },
            "2lo": {
                "name": "2WD Low Gear",
                "order": 30,
                "settings": [
                    ["type"]
                    ["powertrainDeviceMode", {"deviceName":"rangebox", "mode":"low"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFR", "mode":"disconnected"}]
                    ["powertrainDeviceMode", {"deviceName":"wheelaxleFL", "mode":"disconnected"}]
                    ["electricsValue", {"electricsName":"transfercase_state", "value":-1}]
                    ["simpleControlButton", {"buttonId":"transfercase", "icon":"powertrain_transfercase_low-2", "uiName":"Transfercase"}]
                    ["quickAccess", {"icon":"powertrain_transfercase_low-2"}]
                ],
            },
        }
    }
    "gearbox": {
        "uiName":"Gearbox",
        //added stabilization for one way clutch with ultra low range
        "oneWayViscousCoef":20,
        "oneWayViscousSmoothing":100,
    },
    "torqueConverter": {
        "uiName":"Torque Converter",
        //added stabilization for torque converter with ultra low range
        "kFactorSmoothing":250,
    },
},
"G_pickup_transfer_case_FWD": {
    "information":{
        "authors":"Gamer!",
        "name":"FWD Transfer Case",
        "value":650,
    },
    "slotType" : "pickup_transfer_case",
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //welded center diff
        ["differential", "transfercase_fwd", "gearbox", 1, {"diffType":"locked", "lockTorque":10000, "uiName":"Rear Differential","defaultVirtualInertia":0.5}],
        //non disconnecting front shaft
        ["shaft", "transfercase_F", "transfercase_fwd", 2, {"friction":0.44, "dynamicFriction":0.00048, "uiName":"Front Output Shaft"}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["pickup_transfer_case", ["pickup_transmission","pickup_engine"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":18},
         {"group":"pickup_transmission"},
         ["tra2", -0.12, -0.78, 0.425],
         ["tra3", 0.18, -0.78, 0.425],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":12600840,"beamDamp":390},
          {"beamDeform":99750,"beamStrength":"FLT_MAX"},
          ["tra2","tra1"],

          ["tra2","e1r"],
          ["tra2","e1l"],
          ["tra2","e3r"],
          ["tra2","e3l"],

          ["tra3","e1r"],
          ["tra3","e1l"],
          ["tra3","e3r"],
          ["tra3","e3l"],

          ["tra3","tra2"],
          ["tra3","tra1"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
"pickup_shifter_M_4": {
    "information":{
        "authors":"Gamer!",
        "name":"4-Speed Manual Shifter",
        "value":50,
    },
    "slotType" : "pickup_shifter",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //cover up the auto shifter numbering
         ["pickup_gauges_cover_M", ["pickup_body", "pickup_dash"]],
         ["pickup_shifter_M_alt", ["pickup_floor","pickup_shifterboot_M","pickup_shifterknob_M","pickup_shifterbase_M"]],
    ],
    "props": [
        ["func",   "mesh",             "idRef:","idX:","idY:", "baseRotation",         "rotation",            "translation",         "min", "max", "offset", "multiplier"],
        //shifter
        ["clutch", "pickup_pedal_clutch"   , "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
    ],
    "controller": [
        ["fileName"],
        ["propAnimation/hPattern", {"name":"hPattern"}],

    ]
    "hPattern": {
        "gearCoordinates": [
            ["gearIndex",   "x",      "y"]
            [-1,            0.5,        1]
            [0,             0.0,        0]
            [1,            -0.5,        1]
            [2,            -0.5,       -1]
            [3,             0.0,        1]
            [4,             0.0,       -1]
        ]
        "shiftSoundNode:":["sh_b3"]
        "shiftSoundEventHPatternGearIn": "event:>Vehicle>Interior>Gearshift>manual_modern_10_in",
        "shiftSoundEventHPatternGearOut": "event:>Vehicle>Interior>Gearshift>manual_modern_10_out",
        "shiftSoundVolumeHPatternGearIn": 0.5,
        "shiftSoundVolumeHPatternGearOut": 0.5,
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         //--SHIFTER---  has to be jbeamed to allow for realistic movement
         {"group":"pickup_shifterbase_M"},
         {"nodeWeight":0.45}
         ["sh_b1l",  0.076, -0.870, 0.688],
         ["sh_b1r", -0.076, -0.870, 0.688],
         ["sh_b2l",  0.076, -0.702, 0.632],
         ["sh_b2r", -0.076, -0.702, 0.632],

         ["sh_b3", 0.00, -0.80, 0.607],
         {"selfCollision":true},
         {"group":["pickup_shifterboot_M","pickup_shifterknob_M"]},
         {"nodeWeight":1.5}
         ["sh_l3", 0.00, -0.665, 0.86],

         {"selfCollision":false},
         {"nodeWeight":0.30}
         {"group":["pickup_shifterboot_M","pickup_shifterknob_M"]},
         ["sh_l1l",  0.032, -0.799 0.749],
         ["sh_l1r", -0.032, -0.799 0.749],
         ["sh_l2l",  0.032, -0.723, 0.723],
