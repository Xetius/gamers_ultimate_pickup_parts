{
"G_pickup_engine_v12_9.2": {
    "information":{
        "authors":"Gamer!",
        "name":"9.2L V12 Engine",
        "value":15500,
    },
    "slotType" : "pickup_engine",
    "slots": [
        ["type", "default","description"],
        ["pickup_enginemounts","pickup_enginemounts_heavy", "Engine Mounts", {"coreSlot":true}],
