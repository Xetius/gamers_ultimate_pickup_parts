{
"G_pickup_intake_v12_turbo_prefacelift": {
    "information":{
        "authors":"Gamer",
        "name":"Early Turbocharger",
        "value":420,
    },
    "slotType" : "G_pickup_intake_v12",
    "slots": [
        ["type", "default","description"],
        ["pickup_exhaust_v8_diesel","pickup_exhaust_v8_diesel","Exhaust"],
    ],
    "turbocharger": {
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_semi_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo>Spin>turbo_spin_11",
        "bovEnabled":false,
        "turboSizeCoef": 0.0,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.1,
        "whineVolumePer10kRPM": 0.03,
        "whinePitchPer10kRPM": 0.06,
        "wastegateStart":5.5,
        "wastegateLimit":6.3,
        "maxExhaustPower": 20000,
        "backPressureCoef": 0.00008,
        "frictionCoef": 100,
        "inertia":8,
        "damageThresholdTemperature": 750,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,       0],
            [25000,   3],
            [50000,   5],
            [100000,  8],
            [150000, 12],
            [200000, 16],
            [250000, 20],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.01,  0.01],
            [250,   0.62,  0.42],
            [500,   0.75,  0.65],
            [800,   0.78,  0.73],
            [1100,  0.81,  0.76],
            [1400,  0.83,  0.81],
            [2000,  0.82,  0.82],
            [2500,  0.81,  0.77],
            [3000,  0.75,  0.72],
            [3500,  0.71,  0.66],
            [4000,  0.64,  0.60],
            [5000,  0.61,  0.40],
            [6000,  0.56,  0.24],
            [7000,  0.48,  0.11],
        ],
    },
    "mainEngine": {
        //turbocharger name
        "turbocharger":"turbocharger",

        //damage deformGroups
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler"]
    },
    "soundConfig": {
        "$+mainGain":1,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_gavril_v12_turbocharger", ["pickup_engine", "pickup_exmanifold", "pickup_engine_intake", "pickup_airbox"], [], {"pos":{"x":0, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
        ["G_pickup_v12_intake_stock_belts", ["pickup_engine", "pickup_exmanifold", "pickup_engine_intake", "pickup_airbox"], [], {"pos":{"x":0, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         //--Stock Intake
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":3.76},
         {"group":["pickup_engine_intake"]},
         ["turbo", 0.0, -1.3, 1.1],
         {"group":["pickup_airbox"]},
         {"nodeWeight":1.88},
         ["intake2", 0.6, -1.94, 1.04, {"selfCollision":true}],
         {"engineGroup":""},
         {"nodeWeight":3},
         ["interc", 0.0, -1.84, 0.9],
         {"group":"pickup_exmanifold"},
         //exhaust manifold
         ["exm1r", -0.3, -0.7, 0.43, {"nodeWeight":6, "afterFireAudioCoef":1.0, "afterFireVisualCoef":1.0, "afterFireVolumeCoef":1.0, "afterFireMufflingCoef":1.0, "exhaustAudioMufflingCoef":1.0, "exhaustAudioGainChange":0}],
         {"selfCollision":true},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //turbo
          {"beamSpring":2750550,"beamDamp":125},
          {"beamDeform":30000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          {"deformGroup":"mainEngine_turbo", "deformationTriggerRatio":0.001}
          ["turbo","e1r"],
          ["turbo","e2r"],
          ["turbo","e3r"],
          ["turbo","e4r"],
          ["turbo","e1l"],
          ["turbo","e2l"],
          ["turbo","e3l"],
          ["turbo","e4l"],

          //intercooler
          {"beamSpring":870369.5,"beamDamp":130.43},
          {"beamDeform":6300,"beamStrength":"FLT_MAX"},
          {"deformGroup":"mainEngine_intercooler","deformationTriggerRatio":0.05},
          ["interc","e1r"],
          ["interc","e2r"],
          ["interc","e3r"],
          ["interc","e4r"],
          ["interc","e1l"],
          ["interc","e2l"],
          ["interc","e3l"],
          ["interc","e4l"],
          {"deformGroup":""}

          //intake
          {"beamSpring":1880940,"beamDamp":235},
          {"beamDeform":105000,"beamStrength":"FLT_MAX"},
          //{"deformGroup":"mainEngine_intake", "deformationTriggerRatio":0.01}

          {"beamSpring":120940,"beamDamp":141},
          {"beamDeform":6150,"beamStrength":"FLT_MAX"},
          ["intake2", "e4l"],
          ["intake2", "e3l"],
          ["intake2", "e2l"],
          ["intake2", "e1l"],
          ["intake2", "e4r"],
          {"optional":true},
          {"beamDeform":9150,"beamStrength":9900},
          ["intake2", "s2l"],
          ["intake2", "s2ll"],
          ["intake2", "s1l"],
          ["intake2", "s1ll"],
          {"deformGroup":""}
          {"optional":false},

          //exhaust manifold
          {"beamSpring":11163370,"beamDamp":130.43},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},
          ["exm1r","e3l"],
          ["exm1r","e3r"],
          ["exm1r","e4l"],
          ["exm1r","e4r"],
          ["exm1r", "e1r"],
          ["exm1r", "e1l"],
          ["exm1r", "e2l"],
          ["e2r", "exm1r", {"isExhaust":"mainEngine"}],

          //mesh break beams
          {"beamPrecompression":0.8, "beamType":"|SUPPORT","beamLongBound":0.8},
          {"beamSpring":9400,"beamDamp":0},
          {"beamDeform":350,"beamStrength":700},
          ["turbo", "intake2"],
          ["intake2", "e4l"],
          {"deformGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
