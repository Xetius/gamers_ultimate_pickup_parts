         ["auc1",0.0, 0.41, 1.76],
         ["auc1l",0.68, 0.41, 1.73],

         ["auc2r",-0.68, 1.06, 1.73],
         ["auc2",0.0, 1.06, 1.76],
         ["auc2l",0.68, 1.06, 1.73],

         {"group":"pickup_aux_sportbar_R"},
