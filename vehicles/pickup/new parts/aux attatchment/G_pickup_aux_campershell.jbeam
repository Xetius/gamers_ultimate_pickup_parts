{
"G_pickup_aux_campershell_color": {
    "information":{
        "authors":"Gamer!",
        "name":"Cab Extension (Body Colored)",
        "value":800,
    },
    "slotType" : "G_pickup_aux_roof",
    "slots": [
        ["type", "default", "description"],
        ["G_pickup_aux_sportbar_lettering","G_pickup_aux_sportbar_lettering","Lettering"],
        ["G_pickup_aux_campershell_mesh","","Rear Mesh Cover"],
        ["G_pickup_aux_campershell_chmsl","","Center High Mounted Stop Light"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_aux_campershell_color", ["pickup_aux_sportbar"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_aux_campershell_color_R", ["pickup_aux_sportbar_R"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_aux_campershell_color_L", ["pickup_aux_sportbar_L"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_aux_campershell_seam", ["pickup_aux_sportbar"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         {"deformGroup":"aux_campershell_support","deformMaterialBase":"us_semi_common","deformMaterialDamaged":"invis"},
         ["G_pickup_aux_campershell_support_R_alt", ["G_pickup_aux_support_bigspare"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_aux_campershell_support_R", ["G_pickup_aux_support_regular"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_aux_campershell_support_L", ["G_pickup_aux_support"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
         {"deformGroup":""},
         ["G_pickup_aux_campershell_support_F", ["pickup_body"], [], {"pos":{"x": 0.0, "y":0.0, "z":0.0}}],
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"auxCoverCoupler_R"}],
        ["advancedCouplerControl", {"name":"auxCoverCoupler_L"}],
    ]
    "auxCoverCoupler_R":{
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["aucd3r",      "auc3r",       20000,                     0.015,                  0.005,                      0.2,                 0.1,                   "auxCoverLatch_R_break", {"forceCid1":"aucd3r", "forceCid2":"aucd1rr"}]
        ]
        "groupType": "autoCoupling",
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["aucd3r"]
        "attachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_open",
        "breakSoundEvent":""
        "openForceMagnitude": 20,
        "openForceDuration": 0.2,
        "closeForceMagnitude": 190,
        "closeForceDuration": 1.2
    }
    "auxCoverCoupler_L":{
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["auc3l",      "aucd3l",       20000,                     0.015,                  0.005,                      0.2,                 0.1,                   "auxCoverLatch_L_break", {"forceCid1":"aucd3l", "forceCid2":"aucd1ll"}]
        ]
        "groupType": "autoCoupling",
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["aucd3l"]
        "attachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Special>bedcover_open",
        "breakSoundEvent":""
        "openForceMagnitude": 20,
        "openForceDuration": 0.2,
        "closeForceMagnitude": 190,
        "closeForceDuration": 1.2
    }
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["auxCoverR", "", "aucd2rr","aucd2r","aucd1rr", "box", {"x":0.05, "y":0.05, "z":0.15}, {"x":0, "y":-6, "z":15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0.25, "z":-0.03}, {"deformGroup":"pickup_aux_bedcover_R"}],
        ["auxCoverL", "", "aucd2ll","aucd2l","aucd1ll", "box", {"x":0.05, "y":0.05, "z":0.15}, {"x":0, "y":-6, "z":-15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0.25, "z":-0.02}, {"deformGroup":"pickup_aux_bedcover_L"}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["auxCoverR", "action0", "auxCoverLatch_R"]
        ["auxCoverL", "action0", "auxCoverLatch_L"]
    ],
    "events":[
        ["id", "title", "desc"],
        ["auxCoverLatch_R", "Toggle Right Cover Panel", "ui.inputActions.pickup.bedCoverLatch.description", {"onUp":"controller.getControllerSafe('auxCoverCoupler_R').toggleGroupConditional({{'rollcage_doorlock_2','attached','Unable to open with current setup'}})"}],
        ["auxCoverLatch_L", "Toggle Left Cover Panel", "ui.inputActions.pickup.bedCoverLatch.description", {"onUp":"controller.getControllerSafe('auxCoverCoupler_L').toggleGroupConditional({{'rollcage_doorlock_2','attached','Unable to open with current setup'}})"}],
        ["auxLatch_R", "Toggle Right Toolbox", "ui.inputActions.pickup.doorLatch_R.description", {"onUp":"controller.getControllerSafe('auxRCoupler').toggleGroupConditional({{'auxCoverCoupler_R','attached','vehicle.advancedCouplerControl.openOtherSideFirst'}})"}],
        ["auxLatch_L", "Toggle Left Toolbox", "ui.inputActions.pickup.doorLatch_L.description", {"onUp":"controller.getControllerSafe('auxLCoupler').toggleGroupConditional({{'auxCoverCoupler_L','attached','vehicle.advancedCouplerControl.openOtherSideFirst'}})"}],

    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":0.6},
         {"group":"pickup_aux_sportbar"},
