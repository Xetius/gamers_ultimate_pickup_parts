{
"G_pickup_goliath_hydro_steering_RR_6x6": {
    "information":{
        "authors":"Gamer!",
        "name":"Hydraulic Rear Rear Steering",
        "value":1900,
    },
    "slotType" : "G_pickup_goliath_steering_RR_6x6",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_pickup_goliath_hydro_steering_ram_R", ["pickup_steeringrack_hydro_RR"],[],{"pos":{"x":0.0,"y":1.05,"z":0}}],
        ["G_pickup_goliath_hydro_steering_frame_R", ["pickup_axle_RR"],[],{"pos":{"x":0.0,"y":1.05,"z":0}}],
        ["G_pickup_goliath_hydro_steering_tierod_RR", ["pickup_tierod_RRR","pickup_tierod_RR_6x6"],[],{"pos":{"x":0.0,"y":1.05,"z":0}}],
        ["G_pickup_goliath_hydro_steering_tierod_RL", ["pickup_tierod_RRL","pickup_tierod_RR_6x6"],[],{"pos":{"x":0.0,"y":1.05,"z":0}}],
    ],
    //steering rack rail
    "rails": {
        "steeringrack_main_RR":{"links:":["rstg1r", "rstg1l"], "broken:":[], "looped":false, "capped":true},
        "steeringrack_extra_RR":{"links:":["rstg3r", "rstg3l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["rstg2r", "steeringrack_main_RR", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["rstg2l", "steeringrack_main_RR", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
        ["rstg4r", "steeringrack_extra_RR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
        ["rstg4l", "steeringrack_extra_RR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_RRR", "range", "", "Wheel Alignment", 0.999, 1.1, 0.9, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear Rear"}],
        ["$steer_center_RR", "range", "", "Wheel Alignment", 0.003, -0.01, 0.01, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Rear Rear"}]
        ["$steer_angle_RR", "range", "", "Suspension", 0.075, -0.15, 0.15, "Maximum Steering Angle", "percentage of rear steer compared to front steer", {"subCategory":"Rear Rear", "minDis":-100, "maxDis":100}]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":7.0},
        //steering rack ends
        {"group":["pickup_steeringrack_hydro_body_RR"]},
        ["rstg2r", -0.22, 2.72, 0.347, {"selfCollision":true}],
        ["rstg4r", -0.22, 2.72, 0.29, {"nodeWeight":0.5,"collision":false}],
        ["rstg2l",  0.22, 2.72, 0.347, {"selfCollision":true}],
        ["rstg4l",  0.22, 2.72, 0.29, {"nodeWeight":0.5,"collision":false}],
        //axle mounting points for steering rack
        {"nodeWeight":7.0},
        {"group":["pickup_steeringrack_hydro_RR","pickup_tierod_RRR"]},
        ["rstg1r", -0.41, 2.72, 0.347, {"selfCollision":true}],
        ["rstg3r", -0.41, 2.72, 0.29, {"nodeWeight":0.5,"collision":false}],
        {"group":["pickup_steeringrack_hydro_RR","pickup_tierod_RRL"]},
        ["rstg1l",  0.41, 2.72, 0.347, {"selfCollision":true}],
        ["rstg3l",  0.41, 2.72, 0.29, {"nodeWeight":0.5,"collision":false}],
         //tie rod
         {"nodeWeight":15.5},
         //["rh1r",-0.95, 1.64, 0.327, {"group":["pickup_hub_F","pickup_tierod_F"]}],
         //["rh1l", 0.95, 1.64, 0.327, {"group":["pickup_hub_F","pickup_tierod_F"]}],
        {"group":""},
    ],
    "beams": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":6001000,"beamDamp":100},
        {"beamDeform":1010000,"beamStrength":"FLT_MAX"},
        //steering rack mounting to axle
        {"deformLimitExpansion":1.2},
        ["rstg2r", "axg1"],
        ["rstg2l", "axg1"],
        ["rstg2r", "axg2"],
        ["rstg2l", "axg2"],
        ["rstg2r", "axg3"],
        ["rstg2l", "axg3"],

        {"beamSpring":10001000,"beamDamp":100},
        ["rstg2r", "axg1r"],
        ["rstg2r", "axg2r"],
        ["rstg2l", "axg1l"],
        ["rstg2l", "axg2l"],

        {"beamSpring":501000,"beamDamp":100},
        //rack extra flexbody helpers
        ["rstg4r", "axg1"],
        ["rstg4l", "axg1"],
        ["rstg4r", "axg2"],
        ["rstg4l", "axg2"],
        ["rstg4r", "axg3"],
        ["rstg4l", "axg3"],
        ["rstg4r", "axg1r"],
        ["rstg4r", "axg2r"],
        ["rstg4l", "axg1l"],
        ["rstg4l", "axg2l"],

        ["rstg1r", "rstg3r"],
        ["rstg1l", "rstg3l"],
        ["rstg1r", "rstg3l"],
        ["rstg1l", "rstg3r"],
        ["rstg1r", "rstg1l"],
        ["rstg3l", "rstg3r"],

        ["rstg2r", "rstg4r"],
        ["rstg2l", "rstg4l"],
        ["rstg2r", "rstg4l"],
        ["rstg2l", "rstg4r"],
        ["rstg4l", "rstg4r"],
        {"deformLimitExpansion":""},

        //center link
        {"beamDeform":2500000,"beamStrength":2450000},
        {"beamSpring":10001000,"beamDamp":150},
        ["rstg2r","rstg2l"],

        //tie rod ends
        {"beamSpring":20001000,"beamDamp":150},
        //["fh3r","rstg2r", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        //["fh3l","rstg2l", {"beamPrecompression":1,"highlight":{"radius":0.0075, "col":"#7FFFD4ff"}}],
        ["rhg1r","rstg1r", {"beamPrecompression":"$=$toe_RR+$steer_center_RR","beamPrecompressionTime":0.5}],
        ["rhg1l","rstg1l", {"beamPrecompression":"$=$toe_RR-$steer_center_RR","beamPrecompressionTime":0.5}],

        //steering damper
        {"beamSpring":0,"beamDeform":788000,"beamStrength":195000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamDamp":450},
        ["fx5r","fx3l", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx5l","fx3r", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx6r","fx3l", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        ["fx6l","fx3r", {"beamDampVelocitySplit":0.05,"beamDampFast":1500,"dampCutoffHz":750}],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"| BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":20001000,"beamDamp":250,"beamDeform":"FLT_MAX","beamStrength":276500},
        ["rstg2l","rstg1r", {"factor":"$=$steer_angle_RR", "steeringWheelLock":600, "inRate":1.0,"outRate":1.0}],
        ["rstg2r","rstg1l", {"factor":"$=-$steer_angle_RR","steeringWheelLock":600, "inRate":1.0,"outRate":1.0}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*4",
    },
},
}