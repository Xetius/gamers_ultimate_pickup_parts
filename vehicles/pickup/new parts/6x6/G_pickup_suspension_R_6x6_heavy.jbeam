         ["lf3r",-0.66, 1.49, 0.65],
         ["lf3l", 0.66, 1.49, 0.65],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":17800940,"beamDamp":141},
          {"beamDeform":87500,"beamStrength":262500},
          //leaf front
          ["axsr","le1r"],
          ["axsl","le1l"],
          //leaf rear
          ["lf1r","axsr"],
          ["lf1l","axsl"],

          //anti axle wrap node
          {"beamSpring":4700940,"beamDamp":141},
          ["lf3r","le1r"],
          ["lf3l","le1l"],
          ["lf3r","lf1r"],
          ["lf3l","lf1l"],

          //damp
          {"beamSpring":0,"beamDamp":141},
          ["lf3r","f18l"],
          ["lf3l","f18r"],

          //rail breaker
          ["lf3r","axsr", {"beamSpring":0,"beamDamp":0, "beamType":"|SUPPORT", "beamLongBound":3}],
          ["lf3l","axsl", {"beamSpring":0,"beamDamp":0, "beamType":"|SUPPORT", "beamLongBound":3}],

          //leaf spring
          {"beamType":"|LBEAM"},
          {"beamSpring":752940,"beamDamp":2820},
          {"beamPrecompression":0.95},
          ["ax2r","le1r", {"id3:":"axsr","beamPrecompressionTime":0.1}],
          ["ax2l","le1l", {"id3:":"axsl","beamPrecompressionTime":0.1}],
          ["ax2r","lf1r", {"id3:":"axsr","beamPrecompressionTime":0.1}],
          ["ax2l","lf1l", {"id3:":"axsl","beamPrecompressionTime":0.1}],
          {"beamPrecompression":1},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":52500,"beamStrength":126000},
          {"beamSpring":1128940,"beamDamp":1880},
          //lateral location
          ["axsr","le1l", {"dampCutoffHz":500}],
          ["axsl","le1r", {"dampCutoffHz":500}],
          ["axsr","lf1l", {"dampCutoffHz":500}],
          ["axsl","lf1r", {"dampCutoffHz":500}],

          //shackle
          {"beamPrecompression":1.0},
          {"beamSpring":7520940,"beamDamp":235},
          {"beamDeform":117500,"beamStrength":197500},
          ["lf1r","le2r", {"breakGroup":"shackle_RR"}],
          ["lf1l","le2l", {"breakGroup":"shackle_RL"}],
          ["lf1r","f9",   {"breakGroup":"shackle_RR"}],
          ["lf1l","f9",   {"breakGroup":"shackle_RL"}],

          //damping help
          {"beamDeform":10500,"beamStrength":31500},
          {"beamSpring":0,"beamDamp":4700},
          ["ax3l","f16l", {"dampCutoffHz":500}],
          ["ax3r","f16r", {"dampCutoffHz":500}],
          ["ax4l","f10l", {"dampCutoffHz":500}],
          ["ax4r","f10r", {"dampCutoffHz":500}],

          //shackle anti invert
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1},
          {"beamSpring":2350940,"beamDamp":470,"beamDeform":31500,"beamStrength":560000},
          {"beamPrecompression":0.9},
          ["lf1r","f19r", {"breakGroup":"shackle_RR"}],
          ["lf1l","f19l", {"breakGroup":"shackle_RL"}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
