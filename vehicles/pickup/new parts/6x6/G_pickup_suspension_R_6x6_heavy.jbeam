         {"selfCollision":false},
         ["lf1r",-0.64, 1.96, 0.44],
         ["lf1l", 0.64, 1.96, 0.44],
         {"group":"pickup_leaftop"},
         //leaf top flexbody nodes
         ["le1r", -0.64, 1.02, 0.36],
