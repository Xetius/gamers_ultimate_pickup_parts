{
"G_pickup_axle_R_6x6_heavy": {
    "information":{
        "authors":"Gamer!",
        "name":"Heavy Duty Live Axle Rear Suspension",
        "value":1500,
    },
    "slotType" : ["G_pickup_suspension_R_6x6","G_pickup_suspension_R_6x6_tiny"],
    "slots": [
        ["type", "default", "description"],
        ["pickup_hub_R","pickup_hub_R_8_heavy","Rear Wheel Hubs"],
        ["G_pickup_spring_R_6x6","G_pickup_spring_R_6x6_heavy", "Rear Springs"],
        ["pickup_shock_R","pickup_shock_R_heavy", "Rear Shocks"],
        ["pickup_swaybar_R","","Rear Sway Bar"],
        ["G_pickup_differential_R_6x6","G_pickup_differential_R_6x6","Rear Differential"],
        ["G_pickup_differential_R_6x6_int","G_pickup_differential_R_6x6_int_lsd","Interaxle Differential"],
        ["G_pickup_transfer_case_6x6_interaxle","G_pickup_transfer_case_6x6_interaxle","Interaxle Transfercase"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.05, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear axle
         ["pickup_axle_R", ["pickup_axle_R"],[],{"pos":{"x":0.0, "y":0.0, "z":0.0}}],
         ["G_pickup_leafmounts_R_6x6", ["pickup_frame", "pickup_leaftop"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR LIVE AXLE SUSPENSION--
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":7.05},
         {"collision":true},
         {"group":"pickup_axle_R"},
         {"selfCollision":false},
         //can be overwritten by Off-Road leaf spring
         ["ax2r", -0.66, 1.49, 0.56, {"group":["pickup_axle_R","pickup_leafbottom"]}],
         ["ax2l", 0.66, 1.49, 0.56, {"group":["pickup_axle_R","pickup_leafbottom"]}],
         {"selfCollision":true},
         ["ax3r", -0.74, 1.30, 0.31],
         ["ax3l", 0.74, 1.30, 0.31],
         ["ax4r", -0.74, 1.66, 0.31],
         ["ax4l", 0.74, 1.66, 0.31],
         ["ax1", 0.0, 1.6, 0.30, {"nodeWeight":16.92}],
         ["ax3", 0.0, 1.13, 0.39, {"nodeWeight":16.92,"selfCollision":false}],
         ["ax3i", 0.0, 1.66, 0.39, {"nodeWeight":14.1,"selfCollision":false}],
         ["ax2", 0.0, 1.54, 0.55, {"nodeWeight":11.28,"selfCollision":false}],
         {"nodeWeight":7.05},
         //can be overwritten by Off-Road leaf spring
         ["axsr", -0.66, 1.49, 0.37, {"group":"pickup_leafbottom"}],
         ["axsl", 0.66, 1.49, 0.37, {"group":"pickup_leafbottom"}],
         {"group":"pickup_rearshockbottom"},
         {"nodeWeight":5.64},
         //shock mounting nodes
         ["axshr", -0.45, 1.56, 0.29],
         ["axshl", 0.45, 1.56, 0.29],

         //--REAR RUNNING GEAR

         //shock mount
         {"nodeWeight":7.52},
         {"group":"pickup_rearshocktop"}
         {"collision":false},
         {"selfCollision":false},
         ["rs1r", -0.43, 1.51, 0.63],
         ["rs1l", 0.43, 1.51, 0.63],

         //leaf mounts
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":4.7},
         {"group":"pickup_leaftop"},
         ["le1r", -0.64, 1.02, 0.41],
         ["le1l", 0.64, 1.02, 0.41],
         //shackle mounts
         ["le2r", -0.64, 1.94, 0.52],
         ["le2l", 0.64, 1.94, 0.52],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //live axle suspension
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":14100940,"beamDamp":235},
          {"beamDeform":98000,"beamStrength":2050000},
          {"deformLimitExpansion":1.2},
          ["ax1","ax2"],
          ["ax1","ax3"],
          ["ax2","ax3"],
          ["ax2","ax2r"],
          ["ax2","ax2l"],
          ["ax3","ax3r"],
          ["ax3","ax3l"],
          ["ax1","ax4r"],
          ["ax1","ax4l"],
          //
          ["ax2l","ax3l"],
          ["ax2r","ax3r"],
          ["ax4l","ax3l"],
          ["ax4r","ax3r"],
          ["ax4l","ax2l"],
          ["ax4r","ax2r"],

          //crossing
          {"deformLimitExpansion":""},
          ["ax2r","ax1"],
          ["ax2l","ax1"],
          ["ax3r","ax1"],
          ["ax3l","ax1"],
          ["ax3r","ax2"],
          ["ax3l","ax2"],
          ["ax4r","ax2"],
          ["ax4l","ax2"],
          ["ax2r","ax3"],
          ["ax2l","ax3"],
          ["ax4r","ax3"],
          ["ax4l","ax3"],

          ["ax2l","ax2r"],
          ["ax3l","ax3r"],
          ["ax4l","ax4r"],

          //interaxle
          {"beamSpring":1410094,"beamDamp":250},
          {"beamDeform":9800000,"beamStrength":20500000},
          ["ax3i","ax1"],
          ["ax3i","ax2"],
          ["ax3i","ax2r"],
          ["ax3i","ax2l"],
          ["ax3i","ax3"],
          ["ax3i","ax3r"],
          ["ax3i","ax3l"],
          ["ax3i","axshr"],
          ["ax3i","axshl"],

          //shock mounts
          {"beamSpring":5640940,"beamDamp":141},
          {"beamDeform":49000,"beamStrength":437500},
          ["axshr","ax2r"],
          ["axshr","ax3r"],
          ["axshr","ax4r"],
          ["axshr","ax1"],
          ["axshr","ax2"],
          ["axshr","ax3"],
          ["axshl","ax2l"],
          ["axshl","ax3l"],
          ["axshl","ax4l"],
          ["axshl","ax1"],
          ["axshl","ax2"],
          ["axshl","ax3"],
          //spring mounts
          {"beamSpring":11280940,"beamDamp":141},
          ["axsl","ax2l"],
          ["axsl","ax3l"],
          ["axsl","ax4l"],
          ["axsl","ax1"],
          ["axsl","ax2"],
          ["axsl","ax3"],

          ["axsr","ax2r"],
          ["axsr","ax3r"],
          ["axsr","ax4r"],
          ["axsr","ax1"],
          ["axsr","ax2"],
          ["axsr","ax3"],

          //rear limiters
          {"deformLimitExpansion":""},
          {"beamPrecompression":0.55, "beamType":"|SUPPORT", "beamLongBound":6},
          {"beamSpring":0,"beamDamp":0,"beamDeform":52500,"beamStrength":700000},
          {"beamLimitSpring":5001000,"beamLimitDamp":500},
          {"optional":true},
          ["rw1r", "f6r"],
          ["rw1r", "f16r"],
          ["rw1r", "f10r"],
          ["rw1r", "f20r"],
          ["rw1r", "f18r", {"beamPrecompression":0.2, "beamLongBound":12}],

          ["rw1l", "f6l"],
          ["rw1l", "f16l"],
          ["rw1l", "f10l"],
          ["rw1l", "f20l"],
          ["rw1l", "f18l", {"beamPrecompression":0.2, "beamLongBound":12}],
          {"optional":false},

          //pinion damper
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":0,"beamDamp":3290},
          {"beamDeform":21000,"beamStrength":35000},
          {"breakGroup":"driveshaft"},
          ["ax2","tra1", {"dampCutoffHz":500, "optional":true}],
          ["ax1","tra1", {"dampCutoffHz":500, "optional":true}],

          //hub dampers
          {"beamSpring":0,"beamDamp":1200},
          {"beamLimitSpring":0,"beamLimitDamp":1200},
          {"beamType":"|BOUNDED" "beamLongBound":2, "beamShortBound":1},
          {"optional":true},
          ["rw1ll","f6l",  {"breakGroupType":1, "breakGroup":"wheel_RL","beamDampVelocitySplit":0.05,"beamDampFast":2000,"beamDampReboundFast":2000,"beamDamp":100,"beamDampRebound":100, "dampCutoffHz":500}],
          ["rw1rr","f6r",  {"breakGroupType":1, "breakGroup":"wheel_RR","beamDampVelocitySplit":0.05,"beamDampFast":2000,"beamDampReboundFast":2000,"beamDamp":100,"beamDampRebound":100, "dampCutoffHz":500}],
          ["rw1ll","f10l", {"breakGroupType":1, "breakGroup":"wheel_RL","beamDampVelocitySplit":0.05,"beamDampFast":2000,"beamDampReboundFast":2000,"beamDamp":100,"beamDampRebound":100, "dampCutoffHz":500}],
          ["rw1rr","f10r", {"breakGroupType":1, "breakGroup":"wheel_RR","beamDampVelocitySplit":0.05,"beamDampFast":2000,"beamDampReboundFast":2000,"beamDamp":100,"beamDampRebound":100, "dampCutoffHz":500}],
          {"beamType":"|NORMAL" "beamLongBound":2, "beamShortBound":1},
          {"breakGroup":""},

          //extension/compression limit
          {"beamPrecompression":1, "beamType":"|BOUNDED","beamLongBound":1,"beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":24500,"beamStrength":245000},
          {"beamLimitSpring":2001000,"beamLimitDamp":1000},
          ["ax4r","f18r", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax4l","f18l", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax3r","f18r", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax3l","f18l", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},

          //shackle
          {"beamPrecompression":1.0},
          {"beamSpring":7520940,"beamDamp":235},
          {"beamDeform":117500,"beamStrength":197500},
          ["lf1r","f7",   {"breakGroup":"shackle_RR"}],
          ["lf1l","f7",   {"breakGroup":"shackle_RL"}],
    ],
    "triangles": [
