         {"nodeWeight":6.58},
         ["axgsr1", -0.23, 2.5, 0.56, {"group":["pickup_axle_RR","pickup_upperlink_RR"]}],

         //trackbar mount
         {"nodeWeight":4.7},
         ["axgsr2", -0.532, 2.495, 0.46, {"group":["pickup_axle_RR","pickup_trackbar_RR"]}],

         //shock/lower link mounting nodes
         {"nodeWeight":9.4},
         {"group":["pickup_axle_RR","pickup_rearrearshockbottom", "pickup_lowerlinks_RR"]}
         ["axgshr", -0.67, 2.33, 0.32],
         ["axgshl", 0.67, 2.33, 0.32],

         //--REAR RUNNING GEAR

