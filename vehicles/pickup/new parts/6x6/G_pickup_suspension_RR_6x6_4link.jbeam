{
"G_pickup_axle_RR_6x6_4link": {
    "information":{
        "authors":"Gamer!",
        "name":"3 Link Live Axle Rear Rear Suspension",
        "value":4200,
    },
    "slotType" : ["G_pickup_suspension_RR_6x6","G_pickup_suspension_RR_6x6_tiny"],
    "slots": [
        ["type", "default", "description"],
        ["G_pickup_hub_RR_6x6","G_pickup_hub_RR_6x6_6","Rear Rear Wheel Hubs"],
        ["G_pickup_coilover_RR_6x6","G_pickup_coilover_RR_6x6","Rear Rear Coilovers"],
        ["G_pickup_swaybar_RR_6x6","G_pickup_swaybar_RR_6x6","Rear Rear Sway Bar"],
        ["G_pickup_differential_RR_6x6","G_pickup_differential_RR_6x6","Rear Rear Differential"],
        ["G_pickup_links_RR_6x6_4link","G_pickup_links_RR_6x6_4link","Rear Rear Links", {"coreSlot":true}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$trackoffset_RR", "range", "+m", "Wheels", 0.0,-0.05, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear Rear"}],
        ["$trackbar_RR", "range", "m", "Wheel Alignment", 0.0, -0.01, 0.06, "Track Bar Adjust", "Adjust the axle lateral position", {"stepDis":0.001,"subCategory":"Rear Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear axle
         ["pickup_axle_R", ["pickup_axle_RR", "pickup_rearrearshockbottom"],[],{"pos":{"x":0, "y":0.9, "z":0}}],
         ["pickup_axlemounts_R_4link", ["pickup_axle_RR", "pickup_rearrearshockbottom"],[],{"pos":{"x":0, "y":0.9, "z":0}}],

         //["pickup_shocktop_R_4link", ["pickup_frame", "pickup_rearrearshocktop"],[],{"pos":{"x":0, "y":0.9, "z":0}}],
         ["pickup_trackbarmount_R_4link", ["pickup_frame"],[],{"pos":{"x":0, "y":0.9, "z":0}}],

         ["pickup_uppermounts_R_4link", ["pickup_frame"],[],{"pos":{"x":0, "y":0.9, "z":0}}],

         //["pickup_lowerlink_R_4link", ["pickup_lowerlinks_RR"],[],{"pos":{"x":0, "y":0.9, "z":0}}],
         ["pickup_upperlink_R_4link", ["pickup_trackbar_RR", "pickup_upperlink_RR"],[],{"pos":{"x":0, "y":0.9, "z":0}}],
         ["pickup_trackbar_R_4link", ["pickup_trackbar_RR"],[],{"pos":{"x":0, "y":0.9, "z":0}}],

         ["G_pickup_framebar_6x6", ["pickup_frame"],[],{"pos":{"x":0, "y":0, "z":0}}],
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":250000, "damp":0, "deform":2500000, "strength":10000000},
        //rigidify upper link
        ["axg3", "axg1", "axg4r", "axgsr1"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],

         //DrowsySam was here

         //--REAR LIVE AXLE SUSPENSION--
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":14.288},
         {"collision":true},
         {"group":"pickup_axle_RR"},
         {"selfCollision":false},
         //can be overwritten by Off-Road leaf spring
         ["axg2r", -0.66, 2.39, 0.65],
         ["axg2l", 0.66, 2.39, 0.65],
         {"selfCollision":true},
         ["axg3r", -0.74, 2.15, 0.33],
         ["axg3l", 0.74, 2.15, 0.33],
         ["axg4r", -0.74, 2.56, 0.33],
         ["axg4l", 0.74, 2.56, 0.33],
         ["axg1", 0.0, 2.5, 0.30, {"nodeWeight":14.1}],
