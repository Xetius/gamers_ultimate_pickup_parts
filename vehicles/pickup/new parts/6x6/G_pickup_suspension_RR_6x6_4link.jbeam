         {"collision":false},
         {"selfCollision":false},
         {"nodeWeight":7.52},
         {"group":"pickup_rearrearshocktop"}
         ["rsg2r", -0.63, 2.24, 0.62],
         ["rsg2l", 0.63, 2.24, 0.62],

         //upper link mount
         {"nodeWeight":6.58},
         ["rxg2r", -0.23, 2.03, 0.5, {"group":"pickup_upperlink_RR"}],

