          {"beamDeform":77000,"beamStrength":280000},
          {"beamSpring":"$spring_RR3","beamDamp":0},
          ["axgshr","rsg2r", {"precompressionRange":"$=$springheight_RR3 + 0.3","beamPrecompressionTime":0.1,
              "soundFile":"event:>Vehicle>Suspension>pickup_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":3.6,"decayFactor":11,"noiseFactor":0.01,"pitchFactor":0.4,"maxStress":15000}],
          ["axgshl","rsg2l", {"precompressionRange":"$=$springheight_RR3 + 0.3","beamPrecompressionTime":0.1,
              "soundFile":"event:>Vehicle>Suspension>pickup_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":3.6,"decayFactor":11,"noiseFactor":0.01,"pitchFactor":0.4,"maxStress":15000}],

          //--REAR SHOCKS--
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamSpring":0,"beamDamp":"$damp_bump_RR3"},
          ["axgshr","rsg2r", {"beamDampRebound":"$damp_rebound_RR3","beamDampVelocitySplit":0.75,"beamDampFast":"$damp_bump_RR3_fast","beamDampReboundFast":"$damp_rebound_RR3","dampCutoffHz":500}],
          ["axgshl","rsg2l", {"beamDampRebound":"$damp_rebound_RR3","beamDampVelocitySplit":0.75,"beamDampFast":"$damp_bump_RR3_fast","beamDampReboundFast":"$damp_rebound_RR3","dampCutoffHz":500}],
          //bumpstops
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":251000,"beamLimitDamp":10000},
          ["axgshr","rsg2r", {"longBoundRange":0.35,"shortBoundRange":0.04,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["axgshl","rsg2l", {"longBoundRange":0.35,"shortBoundRange":0.04,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
