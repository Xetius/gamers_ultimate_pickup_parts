{
"G_pickup_brake_RR_6x6": {
    "information":{
        "authors":"Gamer!",
        "name":"Rear Rear Disc Brakes",
        "value":220,
    },
    "slotType" : "G_pickup_brake_RR_6x6",
    "slots": [
        ["type", "default", "description"],
        ["brakepad_RR","brakepad_RR_premium", "Rear Rear Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //brake discs
        ["brake_disc_solid", ["wheel_RRR","wheelhub_RRR"], [], {"pos":{"x":-0.78,"y":2.387, "z":0.4101}, "scale":{"x":1.3,"y":1.07,"z":1.07}, "rot":{"x":0,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_RRR"]]}],
        ["brake_disc_solid", ["wheel_RRL","wheelhub_RRL"], [], {"pos":{"x":0.78,"y":2.387, "z":0.4101}, "scale":{"x":1.3,"y":1.07,"z":1.07}, "rot":{"x":180,"y":0,"z":0}, "materialOverride":[["disc_brake", "disc_brake_RRL"]]}],
        ["brake_caliper_standard_plain", ["pickup_axle_RR","wheelhub_RRR"], [], {"pos":{"x":-0.78,"y":2.387, "z":0.4101}, "scale":{"x":1.3,"y":0.96,"z":0.96}, "rot":{"x":0,"y":0,"z":0}}],
        ["brake_caliper_standard_plain", ["pickup_axle_RR","wheelhub_RRL"], [], {"pos":{"x":0.78,"y":2.387, "z":0.4101}, "scale":{"x":1.3,"y":0.96,"z":0.96}, "rot":{"x":0,"y":180,"z":0}}],
        ["pickup_hub_R", ["wheelhub_RRR", "wheelhub_RRL", "pickup_axle_RR", "pickup_rearrearshockbottom"],[],{"pos":{"x":0.0, "y":0.9, "z":0.0}, "scale":{"x":0.98,"y":1.0,"z":1.0}}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*1600"},
        {"brakeInputSplit":0.6},
        {"brakeSplitCoef":0.1},
        {"parkingTorque":2000},
        {"brakeSpring":150},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.300},
        {"brakeMass":9},
        {"brakeType":"disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.8},

        //hub
        //general settings
        {"hubRadius":0.165},
        {"wheelOffset":0.0},
        {"hubWidth":0.05},
        {"numRays":5},

        //hub options
        {"hubTreadBeamSpring":1128940, "hubTreadBeamDamp":5.64},
        {"hubPeripheryBeamSpring":1128940, "hubPeripheryBeamDamp":5.64},
        {"hubSideBeamSpring":2256940, "hubSideBeamDamp":5.64},
        {"hubNodeWeight":0.7},
        {"hubNodeMaterial":"|NM_METAL"},
        {"hubFrictionCoef":0.2},
        {"hubBeamDeform":45500, "hubBeamStrength":87500},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},
