"G_pickup_spring_RR_6x6_offroad": {
    "information":{
        "authors":"Gamer!",
        "name":"Off-Road Rear Rear Leaf Springs",
        "value":600,
    },
    "slotType" : "G_pickup_spring_RR_6x6",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["pickup_axlebrace_R", ["pickup_axle_RR"], [],{"pos":{"x":0,"y":0.9,"z":0}}],
         ["pickup_leaf_R_offroad", ["pickup_leaftop_RR","pickup_leafbottom_RR"], [],{"pos":{"x":0,"y":0.9,"z":0}}],
         ["pickup_leafbracket_R_offroad", ["pickup_axle_RR", "pickup_rearshockbottom_RR"],[],{"pos":{"x":0.0, "y":0.9, "z":0.0}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_RR", "range", "+m", "Suspension", 0, -0.05, 0.05, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Rear Rear"}],
    ],
    "rails": {
        "legaf_RRL":{
            "links:":["axgsl","lfg3l"], "broken:":[], "looped":false, "capped":true,
        },
        "legaf_RRR":{
            "links:":["axgsr","lfg3r"], "broken:":[], "looped":false, "capped":true,
        },
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["axg2l", "legaf_RRL", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
        ["axg2r", "legaf_RRR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"selfCollision":true},
         {"collision":true},

         {"nodeWeight":4.512},
         {"group":"pickup_leafbottom_RR"},
         //shackle nodes
         {"selfCollision":false},
         ["lfg1r",-0.64, 3.00, 0.42],
         ["lfg1l", 0.64, 3.00, 0.42],
         {"group":"pickup_leaftop_RR"},
         //leaf top flexbody nodes
         ["leg1r", -0.64, 1.92, 0.41],
         ["leg1l", 0.64, 1.92, 0.41],
         ["leg2r", -0.64, 2.84, 0.52],
         ["leg2l", 0.64, 2.84, 0.52],
         {"nodeWeight":8.46},
         //over-axle spring conversion
         {"selfCollision":true},
         ["axgsr", -0.66, 2.39, 0.42, {"group":["pickup_axle_RR","pickup_leafbottom_RR"]}],
         ["axgsl", 0.66, 2.39, 0.42, {"group":["pickup_axle_RR","pickup_leafbottom_RR"]}],
         {"selfCollision":false},
         ["axg2r", -0.66, 2.39, 0.59, {"group":["pickup_axle_RR","pickup_leafbottom_RR"]}],
         ["axg2l", 0.66, 2.39, 0.59, {"group":["pickup_axle_RR","pickup_leafbottom_RR"]}],
         //anti wrap node
         {"nodeWeight":1.88},
         {"group":""},
         {"collision":false},
         ["lfg3r",-0.66, 2.39, 0.65],
         ["lfg3l", 0.66, 2.39, 0.65],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":14100940,"beamDamp":141},
          {"beamDeform":52500,"beamStrength":234500},
          //leaf front
          ["axgsr","leg1r"],
          ["axgsl","leg1l"],
          //leaf rear
          ["lfg1r","axgsr"],
          ["lfg1l","axgsl"],

          //anti axle wrap node
          {"beamSpring":4700940,"beamDamp":141},
          ["lfg3r","leg1r"],
          ["lfg3l","leg1l"],
          ["lfg3r","lfg1r"],
          ["lfg3l","lfg1l"],

          //damp
          {"beamSpring":0,"beamDamp":141},
          ["lfg3r","f18l"],
          ["lfg3l","f18r"],

          //rail breaker
          ["lfg3r","axgsr", {"beamSpring":0,"beamDamp":0, "beamType":"|SUPPORT", "beamLongBound":5}],
          ["lfg3l","axgsl", {"beamSpring":0,"beamDamp":0, "beamType":"|SUPPORT", "beamLongBound":5}],

          //leaf spring
          {"beamType":"|LBEAM"},
          {"beamSpring":170140,"beamDamp":1880},
          //IMPORTANT: if precompressionRange is ~= nil then it supersedes beamPrecompression.
          //The case() is for backwards compatibility for old configs containing the "rideheight_R" variable.
          //To change the base ride height, edit the springheight_R offset in the expression.
          ["axg2r","leg1r", {"id3:":"axgsr","beamPrecompression":"$=$rideheight_RR","precompressionRange":"$=case($rideheight_RR == nil, -$springheight_RR*0.4-0.090, '')","beamPrecompressionTime":0.1}],
          ["axg2l","leg1l", {"id3:":"axgsl","beamPrecompression":"$=$rideheight_RR","precompressionRange":"$=case($rideheight_RR == nil, -$springheight_RR*0.4-0.090, '')","beamPrecompressionTime":0.1}],
          ["axg2r","lfg1r", {"id3:":"axgsr","beamPrecompression":"$=$rideheight_RR","precompressionRange":"$=case($rideheight_RR == nil, -$springheight_RR*0.4-0.090, '')","beamPrecompressionTime":0.1}],
          ["axg2l","lfg1l", {"id3:":"axgsl","beamPrecompression":"$=$rideheight_RR","precompressionRange":"$=case($rideheight_RR == nil, -$springheight_RR*0.4-0.090, '')","beamPrecompressionTime":0.1}],
          {"beamPrecompression":1},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":45500,"beamStrength":112000},
          {"beamSpring":564940,"beamDamp":940},
          //lateral location
          ["axgsr","leg1l"],
          ["axgsl","leg1r"],
          ["axgsr","lfg1l"],
          ["axgsl","lfg1r"],

          //shackle
          {"beamPrecompression":1.0},
          {"beamSpring":7520940,"beamDamp":235},
          {"beamDeform":117500,"beamStrength":197500},
          ["lfg1r","leg2r", {"breakGroup":"shackle_RRR"}],
          ["lfg1l","leg2l", {"breakGroup":"shackle_RRL"}],
          ["lfg1r","f9",   {"breakGroup":"shackle_RRR"}],
          ["lfg1l","f9",   {"breakGroup":"shackle_RRL"}],

          //shackle anti invert
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1},
          {"beamSpring":2350940,"beamDamp":470,"beamDeform":31500,"beamStrength":560000},
          {"beamPrecompression":0.9},
          ["lfg1r","f19r", {"breakGroup":"shackle_RRR"}],
          ["lfg1l","f19l", {"breakGroup":"shackle_RRL"}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"group":"pickup_rearaxle_RR"},
            {"triangleType":"NONCOLLIDABLE"},
            {"dragCoef":0},
            //leaf spring
            ["axg4r","axg2r","lfg1r"],
            ["axg2r","axg3r","leg1r"],
            ["axg2l","axg4l","lfg1l"],
            ["axg3l","axg2l","leg1l"],
            {"triangleType":"NORMALTYPE"},
    ],
},
