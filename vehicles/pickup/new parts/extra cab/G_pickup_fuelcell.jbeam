        "authors":"Gamer!",
        "name":"Diesel Interior Fuel Cell",
        "value":450,
    },
    "slotType" : "G_pickup_seat_R_extra",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_fuelcell_1", ["pickup_fuelcell", "body"]],
         ["G_pickup_fuelcell_2", ["pickup_fuelcell", "body"]],
         ["G_pickup_fuelcell_3", ["pickup_fuelcell", "body"]],
         ["G_pickup_fuelcell_4", ["pickup_fuelcell", "body"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuelcell", "range", "L", "Chassis", 100, 0, 100, "Fuel Cell Volume", "Initial fuel volume", {"stepDis":0.5}],
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "auxTank"],
    ],
    "auxTank": {
        "energyType":"diesel",
        "fuelCapacity": 100,
        "startingFuelCapacity": "$fuelcell",
        "fuel": {"[engineGroup]:":["fuel"]},
        "breakTriggerBeam": "fuelTank",
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":1},
         {"collision":true},
         {"selfCollision":true},
         //fuel tank container
         {"group":"pickup_fuelcell"},
         {"nodeWeight":1},
         ["fcg1", 0.0, 0.65722, 0.81490],
         ["fcg1r", -0.42122, 0.65722, 0.81490],
         ["fcg1l", 0.42122, 0.65722, 0.81490],
         ["fcg2", 0.0, 0.21126, 0.81490],
         ["fcg2r", -0.42122, 0.21126, 0.81490],
         ["fcg2l", 0.42122, 0.21126, 0.81490],
         {"group":""},

         //fuel tank particles
         {"nodeWeight":0.5},
         {"engineGroup":["fuel"]},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"chemEnergy":50,"burnRate":1.2,"flashPoint":220,"vaporPoint":92,"specHeat":0.03,"selfIgnitionCoef":0.1,"smokePoint":220,"containerBeam":"fuelTank"},
         ["ftg1", 0.0, 0.45254, 0.62990],
         ["ftg1l", 0.25094, 0.35254, 0.62990],
         ["ftg1r", -0.25094, 0.35254, 0.62990],

         ["ftg2", 0.0, 0.69594, 0.62990],
         ["ftg2l", 0.25094, 0.59594, 0.62990],
         ["ftg2r", -0.25094, 0.59594, 0.62990],

         {"selfIgnitionCoef":false},
         ["ftg3", 0.0, 0.47424, 0.74990],
         ["ftg3l", 0.28679, 0.47424, 0.74990],
         ["ftg3r", -0.28679, 0.47424, 0.74990],
         {"engineGroup":""},
         {"chemEnergy":false,"burnRate":false,"flashPoint":false,"vaporPoint":false,"specHeat":false,"selfIgnitionCoef":false,"smokePoint":false,"containerBeam":false},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":501000,"beamDamp":50},
          {"beamDeform":35000,"beamStrength":"FLT_MAX"},
