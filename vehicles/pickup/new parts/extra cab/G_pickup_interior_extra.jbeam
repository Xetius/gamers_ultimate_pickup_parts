"G_pickup_extra_shelf_S":{
    "information":{
        "authors":"Gamer!",
        "name":"Unfolding Shelf",
        "value":210,
    },
    "slotType" : "G_pickup_extra_shelf_S",
    "flexbodies":[
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["G_pickup_extra_shelf_alt", ["pickup_jumpseat_shelf"],[], {"pos":{"x":0.0, "y":0.0, "z":0.0}, "scale":{"x":1, "y":1, "z":1}}],
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"shelfCoupler"}],
    ]
    "shelfCoupler":{
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["shel2l",    "shel3l",    20000,                     0.015,                  0.005,                      0.2,                 0.1,                   "shelflatch_L", {"forceCid1":"shel3l", "forceCid2":"shel2l"}]
            ["shel2r",    "shel3r",    20000,                     0.015,                  0.005,                      0.2,                 0.1,                   "shelflatch_R", {"forceCid1":"shel3r", "forceCid2":"shel2r"}]
        ]
        "groupType": "autoCoupling",
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["shel1r"]
        "attachSoundEvent": "event:>Vehicle>Latches>Door>vintage_08_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Door>vintage_08_open",
        "breakSoundEvent":""
        "openForceMagnitude": 10,
        "openForceDuration": 0.2,
        "closeForceMagnitude": 65,
        "closeForceDuration": 2
    }
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["shelf", "", "shel2l","shel2r","shel1l", "box", {"x":0.18, "y":0.05, "z":0.05}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.52, "y":-0.005, "z":-0.0225}, {"deformGroup":"pickup_jumpseat_shelf"}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["shelf", "action0", "shelfLatch"]
    ],
    "events":[
        ["id", "title", "desc"],
        ["shelfLatch", "Toggle Rear Shelf", "ui.inputActions.pickup.tailgateLatch.description", {"onUp":"controller.getControllerSafe('shelfCoupler').toggleGroup()"}],
    ],
    "nodes":[
          ["id", "posX", "posY", "posZ"],
          {"group":"pickup_jumpseat_shelf"},
