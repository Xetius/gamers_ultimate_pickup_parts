{
"G_pickup_grp_interior": {
    "information":{
        "authors":"Gamer!",
        "name":"Race Dashboard",
        "value":1000,
    },
    "slotType" : "pickup_interior",
    "slots2": [
        ["name",                           "allowTypes",                       "denyTypes", "default",                       "description"],
        ["pickup_sunvisors",               ["pickup_sunvisors"],               [],          "pickup_sunvisors",              "Sunvisors"],
        ["G_pickup_grp_shifter",           ["G_pickup_grp_shifter"],           [],          "G_pickup_grp_shifter_M_5",      "Shifter"],
        ["G_pickup_grp_shifter_T",         ["G_pickup_grp_shifter_T"],         [],          "",                              "Range Selector"],
        ["pickup_steer",                   ["pickup_steer"],                   [],          "pickup_steer_01a",              "Steering Wheel"],
        ["G_pickup_grp_switchcovers",      ["G_pickup_grp_switchcovers"],      [],          "",                              "Switch Covers"],
        ["G_pickup_grp_controls",          ["G_pickup_grp_controls"],          [],          "G_pickup_grp_buttons_race",     "Lower Controls"],
        ["skin_grp",                       ["skin_grp"],                       [],          "skin_grp_carbon",               "Dashboard Material", {"coreSlot":true}],
        ["G_pickup_grp_gauges",            ["G_pickup_grp_gauges"],            [],          "G_pickup_grp_gauges",           "Gauges", {"coreSlot":true}],
        ["pickup_interior_accessory",      ["pickup_interior_accessory"],      [],          "",                              "Interior Accessories"],
        ["G_pickup_grp_lettering",         ["G_pickup_grp_lettering"],         [],          "",                              "Lettering"],
        ["G_pickup_grp_thissideup",        ["G_pickup_grp_thissideup"],        [],          "",                              "Dashboard Accessory"],
        ["pickup_seat_F",                  ["pickup_seat_F"],                  [],          "G_pickup_seat_F_bucket",          "Front Seats"],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator7
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>POL_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>POL_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>FIPA_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>FIPA_Clack"],
        //lights3
        ["LightOn", "event:>Vehicle>Interior>Light>AU5_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>AU5_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Lock"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"b6l"},
    ],
    "props": [
        ["func",         "mesh",                      "idRef:","idX:","idY:",        "baseRotation",              "rotation",                  "translation",           "min", "max", "offset", "multiplier"],
        //pedals
        ["brake",        "pickup_pedal_brake",        "b1l","b1r","b5l",             {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1,        {"baseTranslationGlobal":{"x":0.457551, "y":-0.956836,"z":0.890531}}],
        ["throttle",     "pickup_pedal_gas",          "b1l","b1r","b5l",             {"x":154, "y":180, "z":0},   {"x":-23, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1,        {"baseTranslationGlobal":{"x":0.341552, "y":-0.956247,"z":0.890695}}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //interior
         ["G_pickup_grp_dash", ["pickup_dash"]],
         ["G_pickup_grp_column", ["pickup_dash"]],
         ["G_pickup_grp_column_support", ["pickup_dash"]],
         ["G_pickup_grp_dash_switchpanel", ["pickup_dash"]],
         ["G_pickup_grp_buttons_generic", ["pickup_dash"]],
         ["pickup_intmirror", ["pickup_windshield"]],
         ["G_pickup_intcarpet_D55", ["pickup_body"]],
         ["pickup_locker_button_front", ["pickup_dash"], [], {"disable":"$=$components.locker_F ~= true",  "rot":{"x":-10, "y":0, "z":0}, "pos":{"x":0.100, "y":-0.20, "z":-0.1}}],
         ["pickup_locker_button_rear",  ["pickup_dash"], [], {"disable":"$=$components.locker_R ~= true",  "rot":{"x":-10, "y":0, "z":0}, "pos":{"x":0.100, "y":-0.20, "z":-0.1}}],
         ["G_pickup_locker_button_int",  ["pickup_dash"], [], {"disable":"$=$components.locker_I ~= true", "rot":{"x":-10, "y":0, "z":0}, "pos":{"x":0.082, "y":-0.20, "z":-0.1}}],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["pickup_intmirror","rf1","rfc1r","rf2",{"refBaseTranslation":{"x":0.0,"y":-0.090,"z":-0.140},"baseRotationGlobal":{"x":0,"y":0,"z":19}, "optional":true}],
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int", "dshl","dsh","b1ll", "box", {"x":0.04, "y":0.04, "z":0.04}, {"x":25, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.23, "y":0.22, "z":-0.10}],
        ["front_lock",    "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":28, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.285, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_F ~= true"}],
        ["rear_lock",     "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":28, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.265, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_R ~= true"}],
        ["int_lock",      "dshl","dsh","int_strw","box", {"x":0.02, "y":0.04, "z":0.02}, {"x":28, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.245, "y":-0.050, "z": 0.010}, {"disable":"$=$components.locker_I ~= true"}],
        ["sw_ignition", "dsh", "dshl", "dsh2", "sphere", 0.015,  {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.226 "y":0.054, "z":0.035}, {"deformGroup":"", "color": [0, 0, 1, 0.4]}],
        ["sw_starter",  "dsh", "dshl", "dsh2", "sphere", 0.015,  {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.22 "y":-0.031, "z":0.03}, {"deformGroup":"", "color": [0, 0, 1, 0.4]}],
        ["headlights",  "dsh", "dshl", "dsh2", "sphere", 0.015,  {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.077 "y":0.008, "z":0.092}, {"deformGroup":"", "color": [0, 0, 1, 0.4]}],
    ],
    "actionsEnabled": [
        ["id"],
        ["hoodRelease"],
        ["toggleFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["lockFrontDiff",       {"disable":"$=$components.locker_F ~= true"}],
        ["unlockFrontDiff",     {"disable":"$=$components.locker_F ~= true"}],
        ["setFrontDiffModeAxis",{"disable":"$=$components.locker_F ~= true"}],
        ["toggleRearDiff",      {"disable":"$=$components.locker_R ~= true"}],
        ["lockRearDiff",        {"disable":"$=$components.locker_R ~= true"}],
        ["unlockRearDiff",      {"disable":"$=$components.locker_R ~= true"}],
        ["setRearDiffModeAxis", {"disable":"$=$components.locker_R ~= true"}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["hood_int", "action0", "hoodRelease"],
        ["sw_ignition", "action0", "common:activateStarterMotor"],
        ["sw_starter", "action0", "common:setIgnitionLevel3Momentary"],
        ["headlights", "action0", "common:toggle_headlights"],
        ["int_lock", "action0", "toggleInteraxleDiff", {"disable":"$=$components.locker_I ~= true"}],
        ["rear_lock", "action0", "toggleRearDiff", {"disable":"$=$components.locker_R ~= true"}],
        ["front_lock","action0", "toggleFrontDiff",{"disable":"$=$components.locker_F ~= true"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},

         //dash nodes
         {"group":["pickup_dash", "pickup_dash_pickup"]},
         {"nodeWeight":0.752},
         ["dshr",-0.455, -0.626, 1.090],
         ["dsh",  0.000, -0.626, 1.090],
         ["dshl", 0.455, -0.626, 1.090],
