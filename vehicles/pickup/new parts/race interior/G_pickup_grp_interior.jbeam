         ["dsh3", 0.455, -0.390, 1.010, {"group":""}],
         {"nodeWeight":0.2},
         //flexbody node
         ["dsh2",  0.000, -0.716, 1.290],
         {"group":""},
         ["int_pbrk", 0.66, -0.93, 0.86],
         {"group":""},
    ],
    "torsionbars":[
       ["id1:", "id2:", "id3:", "id4:"],
        //rigify the column
        {"spring":20000, "damp":1, "deform":18000, "strength":28000},
        ["int_strw", "dshl", "dsh", "b5l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //dash board
          {"beamSpring":869146.6,"beamDamp":142.73},
          {"beamDeform":12400,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["dshr","b5r"],
          ["dshl","b5l"],
          ["dshr","b6r"],
          ["dshl","b6l"],
          ["dshr","b1r"],
          ["dshl","b1l"],
          ["dshr","b5rr"],
          ["dshl","b5ll"],
          ["dshr","b6rr"],
          ["dshl","b6ll"],
          ["dshl","dshr"],
          ["dsh","b5r"],
          ["dsh","b5l"],
          ["dsh","b6r"],
          ["dsh","b6l"],
          ["dsh","b1r"],
          ["dsh","b1l"],
          ["dshl","dsh"],
          ["dshr","dsh"],
          ["dsh","int_strw"],
          ["dshl","int_strw"],
          //dsh3 connect
          ["dsh3","b5r"],
          ["dsh3","b5l"],
          ["dsh3","b5ll"],
          ["dsh3","b6r"],
          ["dsh3","b6l"],
          ["dsh3","b6ll"],
          //["dsh3","dsh"],
          //["dsh3","dsh2"],
          ["dsh3","dshl"],
          ["dsh3","int_strw"],
          {"beamSpring":169146.6,"beamDamp":42.73},
          ["dsh2","b5r"],
          ["dsh2","b5l"],
          ["dsh2","b6r"],
          ["dsh2","b6l"],
          ["dsh2","b1r"],
          ["dsh2","b1l"],
          ["dshl","dsh2"],
          ["dshr","dsh2"],
          {"beamSpring":160100,"beamDamp":142.73},
          {"beamDeform":70300,"beamStrength":"FLT_MAX"},
          ["int_pbrk","dshl"],
          ["int_pbrk","b5ll"],
          ["int_pbrk","b5l"],
          ["int_pbrk","b1lll"],
          //--BLEED DEFORM LIMIT TO OTHER PARTS--
          {"deformLimitExpansion":1.2},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //sides
            {"dragCoef":0},
            {"group":"pickup_dash"},
            ["dshl", "b6ll", "b5ll"],
            ["b6ll", "dshl", "b6l"],
            ["b6l", "dshl", "dsh"],
            ["dsh", "b6r", "b6l"],
            ["dsh", "dshr", "b6r"],
            ["b6r", "dshr", "b6rr"],
            ["dshr", "b5rr", "b6rr"],
            ["dshl", "b5ll", "b5l"],
            ["b5l", "dsh", "dshl"],
            ["b5l", "b5r", "dsh"],
            ["dsh", "b5r", "dshr"],
            ["dshr", "b5r", "b5rr"],
