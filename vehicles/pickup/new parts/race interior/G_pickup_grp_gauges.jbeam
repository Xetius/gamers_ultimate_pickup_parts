{
"G_pickup_grp_gauges": {
    "information":{
        "authors":"Gamer!",
        "name":"Analog Metric Gauges",
        "value":350,
    },
    "slotType" : "G_pickup_grp_gauges",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_grp_gauges_lhd", ["pickup_dash"]],
    ],
    "glowMap":{
        //gauges
        "grp_gauges":       {"simpleFunction":{"lowhighbeam":0.6},                                 "off":"grp_gauges", "on":"grp_gauges_on"                                                },
    }
    "props": [
       ["func",       "mesh",                "idRef:", "idX:", "idY:", "baseRotation",              "rotation",                 "translation",         "min", "max", "offset", "multiplier"],
       //needles
       ["wheelspeed", "G_pickup_grp_gauges_lhd_needle_tacho",   "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":22},  {"x":0, "y":0, "z":-3.5},   {"x":0, "y":0, "z":0}, 8.6, 83.3, -26.4, 1,   {"baseTranslationGlobal":{"x":0.353075, "y":-0.652252,"z":1.17727}}],
       ["rpm",        "G_pickup_grp_gauges_lhd_needle_speedo",  "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":90},  {"x":0, "y":0, "z":-0.032}, {"x":0, "y":0, "z":0}, 0, 9000, -4000, 1,     {"baseTranslationGlobal":{"x":0.456, "y":-0.658878,"z":1.20026}}],
       ["fuel",       "G_pickup_grp_gauges_lhd_needle_fuel",    "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":100}, {"x":0, "y":0, "z":-110},   {"x":0, "y":0, "z":0}, 0, 1, -0.6, 1,         {"baseTranslationGlobal":{"x":0.54412, "y":-0.658191,"z":1.19788}}],
       ["watertemp",  "G_pickup_grp_gauges_lhd_needle_temp",    "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":-70}, {"x":0, "y":0, "z":-1.80},  {"x":0, "y":0, "z":0}, 60, 130, -0.6, 1,      {"baseTranslationGlobal":{"x":0.527983, "y":-0.642965,"z":1.14504}}],
       ["oiltemp",    "G_pickup_grp_gauges_lhd_needle_oil",     "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":-45}, {"x":0, "y":0, "z":-1.3},   {"x":0, "y":0, "z":0}, 60, 150, -0.6, 1,      {"baseTranslationGlobal":{"x":0.599287, "y":-0.652256,"z":1.17728}}],
       ["volt",       "G_pickup_grp_gauges_lhd_needle_volt",    "int_strw","dsh3","dshl",       {"x":180, "y":7, "z":95},  {"x":0, "y":0, "z":1.8},    {"x":0, "y":0, "z":0}, 8, 16, 0, 1,           {"baseTranslationGlobal":{"x":0.583151, "y":-0.63703,"z":1.12444}}],
    ],
    "controller": [
        ["fileName"],
        ["gauges/analogOdometer", {"name":"analogOdometer" }],
    ],
    "analogOdometer": {
        "configuration": {
            "materialName": "@generic_gauges_odo",
            "htmlPath": "local://local/vehicles/common/analogOdo.html",
            "displayWidth":512,
            "displayHeight":32,
            "odometerDigits":7,
            "odometerHasDecimalSeparator":true,
            "tripHasDecimalSeparator":true,
            "unit":"metric",
            "floatStyle":{"color":"black"},
            "bodyStyle":{
                "background": "url('/vehicles/common/odometer_analog_b.cef_color.png')",
                "font-family": "OpenSans",
                "font-size": "28px",
                "color": "white",
                "letter-spacing": "15.5px",
                "margin": "-4.5px 10.5px",
                "transform": "scaleX(1.26)",
                "transform-origin": "left",
            },
            "tripDivStyle":{
                "margin-left": "-3px",
                "position": "fixed",
                "letter-spacing": "32px"
            }
        },
    },
},
