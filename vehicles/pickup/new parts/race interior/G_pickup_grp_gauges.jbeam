"G_pickup_grp_gauges_digital": {
    "information":{
        "authors":"Gamer!",
        "name":"Digital Single Screen",
        "value":1150,
    },
    "slotType" : "G_pickup_grp_gauges",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_grp_dash_instrumentpanel", ["pickup_dash"]],
         {"deformGroup":"display_break", "deformMaterialBase":"vivace_gauges_screen", "deformMaterialDamaged":"vivace_gauges_break"},
         ["digidash", ["pickup_dash"], [], {"pos":{"x": 0.456, "y":-0.66, "z":1.19}, "rot":{"x":16, "y":0, "z":0}, "scale":{"x":1.25, "y":1.25, "z":1.25}}],
         ["digidash_screen", ["pickup_dash"], [], {"pos":{"x": 0.456, "y":-0.66, "z":1.19}, "rot":{"x":16, "y":0, "z":0}, "scale":{"x":1.25, "y":1.25, "z":1.25}}],
         {"deformGroup":""},
    ],
    "controller": [
        ["fileName"],
        ["shiftLights"{"name": "shiftLights_digidash"}],
    ],
    "shiftLights_digidash": {
        "engineName":"mainEngine",
        "maxEngineRPMOffset": 500,
        "rpmRange": 3000,
        "keepLEDsActive": true,
        "hasStallWarning": true,
        "outputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5"],
        "flashingOutputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5"],
        "flashingAlternateOutputElectrics": [],
    },
    "glowMap":{
        "vivace_gauges_screen":     {"simpleFunction":"nop", "off":"vivace_gauges_break", "on":"vivace_gauges_break"},
        "shiftlight_multi_l0":     {"simpleFunction":{"led0":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l1":     {"simpleFunction":{"led1":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l2":     {"simpleFunction":{"led2":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l3":     {"simpleFunction":{"led3":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l4":     {"simpleFunction":{"led4":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l5":     {"simpleFunction":{"led5":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
    },
    "slots2": [
        ["name",                           "allowTypes",                       "denyTypes", "default",                       "description"],
        ["digidash_screen_logic",            ["digidash_screen_logic"],          [],          "digidash_screen_logic_bng",     "Screen", {"coreSlot":true}],
    ],
},
"G_pickup_grp_gauges_digital_dual": {
    "information":{
        "authors":"Gamer!",
        "name":"Digital Dual Screen",
        "value":1450,
    },
    "slotType" : "G_pickup_grp_gauges",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_grp_dash_instrumentpanel", ["pickup_dash"]],
         {"deformGroup":"display_break", "deformMaterialBase":"vivace_gauges_screen", "deformMaterialDamaged":"vivace_gauges_break"},
         ["digidash", ["pickup_dash"], [], {"pos":{"x": 0.521, "y":-0.65, "z":1.18}, "rot":{"x":16, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":1.0}}],
         ["digidash_screen", ["pickup_dash"], [], {"pos":{"x": 0.521, "y":-0.65, "z":1.18}, "rot":{"x":16, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":1.0}}],
         {"deformGroup":""},
         ["G_pickup_grp_gps", ["pickup_dash"]],
         ["G_pickup_grp_gps_screen", ["pickup_dash"]],
    ],
    "controller": [
        ["fileName"],
        ["shiftLights"{"name": "shiftLights_digidash"}],
        ["beamNavigator"],
    ],
    "shiftLights_digidash": {
        "engineName":"mainEngine",
        "maxEngineRPMOffset": 500,
        "rpmRange": 3000,
        "keepLEDsActive": true,
        "hasStallWarning": true,
        "outputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5"],
        "flashingOutputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5"],
        "flashingAlternateOutputElectrics": [],
    },
    "glowMap":{
        "vivace_gauges_screen":     {"simpleFunction":"nop", "off":"vivace_gauges_break", "on":"vivace_gauges_break"},
        "shiftlight_multi_l0":     {"simpleFunction":{"led0":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l1":     {"simpleFunction":{"led1":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l2":     {"simpleFunction":{"led2":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l3":     {"simpleFunction":{"led3":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l4":     {"simpleFunction":{"led4":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "shiftlight_multi_l5":     {"simpleFunction":{"led5":1}, "off":"shiftlight_off", "on":"shiftlight_on"},
        "screen_gps":{"simpleFunction":{"ignitionLevel":0.5}, "off":"screen_off","on":"beamnav_naviscreen_accessory", "on_intense":"screen_gps"},
    },
    "slots2": [
        ["name",                           "allowTypes",                       "denyTypes", "default",                       "description"],
        ["digidash_screen_logic",            ["digidash_screen_logic"],          [],          "digidash_screen_logic_bng",     "Screen", {"coreSlot":true}],
    ],
},
