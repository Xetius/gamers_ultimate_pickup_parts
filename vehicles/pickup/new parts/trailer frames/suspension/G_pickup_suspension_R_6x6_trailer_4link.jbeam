{
"G_pickup_axle_R_6x6_trailer_4link": {
    "information":{
        "authors":"Gamer!",
        "name":"Trailer 3 Link Live Axle Rear Suspension",
        "value":3800,
    },
    "slotType" : ["G_pickup_suspension_R_6x6","G_pickup_suspension_R_6x6_tiny"],
    "slots": [
        ["type", "default", "description"],
        ["pickup_hub_R","pickup_hub_R_6","Rear Wheel Hubs"],
        ["G_pickup_coilover_R_6x6","G_pickup_coilover_R_6x6","Rear Coilovers"],
        ["pickup_swaybar_R","pickup_swaybar_R","Rear Sway Bar"],
        ["pickup_links_R_4link","pickup_links_R_4link","Rear Links", {"coreSlot":true}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.05, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
        ["$trackbar_R", "range", "m", "Wheel Alignment", 0.0, -0.01, 0.06, "Track Bar Adjust", "Adjust the axle lateral position", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear axle
         ["G_pickup_axle_R_trailer", ["pickup_axle_R", "pickup_rearshockbottom"]],
         ["pickup_axlemounts_R_4link", ["pickup_axle_R", "pickup_rearshockbottom"]],

         //["pickup_shocktop_R_4link", ["pickup_frame", "pickup_rearshocktop"]],
         ["pickup_trackbarmount_R_4link", ["pickup_frame"]],

         //["pickup_lowermounts_R_4link_short", ["pickup_frame_short"]],
         ["pickup_uppermounts_R_4link_short", ["pickup_frame_short"]],

         //["pickup_lowermounts_R_4link", ["pickup_frame_standard", "pickup_frame_ext", "pickup_frame_crew"]],
         ["pickup_uppermounts_R_4link", ["pickup_frame_standard", "pickup_frame_ext", "pickup_frame_crew"]],

         //["pickup_lowermounts_R_4link_longbed", ["pickup_frame_longbed", "pickup_frame_extlongbed", "pickup_frame_crewlongbed"]],
         ["pickup_uppermounts_R_4link_longbed", ["pickup_frame_longbed", "pickup_frame_extlongbed", "pickup_frame_crewlongbed"]],

         ["pickup_uppermounts_R_4link", ["pickup_frame_upfit"]],
         //["pickup_lowermounts_R_4link_upfit", ["pickup_frame_upfit"]],

         //["pickup_lowerlink_R_4link", ["pickup_lowerlinks_R"]],
         ["pickup_upperlink_R_4link", ["pickup_trackbar_R", "pickup_upperlink_R"]],
         ["pickup_trackbar_R_4link", ["pickup_trackbar_R"]],
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":250000, "damp":0, "deform":2500000, "strength":10000000},
        //rigidify upper link
        ["ax3", "ax1", "ax4r", "axsr1"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],

         //DrowsySam was here

         //--REAR LIVE AXLE SUSPENSION--
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":14.288},
         {"collision":true},
         {"group":"pickup_axle_R"},
         {"selfCollision":false},
         //can be overwritten by Off-Road leaf spring
         ["ax2r", -0.66, 1.49, 0.65],
         ["ax2l", 0.66, 1.49, 0.65],
         {"selfCollision":true},
         ["ax3r", -0.74, 1.25, 0.33],
         ["ax3l", 0.74, 1.25, 0.33],
         ["ax4r", -0.74, 1.66, 0.33],
         ["ax4l", 0.74, 1.66, 0.33],
         ["ax1", 0.0, 1.6, 0.35, {"nodeWeight":14.1}],
         ["ax3", 0.0, 1.13, 0.39, {"nodeWeight":14.1,"selfCollision":false}],
         ["ax3i", 0.0, 1.68, 0.35, {"nodeWeight":14.1,"selfCollision":false}],
         ["ax2", 0.0, 1.54, 0.6, {"nodeWeight":9.4,"selfCollision":false}],

         //upper link mount
         {"selfCollision":false},
         {"nodeWeight":6.58},
         ["axsr1", -0.23, 1.6, 0.56, {"group":["pickup_axle_R","pickup_upperlink_R"]}],

         //trackbar mount
         {"nodeWeight":4.7},
         ["axsr2", -0.532, 1.595, 0.46, {"group":["pickup_axle_R","pickup_trackbar_R"]}],

         //shock/lower link mounting nodes
         {"nodeWeight":9.4},
         {"group":["pickup_axle_R","pickup_rearshockbottom", "pickup_lowerlinks_R"]}
         ["axshr", -0.67, 1.43, 0.32],
         ["axshl", 0.67, 1.43, 0.32],

         //--REAR RUNNING GEAR

         //shock mount
         {"collision":false},
         {"selfCollision":false},
         {"nodeWeight":7.52},
         {"group":"pickup_rearshocktop"}
         ["rs2r", -0.63, 1.34, 0.62],
         ["rs2l", 0.63, 1.34, 0.62],

         //upper link mount
         {"nodeWeight":6.58},
         ["rx2r", -0.23, 1.13, 0.5, {"group":"pickup_upperlink_R"}],

         //trackbar mount
         {"nodeWeight":4.7},
         ["rx2l", 0.506, 1.636, 0.4, {"group":"pickup_trackbar_R"}],

         //lower link mounts
         {"nodeWeight":9.4},
         {"group":["pickup_lowerlinks_R", "pickup_trackbar_R"]}
         ["rx1r", -0.51, 0.68, 0.33],
         ["rx1l", 0.51, 0.68, 0.33],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],

          //--REAR LIVE AXLE SUSPENSION--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":9400940,"beamDamp":141},
          {"beamDeform":112000,"beamStrength":2050000},
          {"deformLimitExpansion":1.2},
          ["ax1","ax2"],
          ["ax1","ax3"],
          ["ax2","ax3"],
          ["ax2","ax2r"],
          ["ax2","ax2l"],
          ["ax3","ax3r"],
          ["ax3","ax3l"],
          ["ax1","ax4r"],
          ["ax1","ax4l"],
          //
          ["ax2l","ax3l"],
          ["ax2r","ax3r"],
          ["ax4l","ax3l"],
          ["ax4r","ax3r"],
          ["ax4l","ax2l"],
          ["ax4r","ax2r"],

          //crossing
          {"deformLimitExpansion":""},
          ["ax2r","ax1"],
          ["ax2l","ax1"],
          ["ax3r","ax1"],
          ["ax3l","ax1"],
          ["ax3r","ax2"],
          ["ax3l","ax2"],
          ["ax4r","ax2"],
          ["ax4l","ax2"],
          ["ax2r","ax3"],
          ["ax2l","ax3"],
          ["ax4r","ax3"],
          ["ax4l","ax3"],

          ["ax2l","ax2r"],
          ["ax3l","ax3r"],
          ["ax4l","ax4r"],

          //interaxle
          ["ax3i","ax1"],
          ["ax3i","ax2"],
          ["ax3i","ax3"],
          ["ax3i","axshr"],
          ["ax3i","axshl"],

          //shock mounts
          {"beamSpring":9400940,"beamDamp":141},
          {"beamDeform":112000,"beamStrength":"FLT_MAX"},
          ["axshr","ax2r"],
          ["axshr","ax3r"],
          ["axshr","ax4r"],
          ["axshr","ax1"],
          ["axshr","ax2"],
          ["axshr","ax3"],
          ["axshl","ax2l"],
          ["axshl","ax3l"],
          ["axshl","ax4l"],
          ["axshl","ax1"],
          ["axshl","ax2"],
          ["axshl","ax3"],
          {"beamSpring":6580940,"beamDamp":141},
          //frame shock mount strength
          ["rs2r","f17l", {"beamDeform":75000}],
          ["rs2l","f17r", {"beamDeform":75000}],
          ["rs2r","f18l", {"beamDeform":75000}],
          ["rs2l","f18r", {"beamDeform":75000}],

          //trackbar mount
          {"beamSpring":3760940,"beamDamp":141},
          ["axsr2", "ax2"],
          ["axsr2", "ax3"],
          ["axsr2", "ax1"],
          ["axsr2", "ax4r"],
          ["axsr2", "ax3r"],
          ["axsr2", "ax2r"],

          //upper link mount
          {"beamSpring":5640940,"beamDamp":141},
          ["axsr1", "ax2"],
          ["axsr1", "ax3"],
          ["axsr1", "ax1"],
          ["axsr1", "ax4r"],
          ["axsr1", "ax3r"],
          ["axsr1", "ax2r"],

          {"beamSpring":2820940,"beamDamp":141},
          ["axshr", "axsr2"],
          ["axsr2", "axsr1"],
          ["axsr1", "axshr"],

          //lower links
          {"beamSpring":28200940,"beamDamp":940},
          {"beamDeform":129500,"beamStrength":"FLT_MAX"},
          //["axshr", "rx1r", {"dampCutoffHz":500}]
          //["axshl", "rx1l", {"dampCutoffHz":500}]

          //upper link
          {"beamSpring":18800940,"beamDamp":940},
          {"beamDeform":157500,"beamStrength":"FLT_MAX"},
          ["axsr1", "rx2r", {"dampCutoffHz":500}]

          //trackbar
          {"beamDeform":129500,"beamStrength":"FLT_MAX"},
          {"beamSpring":18800940,"beamDamp":940},
          ["rx2l", "axsr2", {"precompressionRange":"$trackbar_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],

          //rear limiters
          {"deformLimitExpansion":""},
          {"beamPrecompression":0.55, "beamType":"|SUPPORT", "beamLongBound":6},
          {"beamSpring":0,"beamDamp":0,"beamDeform":52500,"beamStrength":700000},
          {"beamLimitSpring":5001000,"beamLimitDamp":500},
          {"optional":true},
          ["rw1r", "f6r"],
          ["rw1r", "f16r"],
          ["rw1r", "f10r"],
          ["rw1r", "f20r"],
          ["rw1r", "f18r", {"beamPrecompression":0.2, "beamLongBound":12}],

          ["rw1l", "f6l"],
          ["rw1l", "f16l"],
          ["rw1l", "f10l"],
          ["rw1l", "f20l"],
          ["rw1l", "f18l", {"beamPrecompression":0.2, "beamLongBound":12}],
          {"optional":false},

          //pinion damper
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":0,"beamDamp":3290},
          {"beamDeform":21000,"beamStrength":35000},
          {"breakGroup":"driveshaft"},
          ["ax2","tra1", {"dampCutoffHz":500, "optional":true}],
          ["ax1","tra1", {"dampCutoffHz":500, "optional":true}],
          {"breakGroup":""},

          //extension/compression limit
          {"beamPrecompression":1, "beamType":"|BOUNDED","beamLongBound":1,"beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":24500,"beamStrength":245000},
          {"beamLimitSpring":2001000,"beamLimitDamp":1000},
          ["ax4r","f18r", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax4l","f18l", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax3r","f18r", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["ax3l","f18l", {"longBoundRange":0.35,"shortBoundRange":0.06,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],

          //dampers
          {"beamSpring":0,"beamDamp":1128},
          {"beamLimitSpring":0,"beamLimitDamp":1200},
          {"dampCutoffHz":500},
          {"beamType":"|BOUNDED" "beamLongBound":2, "beamShortBound":1},
          ["ax2r","f16r", {"breakGroup":"wheel_RR","beamDampVelocitySplit":0.05,"beamDampFast":500,"beamDampReboundFast":500,"beamDamp":47,"beamDampRebound":50}],
          ["ax4r","f6r", {"breakGroup":"wheel_RL","beamDampVelocitySplit":0.05,"beamDampFast":500,"beamDampReboundFast":500,"beamDamp":47,"beamDampRebound":50}],
          ["ax2l","f16l", {"breakGroup":"wheel_RR","beamDampVelocitySplit":0.05,"beamDampFast":500,"beamDampReboundFast":500,"beamDamp":47,"beamDampRebound":50}],
          ["ax4l","f6l", {"breakGroup":"wheel_RL","beamDampVelocitySplit":0.05,"beamDampFast":500,"beamDampReboundFast":500,"beamDamp":47,"beamDampRebound":50}],
          {"dampCutoffHz":""},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
