{
"G_pickup_mudflap_RR": {
    "information":{
        "authors":"Gamer!",
        "name":"Rear Right Mudflap",
        "value":50,
    },
    "slotType" : "pickup_bedtoolbox_R",
    "slots": [
        ["type", "default", "description"],
        ["G_pickup_mudflap_toolbox_R","", "Toolbox"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_mudflap_RR", ["pickup_mudflap_RR"], [],{"pos":{"x":0,"y":0,"z":0}}],
         ["G_pickup_mudflap_RR_bracket", ["pickup_bed"], [],{"pos":{"x":0,"y":0,"z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--FRONT BUMPER--
         {"selfCollision":false},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_RUBBER"},
         {"group":["pickup_bed","pickup_mudflap_RR"]},
         {"nodeWeight":1.5},
         ["mfr1r", -0.63, 1.93, 0.6],
         ["mfr1rr", -0.96, 1.93, 0.6],
         {"group":"pickup_mudflap_RR"},
         ["mfr2r", -0.63, 1.98, 0.42],
         ["mfr2rr", -0.96, 1.98, 0.42],
         ["mfr3r", -0.63, 1.995, 0.22],
         ["mfr3rr", -0.96, 1.995, 0.22],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT BUMPER--
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":100100,"beamDamp":100},
          {"beamDeform":115000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          ["mfr2r","mfr2rr"],
          ["mfr3r","mfr3rr"],
          ["mfr2r","mfr3r"],
          ["mfr2rr","mfr3rr"],
          ["mfr2r","mfr3rr"],
          ["mfr2rr","mfr3r"],

	  //attatch
          ["mfr2r","bd14rr"],
          ["mfr2r","bd4rr"],
          ["mfr2r","bd3rr"],
          ["mfr2r","bd9r"],
          ["mfr2rr","bd14rr"],
          ["mfr2rr","bd4rr"],
          ["mfr2rr","bd3rr"],
          ["mfr2rr","bd9r"],
          {"beamSpring":1856350,"beamDamp":100},
          ["mfr1r","bd14rr"],
          ["mfr1r","bd4rr"],
          ["mfr1r","bd3rr"],
          ["mfr1r","bd9r"],
          ["mfr1rr","bd14rr"],
          ["mfr1rr","bd4rr"],
          ["mfr1rr","bd3rr"],
          ["mfr1rr","bd9r"],

	  //spring
          {"beamSpring":500,"beamDamp":80},
          {"beamDeform":280,"beamStrength":8400},
          ["mfr3r","bd14rr"],
          ["mfr3rr","bd14rr"],
          ["mfr3rr","bd5rr"],
          {"breakGroupType":0},
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
