{
"G_pickup_mudflap_FR": {
    "information":{
        "authors":"Gamer!",
        "name":"Front Right Mudflap",
        "value":50,
    },
    "slotType" : "pickup_innerfender_R",
    "slots": [
        ["type", "default", "description"],
        ["G_pickup_mudflap_innerfender_R","G_pickup_mudflap_innerfender_R", "Inner Fender"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_mudflap_FR", ["pickup_mudflap_FR"], [],{"pos":{"x":0,"y":0,"z":0}}],
         ["G_pickup_mudflap_FR_bracket", ["pickup_fender_R"], [],{"pos":{"x":0,"y":0,"z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--FRONT BUMPER--
         {"selfCollision":false},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_RUBBER"},
         {"group":["pickup_fender_R","pickup_mudflap_FR"]},
         {"nodeWeight":1.5},
         ["mff1r", -0.63, -1.03, 0.6],
         ["mff1rr", -0.96, -1.03, 0.6],
         {"group":"pickup_mudflap_FR"},
         ["mff2r", -0.63, -0.98, 0.39],
         ["mff2rr", -0.96, -0.98, 0.39],
         ["mff3r", -0.63, -0.965, 0.22],
         ["mff3rr", -0.96, -0.965, 0.22],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT BUMPER--
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":100100,"beamDamp":100},
          {"beamDeform":115000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          ["mff2r","mff2rr"],
          ["mff3r","mff3rr"],
          ["mff2r","mff3r"],
          ["mff2rr","mff3rr"],
          ["mff2r","mff3rr"],
          ["mff2rr","mff3r"],

	  //attatch
          ["mff2r","fe1r"],
          ["mff2r","fe3r"],
          ["mff2r","fe4r"],
          ["mff2r","f4r"],
          ["mff2rr","fe1r"],
          ["mff2rr","fe3r"],
          ["mff2rr","fe4r"],
          ["mff2rr","f4r"],
          {"beamSpring":1856350,"beamDamp":100},
          ["mff1r","fe1r"],
          ["mff1r","fe3r"],
          ["mff1r","fe4r"],
          ["mff1r","f4r"],
          ["mff1rr","fe1r"],
          ["mff1rr","fe3r"],
          ["mff1rr","fe4r"],
          ["mff1rr","f4r"],

	  //spring
          {"beamSpring":500,"beamDamp":80},
          {"beamDeform":280,"beamStrength":8400},
          ["mff3r","fe1r"],
          ["mff3rr","fe1r"],
          ["mff3rr","fe3r"],
          {"breakGroupType":0},
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
