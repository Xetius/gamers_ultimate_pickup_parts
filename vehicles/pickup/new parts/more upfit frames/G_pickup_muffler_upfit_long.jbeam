{
"G_pickup_muffler_upfit_ext": {
    "information":{
        "authors":"Gamer!",
        "name":"Upfit Muffler",
        "value":300,
    },
    "slotType" : "G_pickup_muffler_upfit_ext",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["G_pickup_muffler_upfit_long", ["pickup_muffler"]],
    ],
    "mainEngine":{
        "torqueModExhaust":[
            ["rpm", "torque"],
            [0, 0],
            [1000, -5   ],
            [2000, -11  ],
            [3000, -17  ],
            [4000, -20.5],
            [5000, -23.6],
            [6000, -35.3],
            [7000, -46  ],
            [8000, -58  ],
        ],
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":1.645},
         {"group":"pickup_muffler"},
         {"selfCollision":false},
         {"collision":false},
         {"collision":true},
         {"selfCollision":true},
         ["ex6r",-0.28, 1.3, 0.33],
         ["ex8r",-0.43, 2.26, 0.4],
         ["ex9r",-0.81, 2.295, 0.3, {"afterFireAudioCoef":0.5, "afterFireVisualCoef":0.0, "afterFireVolumeCoef":0.5, "afterFireMufflingCoef":0.4, "exhaustAudioMufflingCoef":0.4, "exhaustAudioGainChange":-2}],
         //rigidifier
         {"selfCollision":false},
         {"collision":false},
         ["ex10r",-0.0, 1.2, 0.45],
         ["ex11r",-0.4, 1.30, 0.7],
         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          //--EXHAUST--
          {"deformLimitExpansion":""},
          {"beamSpring":1410940,"beamDamp":94},
          {"beamDeform":10500,"beamStrength":"FLT_MAX"},
          ["ex6r", "ex8r"{"isExhaust":"mainEngine", "deformLimitExpansion":1.1},],
          ["ex8r", "ex9r"{"isExhaust":"mainEngine", "deformLimitExpansion":1.1},],
          //rigids
          {"beamDeform":2450,"beamStrength":"FLT_MAX"},
          ["ex6r", "ex9r"{"beamDeform":1050}],

          //rigidifier
          ["ex10r", "ex6r"],
          ["ex10r", "ex8r"],
          ["ex10r", "ex9r"],
          ["ex10r", "ex11r"],
          ["ex11r", "ex6r"],
          ["ex11r", "ex8r"],
          ["ex11r", "ex9r"],


          {"beamSpring":1410940,"beamDamp":94},
          {"beamDeform":5500,"beamStrength":78500},
          //attach to front exhaust
          {"breakGroup":"exhaust_c_R"},
          ["ex6r", "ex3r"{"isExhaust":"mainEngine", "deformLimitExpansion":1.1},],
          ["ex6r", "ex4r"],
          ["ex6r", "ex5r"],
          ["ex10r", "ex3r"],
          ["ex11r", "ex3r"],
          ["ex10r", "ex4r"],
          ["ex11r", "ex5r"],
          ["ex6r", "ex2r"],
          {"optional":false},

          {"beamSpring":19740,"beamDamp":65.8},
          {"beamDeform":4100,"beamStrength":23500},
          {"breakGroup":"exhaust_d_R"},
          ["ex8r", "f16r"],
          ["ex8r", "f16"],
          ["ex8r", "f6r"],
          ["ex8r", "f6"],
          ["ex10r", "f17r"],
          {"beamSpring":1880,"beamDamp":47},
          ["ex9r", "f16r"],
          ["ex9r", "f17r"],
          {"breakGroup":""},

          //support beams
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":4, "beamShortBound":0},
          {"beamDeform":14000,"beamStrength":84000},
          {"beamSpring":940940,"beamDamp":61.1},
          {"beamPrecompression":0.95},
          ["ex6r", "f15"],
          ["ex6r", "f15r"],
          ["ex10r", "f16"],
          ["ex8r", "f18r"],
          ["ex11r", "f21l"],
          ["ex11r", "f22r"],
          {"beamPrecompression":1},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //exhaust shape
            {"triangleType":"NONCOLLIDABLE"},
            ["ex6r", "ex8r", "ex9r"],
            {"triangleType":"NORMALTYPE"},
    ],
